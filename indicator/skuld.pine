//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  SKULD 3.1 — VWAP MEAN REVERSION. ONE EDGE.
//  v3.1.0 (2026-08-12): SESSION PERSPECTIVE — RTH/ETH markers + a day-so-far
//     read, purely informational, zero effect on gates or the ticket.
//   · Thin dotted vertical line at every session open: NY (RTH) tagged with
//     a small "RTH" label + slightly brighter line; Asia/London (ETH) drawn
//     dimmer, unlabeled. Static once drawn — never repainted. Toggle
//     showSessLines (default on); off = zero chart marks.
//   · New HUD row (WAITING state only): "NY 47m · rng 63% ADR" — elapsed
//     time in the live session + today's range so far vs the prior day's
//     ATR(14) (the regime engine's own dATR — no new state). Turns amber
//     only past 100% (today already exceeds a normal day) — a heads-up,
//     not a gate.
//  v3.0.0 (2026-08-12)
//
//  DOCTRINE: price stretched from session VWAP (σ or range), landing ON a
//  scored SKULD level, RSI exhausted, rejection close confirmed, in a regime
//  where mean reversion is allowed → resting limit back to VWAP. That's it.
//
//  WHAT DIED IN 3.0 (one edge only):
//   · IB play · BRT play · APP play/advisory (IBH/IBL stay as LEVELS)
//   · imbalance zones engine + boxes + ◆ bonus
//   · day-type engine (D1-D5, gate matrix, tint) · APPR grades
//   · TOUCH REACT scoring + labels
//   · ledger feed events (only NOTRADE survives, opt-in)
//   · VP histogram "Bars" mode (developing POC lines survive)
//   · CLOCK prime/cold hours · lunch blackout
//   · legacy tick seeds (inTgtT/inStopT) · volume-multiple MR filter
//   · the 14-row debug HUD (4-row REGIME/ADX/STRETCH/GATES debug instead)
//
//  KEPT FROM 2.9.x (working machinery, verbatim):
//   · sessions NY/LDN/ASIA · trading day at Asia open · per-session VWAP ±σ
//     (±3σ optional now) · session TWAP
//   · regime engine: daily ATR(14) percentile + VIX bump → tier → cluster
//     width / display+trade floors / TP floor+cap / stop buffer
//   · level pool: prior day/week/session profile clusters + dynamic
//     singletons (VWAP 10 · sesH/L 8 · dPOC 8 · TWAP 6 · ±2σ 6 · ONH/L 6 ·
//     dVA 6 · sPOC 6 · sVA 4 · IBH/L 4 — levels only, no plays)
//   · EFFECTIVE SCORE: per-atom directional reaction memory (EWMA hold rate,
//     freshness decay, epoch scope resets) — untouched
//   · STRUCTURE mode ≥ 1H (map, no signals) · EXECUTION mode nearest-K render
//   · dynamic ticket construction (adapted: T1 = session VWAP, never through
//     a working level, 100-tick believability cap, room gate)
//   · fill-aware plan lifecycle (resting limit; RAN-unfilled clears)
//   · deck-spec HUD (WAITING/SIGNAL/STRUCTURE + FROM row) + GATES row
//   · alert() pipe format + 2 alertconditions (BUY MR / SELL MR)
//
//  THE EDGE (all confirmed-bar, no repaint):
//   1 REGIME   ADX(14): <25 FULL · 25-30 EXTREME-ONLY · ≥30 NO MR
//   2 STRETCH  |close−VWAP| ≥ 1.5σ (session σ) OR ≥ 0.35×ATR14
//   3 TRIGGER  RSI(7) ≤30 long / ≥70 short (25/75 strict), 2-bar window
//   4 LEVEL    the stretch lands ON a pool level, EffScore ≥ trade floor
//              (+2 in EXTREME-ONLY) — ±2σ bands are pool levels themselves
//   5 CONFIRM  rejection close (wick logic) + initiative & delta standdowns
//   6 TICKET   E = level edge into zone · S = beyond far edge + buffer AND
//              beyond the touch extreme · T1 = VWAP, standoff in front of
//              any working level in between (T2 = VWAP then) · room gate
//
//  Chart of record for signals: 15m. Candle-close confirmed only. No
//  lookahead. No repaint. One alert covers all: "Any alert() function call".
// ═══════════════════════════════════════════════════════════════════════════
indicator("SKULD 3.1 — VWAP Mean Reversion", "SKULD", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── ASSET AUTO-TUNE ────────────────────────────────────────────────────────
bool isES = syminfo.root == "ES" or syminfo.root == "MES"

// ── INPUTS ─────────────────────────────────────────────────────────────────
const string TZ = "America/New_York"
const string GM = "Mode"
const string GS = "Sessions (ET)"
const string GP = "Profile engine"
const string GK = "Level ranking & clusters"
const string GE = "Developing levels (live)"
const string GW = "VWAP & bands"
const string GLP = "Level pool"
const string GME = "3.0 · Mean Reversion Edge"
const string GT = "Discipline & trade plan"
const string GES = "Effective Score"
const string GRG = "Regime (ATR + VIX)"
const string GTC = "Trade Construction"
const string GSG = "Signal Gates"
const string GRK = "Risk (advisory)"
const string GLF = "Ledger Feed"
const string GD = "Dashboard"
const string GC = "Colors & lines"

string inModeTf = input.timeframe("60", "Structure mode at/above TF", group = GM, tooltip = "Chart TF >= this = STRUCTURE map (no signals). Below = EXECUTION mode. Chart of record for signals: 15m.")

string rthSess = input.session("0930-1600", "NY session (ET)", group = GS)
int    inIbMin = input.int(60, "Initial balance: minutes from EACH session open", minval = 15, maxval = 120, group = GS, tooltip = "IB is a LEVEL PAIR only since 3.0 (IBH/IBL rank 4 in the pool) — there is no IB play.")
string onSess  = input.session("1800-0930", "Overnight (ONH/ONL)", group = GS)
string sAsia   = input.session("1800-0300", "Asia session (ET)", group = GS)
string sLdn    = input.session("0300-0930", "London session (ET)", group = GS)
bool showSessLines = input.bool(true, "Session-open lines (RTH tick + ETH dividers)", group = GS, tooltip = "Thin dotted vertical line at each session open — NY (RTH) tagged with a small label, Asia/London (ETH) dimmer and unlabeled. Perspective only, no trade logic. Off = no chart marks; the HUD's session row keeps working either way.")

int    inRows  = input.int(24, "Extraction rows per profile", minval = 6, maxval = 60, group = GP)
float  inVA    = input.float(70, "Value area %", minval = 50, maxval = 95, group = GP)
float  inHvnK  = input.float(1.5, "HVN ≥ × avg row volume", step = 0.1, group = GP)
float  inLvnK  = input.float(0.5, "LVN ≤ × avg row volume", step = 0.1, group = GP)
int    inMaxHV = input.int(1, "Max HVN per profile", minval = 0, maxval = 3, group = GP)
int    inMaxLV = input.int(1, "Max LVN per profile", minval = 0, maxval = 3, group = GP)
float  inBin   = input.float(0.0, "Fine bin pts (0 = auto: 1.0 NQ / 0.25 ES)", minval = 0, group = GP)
string inLtf   = input.timeframe("", "Intrabar TF (blank = auto)", group = GP)

float inClW    = input.float(0.0, "Cluster width pts (0 = auto: regime tier × dATR)", minval = 0, group = GK)
bool  showLvls = input.bool(true, "Draw level lines + labels", group = GK)
int   inMaxL   = input.int(12, "Max clusters shown · STRUCTURE mode", minval = 2, maxval = 40, group = GK)
float inHide   = input.float(0, "Hide clusters farther than (pts, 0 = off)", minval = 0, group = GK)
int   inOff    = input.int(1, "Label offset (bars right)", minval = 1, maxval = 50, group = GK)
bool  showPx   = input.bool(true, "Show price in labels", group = GK)

bool showDevS  = input.bool(true, "Developing session POC line (sPOC)", group = GE)
bool showDevD  = input.bool(true, "Developing day POC line (dPOC)", group = GE)
bool inclDevMR = input.bool(true, "Developing levels join the pool", group = GE, tooltip = "sPOC rank 6, sVAH/sVAL 4, dPOC 8, dVAH/dVAL 6 — scored and tradeable like everything else. Only the POC lines draw; VA edges surface through the nearest-K render when they qualify.")

bool showVwap = input.bool(true, "Session VWAP + ±1σ", group = GW)
bool showSd2  = input.bool(true, "±2σ band", group = GW)
bool showSd3  = input.bool(false, "±3σ band", group = GW)
bool inclTwap = input.bool(true, "Session TWAP — line + pool level (rank 6)", group = GW)

bool inclVwap = input.bool(true, "Pool: VWAP (rank 10)", group = GLP)
bool inclSd2  = input.bool(true, "Pool: ±2σ (rank 6)", group = GLP)
bool inclDay  = input.bool(true, "Pool: live session H/L (rank 8)", group = GLP)
bool inclON   = input.bool(true, "Pool: ONH/ONL (rank 6)", group = GLP)

// ── THE EDGE ── one setup: session-VWAP mean reversion at structure
bool  enMR             = input.bool(true, "Enable MR signals", group = GME)
float adxGreen         = input.float(25, "ADX < this = FULL MR", minval = 5, maxval = 60, group = GME, tooltip = "ADX(14) on the chart TF via ta.dmi(14,14), confirmed bars only. Below this the regime is FULL: every qualifying setup fires.")
float adxAmber         = input.float(30, "ADX < this = EXTREME-ONLY", minval = 5, maxval = 80, group = GME, tooltip = "Between green and amber only EXTREME setups fire: stretch ≥ 2σ AND strict RSI AND level score ≥ trade floor + 2. At/above amber: NO mean reversion — the tape is trending.")
float stretchSigmaMin  = input.float(1.5, "Stretch: min σ from VWAP", minval = 0.5, maxval = 4, step = 0.1, group = GME, tooltip = "Distance from session VWAP in the script's own session σ.")
float stretchRangeMult = input.float(0.35, "Stretch: min range multiple", minval = 0.05, maxval = 2, step = 0.05, group = GME, tooltip = "× ATR(14) of the chart TF. Stretch passes when EITHER the σ-distance or this range distance is met (σ can be small early in a session).")
int   rsiLen           = input.int(7, "RSI length", minval = 2, maxval = 30, group = GME)
float rsiLong          = input.float(30, "RSI ≤ → long trigger", minval = 5, maxval = 50, group = GME)
float rsiShort         = input.float(70, "RSI ≥ → short trigger", minval = 50, maxval = 95, group = GME)
float rsiLongStrict    = input.float(25, "RSI ≤ → long (EXTREME-ONLY)", minval = 2, maxval = 50, group = GME)
float rsiShortStrict   = input.float(75, "RSI ≥ → short (EXTREME-ONLY)", minval = 50, maxval = 98, group = GME, tooltip = "The trigger is a 2-bar window: this confirmed bar OR the prior confirmed bar at the threshold — the rejection candle is often the bar AFTER the RSI extreme.")
float inWick           = input.float(0.55, "Rejection: close position ≥ (0.5–1)", minval = 0.5, maxval = 1, step = 0.05, group = GME, tooltip = "Long: close must sit in the top fraction of the bar range AND back on the VWAP side of the level. Short mirrored. This is the pin/engulf/strong-close proxy.")
float inMrTol          = input.float(0.0, "Touch tolerance pts (0 = auto: 2× cluster width)", minval = 0, group = GME)
// EXTREME-ONLY constants (documented, not inputs — the spec's fixed cuts)
const float EXT_SIGMA = 2.0
const float EXT_BUMP  = 2.0

int  inMaxSig   = input.int(3, "Max signals per day (3-trade rule)", minval = 1, maxval = 10, group = GT)
bool inHardCap  = input.bool(false, "Hard-stop signals at max", group = GT)
bool inRthOnly  = input.bool(false, "Signals only in NY RTH", group = GT)
bool inSessOnly = input.bool(true, "Signals only during sessions (pause 16:00-18:00 ET)", group = GT)
int  inCd       = input.int(5, "Cooldown bars between signals", minval = 0, group = GT)
bool showPlan   = input.bool(true, "Draw entry / stop / T1 on signal (auto-ends on TP/SL hit)", group = GT)
string inSigSize = input.string("Normal", "Signal label size", options = ["Small", "Normal", "Large"], group = GT)

float inReactAlpha = input.float(0.4, "Hold-rate EWMA alpha", minval = 0.05, maxval = 1.0, step = 0.05, group = GES)
int   inReactWin   = input.int(3, "Reaction window (bars after touch)", minval = 1, maxval = 10, group = GES)
float inHoldTravel = input.float(0.10, "HOLD: travel ≥ × dATR from the edge", minval = 0.01, step = 0.01, group = GES)
float inBrkTravel  = input.float(0.10, "BREAK: travel beyond far edge ≥ × dATR", minval = 0.01, step = 0.01, group = GES)
int   inAcc        = input.int(2, "BREAK: acceptance closes beyond far edge", minval = 1, maxval = 5, group = GES)
float inFreshDecay = input.float(0.85, "Freshness decay per touch today", minval = 0.5, maxval = 1.0, step = 0.01, group = GES)
int   inStatCap    = input.int(2000, "Stat map size cap (prune above)", minval = 200, maxval = 20000, group = GES)

bool  useVix    = input.bool(true, "VIX bump (TVC:VIX daily close)", group = GRG)
float inVix1    = input.float(20, "VIX ≥ → +1 tier", group = GRG)
float inVix2    = input.float(30, "VIX ≥ → +2 tiers", group = GRG)
float inPctLow  = input.float(25, "ATR percentile: LOW below", minval = 1, maxval = 99, group = GRG)
float inPctHigh = input.float(75, "ATR percentile: HIGH at/above", minval = 1, maxval = 99, group = GRG)
float inPctExt  = input.float(90, "ATR percentile: EXTREME above", minval = 1, maxval = 99, group = GRG)
float wLow  = input.float(0.008, "Cluster width ×dATR · LOW", step = 0.001, group = GRG)
float wNorm = input.float(0.010, "Cluster width ×dATR · NORM", step = 0.001, group = GRG)
float wHigh = input.float(0.013, "Cluster width ×dATR · HIGH", step = 0.001, group = GRG)
float wExt  = input.float(0.016, "Cluster width ×dATR · EXTREME", step = 0.001, group = GRG)
float dispLow  = input.float(4, "Min display score · LOW", group = GRG)
float dispNorm = input.float(5, "Min display score · NORM", group = GRG)
float dispHigh = input.float(6, "Min display score · HIGH", group = GRG)
float dispExt  = input.float(8, "Min display score · EXTREME", group = GRG)
float trdLow  = input.float(6, "Min trade score · LOW", group = GRG)
float trdNorm = input.float(7, "Min trade score · NORM", group = GRG)
float trdHigh = input.float(8, "Min trade score · HIGH", group = GRG)
float trdExt  = input.float(10, "Min trade score · EXTREME", group = GRG)
float tpFloorLow  = input.float(0.06, "TP floor ×dATR · LOW", step = 0.01, group = GRG)
float tpFloorNorm = input.float(0.08, "TP floor ×dATR · NORM", step = 0.01, group = GRG)
float tpFloorHigh = input.float(0.10, "TP floor ×dATR · HIGH", step = 0.01, group = GRG)
float tpFloorExt  = input.float(0.12, "TP floor ×dATR · EXTREME", step = 0.01, group = GRG)
float tpCapLow  = input.float(0.25, "TP cap ×dATR · LOW", step = 0.01, group = GRG)
float tpCapNorm = input.float(0.35, "TP cap ×dATR · NORM", step = 0.01, group = GRG)
float tpCapHigh = input.float(0.45, "TP cap ×dATR · HIGH", step = 0.01, group = GRG)
float tpCapExt  = input.float(0.55, "TP cap ×dATR · EXTREME", step = 0.01, group = GRG)
float sBufLow  = input.float(0.015, "Stop buffer ×dATR · LOW", step = 0.005, group = GRG)
float sBufNorm = input.float(0.020, "Stop buffer ×dATR · NORM", step = 0.005, group = GRG)
float sBufHigh = input.float(0.025, "Stop buffer ×dATR · HIGH", step = 0.005, group = GRG)
float sBufExt  = input.float(0.030, "Stop buffer ×dATR · EXTREME", step = 0.005, group = GRG)

float inEntryOff  = input.float(0.25, "Entry offset into zone (× cluster width)", minval = 0.0, maxval = 1.0, step = 0.05, group = GTC, tooltip = "Entry = entry-level edge on the trade side, offset INTO the zone — a resting limit that fills on the retest after the rejection confirms.")
float inTpStand   = input.float(0.10, "T1 standoff (× cluster width, min 1 tick)", minval = 0.0, step = 0.05, group = GTC, tooltip = "When a working level sits between entry and VWAP, T1 lands this far IN FRONT of it — never through it. T2 = VWAP then.")
float inMinR      = input.float(0.7, "Min R (tpDist ≥ minR × stopDist)", minval = 0.1, step = 0.05, group = GTC)
int   inValidBars = input.int(6, "Signal valid (bars)", minval = 1, maxval = 50, group = GTC, tooltip = "BAR-based: 6 bars on the 15m chart of record = 90 minutes. After this the emitted prices are stale; a new signal supersedes.")
int   inTpMaxT    = input.int(100, "Target max distance (ticks)", minval = 10, maxval = 400, group = GTC, tooltip = "The believability cap: VWAP farther than this from the entry is not a real mean-reversion signal — no trade, never a truncated mid-air target.")

int   inApprBars = input.int(5, "Initiative: velocity window (bars)", minval = 2, maxval = 20, group = GSG)
float inVMax     = input.float(0.03, "Initiative: max velocity (× dATR per bar)", minval = 0.005, step = 0.005, group = GSG, tooltip = "Approach velocity above this = initiative pressure — stand down, no reversal.")
int   inCMax     = input.int(6, "Initiative: max consecutive closes into level", minval = 2, maxval = 20, group = GSG)
bool  useLtfDelta = input.bool(true, "Delta standdown (lower-TF up/down volume)", group = GSG, tooltip = "Scripted stand-in for the manual footprint read — a FILTER, not a trigger. One-sided flow into the level with the approach = absorption absent = no reversal.")
float inDMax     = input.float(0.6, "Delta standdown: normalized delta ≥", minval = 0.1, maxval = 1.0, step = 0.05, group = GSG)

float riskPct  = input.float(0.5, "Risk per trade (%)", minval = 0.25, maxval = 0.75, step = 0.05, group = GRK)
float acctSize = input.float(50000, "Account size ($)", minval = 100, group = GRK, tooltip = "HUD-only advisory sizing: contracts = floor(risk$ ÷ (stop ticks × tick value)). CFD/forex (pointvalue 1) shows ticks only. Never an order.")

bool feedNoTrade = input.bool(false, "NOTRADE events to alerts", group = GLF, tooltip = "Pipe-delimited EVT=NOTRADE on room-gate / believability kills. Rides the same 'Any alert() function call' alert. Default OFF — the only default alerts are BUY MR / SELL MR.")

bool showDash = input.bool(true, "Status panel", group = GD)
string inDashPos = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = GD)
bool showDebugHud = input.bool(false, "Debug HUD (REGIME · ADX · STRETCH · GATES)", group = GD)
int  inShowK = input.int(3, "Levels drawn per side (execution)", minval = 1, maxval = 5, group = GD, tooltip = "EXECUTION mode draws only the nearest K qualifying levels above and K below price (EffScore ≥ the regime's display floor). STRUCTURE mode keeps the full map.")

color colS5     = input.color(#ffd54f, "★★★★★ level", group = GC)
color colS4     = input.color(#ff9800, "★★★★ level", group = GC)
color colS3     = input.color(#2962ff, "★★★ level", group = GC)
color colS2     = input.color(#787b86, "★★ level", group = GC)
color colS1     = input.color(#4c5158, "★ level", group = GC)
color colDevPoc = input.color(#ff9800, "Developing POC lines", group = GC)
color colVwap   = input.color(#00bcd4, "VWAP", group = GC)
color colBand   = input.color(#9598a1, "σ bands", group = GC)
color colRth    = input.color(#00bcd4, "RTH open line (NY)", group = GC)
color colEth    = input.color(#4c5158, "ETH open line (Asia/London)", group = GC)
color colUp     = input.color(#00FF00, "Long signals / T1", group = GC)
color colDn     = input.color(#673ab7, "Short signals", group = GC)
color colStop   = input.color(#ef5350, "Stop line / loss", group = GC)
color colText   = input.color(#d1d4dc, "Labels / plan text", group = GC)
string inSty    = input.string("Solid", "Level line style", options = ["Solid", "Dashed", "Dotted"], group = GC)
int inWidW = input.int(3, "Line width · weekly-scope level", minval = 1, maxval = 5, group = GC)
int inWidD = input.int(2, "Line width · daily-scope level", minval = 1, maxval = 5, group = GC)
int inWidS = input.int(1, "Line width · session-scope level", minval = 1, maxval = 5, group = GC)

// ── DERIVED ────────────────────────────────────────────────────────────────
int   tfSec   = timeframe.in_seconds(timeframe.period)
int   barMs   = tfSec * 1000
bool  htfMode = tfSec >= timeframe.in_seconds(inModeTf)
float fineBin = inBin > 0 ? inBin : isES ? 0.25 : 1.0
string ltfStr = inLtf != "" ? inLtf : tfSec >= 3600 ? "5" : tfSec >= 60 ? "1" : "1S"
string prSty  = inSty == "Dashed" ? line.style_dashed : inSty == "Dotted" ? line.style_dotted : line.style_solid
string sigSz  = inSigSize == "Large" ? size.large : inSigSize == "Small" ? size.small : size.normal

// global series used inside functions — must exist before function defs
float atr14  = ta.atr(14)
float cPrev  = close[1]
float cPrev2 = close[2]
float loW    = math.min(low, low[1])
float hiW    = math.max(high, high[1])
float barRng = high - low
float cPos   = barRng > 0 ? (close - low) / barRng : 0.5
// the edge's oscillators — global scope, read on confirmed bars only
[diP, diM, adxV] = ta.dmi(14, 14)
float rsiV = ta.rsi(close, rsiLen)

// sessions
bool inRTH   = not na(time(timeframe.period, rthSess, TZ))
bool inON    = not na(time(timeframe.period, onSess, TZ))
bool inA     = not na(time(timeframe.period, sAsia, TZ))
bool inL     = not na(time(timeframe.period, sLdn, TZ))
bool newRTH  = inRTH and not inRTH[1]
// one session string for the engines AND the dashboard
string sessNow = inRTH ? "NY" : inL ? "LDN" : inA ? "ASIA" : "OFF"
// all-sessions machinery: every session is first-class
bool inAnySess = inRTH or inL or inA
bool newSess = inAnySess and sessNow != sessNow[1]
var int sessStartT = na
if newSess
    sessStartT := time
// the trading day begins at the Asia open (18:00 ET)
bool newTradeDay = newSess and sessNow == "ASIA"
// per-session initial balance window: first N minutes of the ACTIVE session
bool inIBw = inAnySess and not na(sessStartT) and time - sessStartT < inIbMin * 60 * 1000

// ── REQUESTS ── budget: THREE calls (unchanged since 2.6) ──────────────────
// Lower-TF close/volume feed the profiles and the up/down volume split; two
// daily pulls feed the regime engine. Daily pattern is value[1] +
// lookahead_on = yesterday's COMPLETED value — constant all day, identical
// on history and realtime.
[ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfStr, [close, volume])
[dAtr, atrPctD] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], ta.percentrank(ta.atr(14), 60)[1]], lookahead = barmerge.lookahead_on)
float vixD = request.security("TVC:VIX", "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

// cluster width: regime tier × dATR, recomputed only at session boundaries
// or tier change. 3.0: the legacy tick seed is gone — the fallback until the
// daily feed is up is 0.02×dATR, then chart ATR(14), then a tick floor.
float clustWSeed = not na(dAtr) ? 0.02 * dAtr : math.max(nz(atr14) * 2.0, 8 * syminfo.mintick)
var float clustW = na
float clustWv = inClW > 0 ? inClW : nz(clustW, clustWSeed)
float mrTol = inMrTol > 0 ? inMrTol : 2 * clustWv

// ── TYPES & BASE FUNCTIONS ─────────────────────────────────────────────────
type Prof
    array<float> vol
    int   base
    float lo
    float hi

type Lvl
    float  price
    string name
    int    rank
    int    scope   // 1 session · 2 day · 3 week

// ── EFFECTIVE SCORE types ──────────────────────────────────────────────────
// Per-level reaction memory lives in maps keyed by STABLE IDENTITY, so a
// migrating developing level (or tomorrow's pdPOC at a new price) carries
// its behavioral history. Key scheme (built ONLY by f_lvlKey/base names —
// never inline, key drift orphans stats):
//   named levels : the name verbatim ("pdPOC", "NY H", "VWAP", "sPOC", …)
//   HVN/LVN      : name + "_" + round(price / clusterWidth)  (price bucket)
//   direction    : "|B" fromBelow · "|A" fromAbove appended for DirStat
type DirStat
    float ewma  = na   // na = untested → reactionMult exactly 1.0
    int   holdN = 0
    int   brkN  = 0
    int   epoch = -1   // scope epoch — stale = the level's period rolled

type FreshStat
    int tchToday = 0
    int epoch    = -1
    int lastBar  = -1  // bar of the newest touch — its own evaluation bar
                       // reads freshness WITHOUT it

f_newProf() =>
    Prof.new(array.new<float>(), 0, na, na)

f_add(Prof p, float pr, float v) =>
    float vv = nz(v)
    int k = int(math.floor(pr / fineBin))
    if array.size(p.vol) == 0
        p.base := k
        array.push(p.vol, vv)
    else
        while k < p.base
            array.unshift(p.vol, 0.0)
            p.base := p.base - 1
        while k > p.base + array.size(p.vol) - 1
            array.push(p.vol, 0.0)
        array.set(p.vol, k - p.base, array.get(p.vol, k - p.base) + vv)
    p.hi := na(p.hi) ? pr : math.max(p.hi, pr)
    p.lo := na(p.lo) ? pr : math.min(p.lo, pr)

f_stretchProf(Prof p, float h, float l) =>
    p.hi := na(p.hi) ? h : math.max(p.hi, h)
    p.lo := na(p.lo) ? l : math.min(p.lo, l)

// Developing POC / VAH / VAL straight off the fine bins — the live read.
// Returns [poc, vah, val]; na tuple while the profile is still empty.
f_devPVV(Prof p) =>
    float poc = na
    float vah = na
    float val = na
    int nb = array.size(p.vol)
    if nb > 0 and not na(p.lo) and not na(p.hi) and p.hi > p.lo
        float tot = 0.0
        int pocB = 0
        float mxB = -1.0
        for i = 0 to nb - 1
            float bv = array.get(p.vol, i)
            tot += bv
            if bv > mxB
                mxB := bv
                pocB := i
        if tot > 0
            float vaVol = array.get(p.vol, pocB)
            int up = pocB + 1
            int dn = pocB - 1
            while vaVol < tot * inVA / 100.0
                float vu = up <= nb - 1 ? array.get(p.vol, up) : -1.0
                float vd = dn >= 0 ? array.get(p.vol, dn) : -1.0
                if vu < 0 and vd < 0
                    break
                if vu >= vd
                    vaVol += vu
                    up += 1
                else
                    vaVol += vd
                    dn -= 1
            poc := (p.base + pocB + 0.5) * fineBin
            vah := (p.base + up) * fineBin
            val := (p.base + dn + 1) * fineBin
    [poc, vah, val]

// completed profile → ranked levels. rank = scope + kind.
f_levels(Prof p, string pre, int scope) =>
    array<Lvl> out = array.new<Lvl>()
    int nb = array.size(p.vol)
    if nb > 0 and not na(p.lo) and not na(p.hi) and p.hi > p.lo
        float rowH = (p.hi - p.lo) / inRows
        array<float> rv = array.new<float>(inRows, 0.0)
        float tot = 0.0
        for i = 0 to nb - 1
            float bv = array.get(p.vol, i)
            if bv > 0
                float pr = (p.base + i + 0.5) * fineBin
                int ri = math.min(inRows - 1, math.max(0, int(math.floor((pr - p.lo) / rowH))))
                array.set(rv, ri, array.get(rv, ri) + bv)
                tot += bv
        if tot > 0
            // row POC index — kept only to exclude the POC row from HVN picks
            int pocI = 0
            float mx = -1.0
            for i = 0 to inRows - 1
                if array.get(rv, i) > mx
                    mx := array.get(rv, i)
                    pocI := i
            // tick-accurate POC / VA off the fine bins — identical on every chart TF
            int pocB = 0
            float mxB = -1.0
            for i = 0 to nb - 1
                if array.get(p.vol, i) > mxB
                    mxB := array.get(p.vol, i)
                    pocB := i
            float vaVol = array.get(p.vol, pocB)
            int up = pocB + 1
            int dn = pocB - 1
            while vaVol < tot * inVA / 100.0
                float vu = up <= nb - 1 ? array.get(p.vol, up) : -1.0
                float vd = dn >= 0 ? array.get(p.vol, dn) : -1.0
                if vu < 0 and vd < 0
                    break
                if vu >= vd
                    vaVol += vu
                    up += 1
                else
                    vaVol += vd
                    dn -= 1
            float avgRow = tot / inRows
            int kS = scope == 3 ? 5 : scope == 2 ? 3 : 1
            out.push(Lvl.new((p.base + pocB + 0.5) * fineBin, pre + "POC", kS + 5, scope))
            out.push(Lvl.new((p.base + up) * fineBin, pre + "VAH", kS + 3, scope))
            out.push(Lvl.new((p.base + dn + 1) * fineBin, pre + "VAL", kS + 3, scope))
            if inMaxHV > 0
                array<int> usedH = array.new<int>()
                for c = 1 to inMaxHV
                    int bi = -1
                    float bb = -1.0
                    for i = 1 to inRows - 2
                        float v0 = array.get(rv, i)
                        if i != pocI and v0 >= inHvnK * avgRow and v0 > array.get(rv, i - 1) and v0 >= array.get(rv, i + 1) and not array.includes(usedH, i) and v0 > bb
                            bb := v0
                            bi := i
                    if bi >= 0
                        usedH.push(bi)
                        out.push(Lvl.new(p.lo + (bi + 0.5) * rowH, pre + "HVN", kS + 2, scope))
            if inMaxLV > 0
                array<int> usedL = array.new<int>()
                for c = 1 to inMaxLV
                    int bi = -1
                    float bb = 1.0e18
                    for i = 1 to inRows - 2
                        float v0 = array.get(rv, i)
                        if v0 <= inLvnK * avgRow and v0 < array.get(rv, i - 1) and v0 < array.get(rv, i + 1) and not array.includes(usedL, i) and v0 < bb
                            bb := v0
                            bi := i
                    if bi >= 0
                        usedL.push(bi)
                        out.push(Lvl.new(p.lo + (bi + 0.5) * rowH, pre + "LVN", kS + 1, scope))
            out.push(Lvl.new(p.hi, pre + "H", kS + 3, scope))
            out.push(Lvl.new(p.lo, pre + "L", kS + 3, scope))
    out

f_gather(array<Lvl> src, array<float> gp, array<int> gr, array<int> gs, array<string> gn) =>
    for x in src
        gp.push(x.price)
        gr.push(x.rank)
        gs.push(x.scope)
        gn.push(x.name)
    true

// Stable stat key for one atomic level. Named levels key by name (concept
// identity: "pdPOC" is one behavioral fact forever). HVN/LVN have no name —
// they key by price bucket, quantized by the active cluster width.
f_lvlKey(string nm, float price, float w) =>
    str.endswith(nm, "HVN") or str.endswith(nm, "LVN") ? nm + "_" + str.tostring(math.round(price / math.max(w, syminfo.mintick))) : nm

// merge levels within width w into clusters. rank = sum, price = rank-weighted.
// Also emits per-cluster TIGHT zone (member-price span, min width w) and the
// flattened member slice (key/rank/scope) the Effective Score engine
// attributes touches to. Stats are NOT touched here — clusters are a view,
// the maps are the durable truth.
f_clusters(array<Lvl> aW, array<Lvl> aD, array<Lvl> aA, array<Lvl> aL, array<Lvl> aN, bool useSess, float w, array<float> clP, array<float> clR, array<int> clS, array<string> clN, array<float> cLoT, array<float> cHiT, array<int> cMemA, array<int> cMemN, array<string> mKey, array<float> mRank, array<int> mScope) =>
    clP.clear()
    clR.clear()
    clS.clear()
    clN.clear()
    cLoT.clear()
    cHiT.clear()
    cMemA.clear()
    cMemN.clear()
    mKey.clear()
    mRank.clear()
    mScope.clear()
    array<float> gp = array.new<float>()
    array<int> gr = array.new<int>()
    array<int> gs = array.new<int>()
    array<string> gn = array.new<string>()
    f_gather(aW, gp, gr, gs, gn)
    f_gather(aD, gp, gr, gs, gn)
    if useSess
        f_gather(aA, gp, gr, gs, gn)
        f_gather(aL, gp, gr, gs, gn)
        f_gather(aN, gp, gr, gs, gn)
    int n = gp.size()
    if n > 0
        array<int> ord = array.sort_indices(gp)
        float wSum = 0.0
        float rSum = 0.0
        int sMax = 0
        string nAcc = ""
        int cnt = 0
        float lastP = na
        float mLo = na
        float mHi = na
        int memA = 0
        for r = 0 to n - 1
            int k = ord.get(r)
            float p = gp.get(k)
            bool merge = cnt > 0 and p - lastP <= w
            if not merge and cnt > 0
                clP.push(wSum / rSum)
                clR.push(rSum)
                clS.push(sMax)
                clN.push(nAcc)
                // tight zone: member span, widened symmetrically to ≥ w
                float pad0 = math.max(0.0, (w - (mHi - mLo)) / 2)
                cLoT.push(mLo - pad0)
                cHiT.push(mHi + pad0)
                cMemA.push(memA)
                cMemN.push(cnt)
                wSum := 0.0
                rSum := 0.0
                sMax := 0
                nAcc := ""
                cnt := 0
                mLo := na
                mHi := na
                memA := mKey.size()
            wSum += p * gr.get(k)
            rSum += gr.get(k)
            sMax := math.max(sMax, gs.get(k))
            nAcc := cnt == 0 ? gn.get(k) : cnt < 3 ? nAcc + "+" + gn.get(k) : cnt == 3 ? nAcc + "+…" : nAcc
            mLo := na(mLo) ? p : math.min(mLo, p)
            mHi := na(mHi) ? p : math.max(mHi, p)
            mKey.push(f_lvlKey(gn.get(k), p, w))
            mRank.push(gr.get(k))
            mScope.push(gs.get(k))
            cnt += 1
            lastP := p
        if cnt > 0
            clP.push(wSum / rSum)
            clR.push(rSum)
            clS.push(sMax)
            clN.push(nAcc)
            float pad1 = math.max(0.0, (w - (mHi - mLo)) / 2)
            cLoT.push(mLo - pad1)
            cHiT.push(mHi + pad1)
            cMemA.push(memA)
            cMemN.push(cnt)
    true

f_stars(float r) =>
    r >= 10 ? 5 : r >= 8 ? 4 : r >= 6 ? 3 : r >= 4 ? 2 : 1

// Exact score display — the raw summed rank, uncapped. One math for every
// level; stars remain only as color bands.
f_scoreTxt(float r) =>
    "[" + str.tostring(int(math.round(r))) + "]"

f_starCol(int s) =>
    s == 5 ? colS5 : s == 4 ? colS4 : s == 3 ? colS3 : s == 2 ? colS2 : colS1

// Brand dashboard row: dark card, dim key, state-colored value text.
f_row(table t, int r, string k, string v, color st) =>
    table.cell(t, 0, r, k, text_color = #787b86, text_size = size.tiny, bgcolor = color.new(#0d0d10, 8))
    table.cell(t, 1, r, v, text_color = st, text_size = size.tiny, bgcolor = color.new(st, 86))

// ── STATE ──────────────────────────────────────────────────────────────────
var Prof dP = f_newProf()
var Prof wP = f_newProf()
var Prof aP = f_newProf()
var Prof lP = f_newProf()
var Prof nP = f_newProf()
var array<Lvl> priorD = array.new<Lvl>()
var array<Lvl> priorW = array.new<Lvl>()
var array<Lvl> priorA = array.new<Lvl>()
var array<Lvl> priorL = array.new<Lvl>()
var array<Lvl> priorN = array.new<Lvl>()
// clusters (parallel arrays)
var array<float>  clP = array.new<float>()
var array<float>  clR = array.new<float>()
var array<int>    clS = array.new<int>()
var array<string> clN = array.new<string>()
var array<float>  clLoT = array.new<float>()
var array<float>  clHiT = array.new<float>()
var array<int>    clMemA = array.new<int>()
var array<int>    clMemN = array.new<int>()
var array<string> memKey = array.new<string>()
var array<float>  memRank = array.new<float>()
var array<int>    memScope = array.new<int>()
var bool needCl = false
// anchors for the developing-level lines
var int dT0 = na
var int wT0 = na
var int aT0 = na
var int lT0 = na
var int nT0 = na
// overnight extremes (live session extremes ride sessHi/sessLo)
var float onHi = na
var float onLo = na
// VWAP accumulators
var float sPV = 0.0
var float sV = 0.0
var float sP2 = 0.0
// session TWAP (time-weighted): plain mean of hlc3 since session open
var float sTw = 0.0
var int sTwN = 0
// IB — level pair only since 3.0
var float ibHi = na
var float ibLo = na
var bool ibDone = false
// discipline
var int sigCnt = 0
var int lastSigBar = -99999
// developing levels (confirmed-close values — anti-repaint)
var float devSPoc = na
var float devSVah = na
var float devSVal = na
var float devDPoc = na
var float devDVah = na
var float devDVal = na
// plan drawings + live-plan state
var line planE = na
var line planS = na
var line planT = na
var label planRes = na
var int planDir = 0
var float planSp = na
var float planTp = na
var float planEp = na
var bool planFilled = false
var bool planOn = false
// last lower-TF close carried across chart bars for the up/down volume split
var float lastLtf = na
// reaction memory — the durable truth clusters are only a view of
var map<string, DirStat> dirStats = map.new<string, DirStat>()
var map<string, FreshStat> freshStats = map.new<string, FreshStat>()
// epoch counters: bump at scope boundaries → stale-epoch reads count as 0
var int epSess = 0
var int epDay = 0
var int epWeek = 0
// any Asia bar seen since the last daily roll → the Asia-open trade-day
// boundary exists on this data; otherwise the calendar day stands in
var bool sawAsia = false
// pending touches — fully self-contained snapshots (dir, frozen tight-zone
// edges, seeded acceptance/excursion, ";"-joined member keys) so resolution
// 1-3 bars later attributes to the same atoms even after a cluster rebuild
var array<int>    pdDirA = array.new<int>()
var array<float>  pdLoA = array.new<float>()
var array<float>  pdHiA = array.new<float>()
var array<int>    pdBarA = array.new<int>()
var array<int>    pdCnsA = array.new<int>()
var array<float>  pdBeyA = array.new<float>()
var array<string> pdKeysA = array.new<string>()
// regime
var int tier = 1              // 0 LOW · 1 NORM · 2 HIGH · 3 EXTREME
var float atrPct = na
// unified level pool: clusters first (pool idx == cluster idx), then dynamic
// singletons. Rebuilt every confirmed bar — touch engine, MR engine, HUD and
// the execution render all read THIS.
var array<float>  poolP = array.new<float>()
var array<float>  poolLoT = array.new<float>()
var array<float>  poolHiT = array.new<float>()
var array<float>  poolRank = array.new<float>()
var array<string> poolName = array.new<string>()
var array<int>    poolMemA = array.new<int>()
var array<int>    poolMemN = array.new<int>()
var array<string> pmKey = array.new<string>()
var array<float>  pmRank = array.new<float>()
var array<int>    pmScope = array.new<int>()
// initiative trackers (vars → [k] history works)
var int upStrk = 0
var int dnStrk = 0
var float barDelta = 0.0
var float barVolUD = 0.0
// session extremes (pool sesH/sesL)
var string sessPrev = ""
var float sessHi = na
var float sessLo = na
// session-open perspective lines (3.1) — static historical markers, drawn
// once per session on the confirmed bar, never redrawn/repainted
var array<line> sessLn = array.new<line>()
var array<label> sessLb = array.new<label>()
// live MR signal (HUD SIGNAL state + validity window)
var int sigDir = 0
var float sigE = na
var float sigS = na
var float sigT = na
var float sigT2 = na
var float sigR = na
var int sigBorn = na
var string sigLvlTxt = ""
var string sigTgtNm = ""
// HUD gate tokens — confirmed-bar snapshots, display only
var float adxDisp = na
var int regDisp = -1          // 2 FULL · 1 EXTREME-ONLY · 0 NO MR · -1 unknown
var float sigmaDisp = na
var float rsiDisp = na
var bool stretchDispOK = false
var bool rsiDispOK = false
var bool lvlDispOK = false

// ── EFFECTIVE SCORE · REGIME · CONSTRUCTION functions ──────────────────────
// epoch for a scope: 3 week · 2 day · else session
f_epochFor(int scope) =>
    scope == 3 ? epWeek : scope == 2 ? epDay : epSess

// effComponent of one atom for one arrival direction (1 = fromBelow).
// untested direction reads exactly 1.0; na-guarded so a missing key can
// never poison the sum.
f_comp(string baseKey, int dirCode, float baseRank, int scope) =>
    int ep = f_epochFor(scope)
    DirStat ds = dirStats.get(baseKey + (dirCode == 1 ? "|B" : "|A"))
    float mult = na(ds) or na(ds.ewma) or ds.epoch != ep ? 1.0 : math.max(0.5, math.min(1.5, 0.5 + ds.ewma))
    FreshStat fs = freshStats.get(baseKey)
    int tchT = na(fs) or fs.epoch != ep ? 0 : fs.tchToday
    // the newest touch doesn't decay its OWN evaluation bar — a first touch
    // is graded naked (1.0); the decay shows up on the next approach
    if not na(fs) and fs.epoch == ep and fs.lastBar == bar_index
        tchT := math.max(0, tchT - 1)
    baseRank * mult * math.pow(inFreshDecay, tchT)

// directional record for labels — "3H/1B"; untested this period = "new"
f_recordTxt(string baseKey, int dirCode, int scope) =>
    DirStat ds = dirStats.get(baseKey + (dirCode == 1 ? "|B" : "|A"))
    na(ds) or ds.epoch != f_epochFor(scope) ? "new" : str.tostring(ds.holdN) + "H/" + str.tostring(ds.brkN) + "B"

// touch freshness: epoch-tagged touchesToday increment (O(1) scope resets)
f_touchMark(string baseKey, int scope) =>
    FreshStat fs = freshStats.get(baseKey)
    if na(fs)
        fs := FreshStat.new()
        freshStats.put(baseKey, fs)
    int ep = f_epochFor(scope)
    if fs.epoch != ep
        fs.epoch := ep
        fs.tchToday := 1
    else
        fs.tchToday += 1
    fs.lastBar := bar_index
    true

// outcome resolution: EWMA update (seeded from neutral 0.5) + H/B record,
// for every member of the touched zone, in the touch's direction. This is
// the ONLY writer of ewma — touch time never moves it.
f_resolveKeys(string keysCsv, int dirCode, float outcome) =>
    array<string> ks = str.split(keysCsv, ";")
    for kk in ks
        array<string> parts = str.split(kk, ",")
        if parts.size() >= 2
            string dk = parts.get(0) + (dirCode == 1 ? "|B" : "|A")
            int scope = int(nz(str.tonumber(parts.get(1)), 1))
            int ep = f_epochFor(scope)
            DirStat ds = dirStats.get(dk)
            if na(ds)
                ds := DirStat.new()
                dirStats.put(dk, ds)
            if ds.epoch != ep
                ds.epoch := ep
                ds.ewma := na
                ds.holdN := 0
                ds.brkN := 0
            ds.ewma := na(ds.ewma) ? 0.5 + inReactAlpha * (outcome - 0.5) : ds.ewma + inReactAlpha * (outcome - ds.ewma)
            if outcome > 0.5
                ds.holdN += 1
            else
                ds.brkN += 1
    true

// regime tier parameter lookups (all inputs)
f_tierW() =>
    tier == 0 ? wLow : tier == 1 ? wNorm : tier == 2 ? wHigh : wExt
f_tierDisp() =>
    tier == 0 ? dispLow : tier == 1 ? dispNorm : tier == 2 ? dispHigh : dispExt
f_tierTrd() =>
    tier == 0 ? trdLow : tier == 1 ? trdNorm : tier == 2 ? trdHigh : trdExt
f_tierTpFloor() =>
    tier == 0 ? tpFloorLow : tier == 1 ? tpFloorNorm : tier == 2 ? tpFloorHigh : tpFloorExt
f_tierTpCap() =>
    tier == 0 ? tpCapLow : tier == 1 ? tpCapNorm : tier == 2 ? tpCapHigh : tpCapExt
f_tierSBuf() =>
    tier == 0 ? sBufLow : tier == 1 ? sBufNorm : tier == 2 ? sBufHigh : sBufExt
f_tierName() =>
    tier == 0 ? "LOW" : tier == 1 ? "NORM" : tier == 2 ? "HIGH" : "EXTREME"

// append a dynamic singleton to the pool: zone = price ± half cluster width,
// its own single member (keyed by name — concept identity)
f_poolAdd(float px, string nm, float rk, int scope) =>
    if not na(px)
        float hw = math.max(clustWv, syminfo.mintick) / 2
        poolP.push(px)
        poolLoT.push(px - hw)
        poolHiT.push(px + hw)
        poolRank.push(rk)
        poolName.push(nm)
        poolMemA.push(pmKey.size())
        poolMemN.push(1)
        pmKey.push(nm)
        pmRank.push(rk)
        pmScope.push(scope)
    true

// EffScore of pool item i for arrival direction dirCode (1 = fromBelow):
// Σ member effComponents. Invariant: an all-untested item's EffScore == its
// plain summed rank.
f_poolScore(int i, int dirCode) =>
    float s = 0.0
    int a = poolMemA.get(i)
    int nM = poolMemN.get(i)
    if nM > 0
        for m = a to a + nM - 1
            s += f_comp(pmKey.get(m), dirCode, pmRank.get(m), pmScope.get(m))
    s

// MR rejection test at pool item i — 2.9's f_mrTest on zone geometry. The
// legacy fixed-tick pierce allowance is the regime stop buffer now: a wick
// beyond where the structure stop would sit = the level failed, no MR.
// Returns 1 long, -1 short, 0 none.
f_mrTest3(int i) =>
    int d = 0
    float lvl = poolP.get(i)
    float zLo = poolLoT.get(i)
    float zHi = poolHiT.get(i)
    float pierce = not na(dAtr) ? f_tierSBuf() * dAtr : mrTol
    if (cPrev > lvl or cPrev2 > lvl) and loW <= math.max(zHi, lvl + mrTol) and loW >= zLo - pierce and close > lvl and cPos >= inWick
        d := 1
    else if (cPrev < lvl or cPrev2 < lvl) and hiW >= math.min(zLo, lvl - mrTol) and hiW <= zHi + pierce and close < lvl and cPos <= 1 - inWick
        d := -1
    d

// Dynamic ticket (3.0) — 100% resting-limit workflow. dir = trade direction;
// short mirrors long by arithmetic, never by duplicated branches.
//   E  = entry-level tight edge on the trade side, offset INTO the zone
//   S  = far edge − regime buffer AND beyond the touch bar's extreme:
//        long stop = min(farEdge − buf, touchLow − 1 tick), short mirrored
//   T1 = SESSION VWAP — the primary target. A qualifying pool level between
//        entry and VWAP intercepts: T1 = its front edge − standoff (never
//        through a working level, never skipped) and T2 = VWAP.
//        VWAP farther than the believability cap (ticks) or the regime TP
//        cap → NO TRADE (tp returns na).
//   Room gate: tpDist ≥ max(minR × stopDist, tpFloor × dATR) or NO TRADE.
// Returns [entry, stop, tp1, tp2, r, roomOk, targetName].
f_construct3(int i, int dir, float dAtrP, float tchExt, float vwapPx) =>
    float wNow = math.max(clustWv, syminfo.mintick)
    float entry = dir == 1 ? poolHiT.get(i) - inEntryOff * wNow : poolLoT.get(i) + inEntryOff * wNow
    float stopStr = dir == 1 ? poolLoT.get(i) - f_tierSBuf() * dAtrP : poolHiT.get(i) + f_tierSBuf() * dAtrP
    float stopExt = dir == 1 ? tchExt - syminfo.mintick : tchExt + syminfo.mintick
    float stop = dir == 1 ? math.min(stopStr, stopExt) : math.max(stopStr, stopExt)
    float stopD = (entry - stop) * dir
    float vDist = na(vwapPx) ? float(na) : (vwapPx - entry) * dir
    bool vwapOK = false
    if not na(vDist)
        vwapOK := vDist > 0 and vDist <= inTpMaxT * syminfo.mintick and vDist <= f_tierTpCap() * dAtrP
    float tp = na
    float tp2 = na
    string tgtNm = ""
    if vwapOK
        // nearest qualifying working level strictly between entry and VWAP
        // (the VWAP pool singleton is the target itself — excluded)
        float qDist = na
        float qFront = na
        int nP = poolP.size()
        if nP > 0
            for q = 0 to nP - 1
                if q != i and poolName.get(q) != "VWAP"
                    float front = dir == 1 ? poolLoT.get(q) : poolHiT.get(q)
                    float dd = (front - entry) * dir
                    if dd > 0 and dd < vDist and (na(qDist) or dd < qDist)
                        if f_poolScore(q, dir) >= f_tierTrd()
                            qDist := dd
                            qFront := front
                            tgtNm := poolName.get(q)
        if not na(qFront)
            tp := qFront - dir * math.max(syminfo.mintick, inTpStand * wNow)
            tp2 := vwapPx
        else
            tp := vwapPx
            tgtNm := "VWAP"
    float rr = float(na)
    bool ok = false
    if not na(tp) and stopD > 0
        float tpD = (tp - entry) * dir
        rr := tpD / stopD
        ok := tpD >= math.max(inMinR * stopD, f_tierTpFloor() * dAtrP)
    [entry, stop, tp, tp2, rr, ok, tgtNm]

// ── PER-BAR TRACKING (live) ────────────────────────────────────────────────
if timeframe.change("D")
    dT0 := time
if timeframe.change("W")
    wT0 := time
if inA and not inA[1]
    aT0 := time
if inL and not inL[1]
    lT0 := time
if inRTH and not inRTH[1]
    nT0 := time

if inON and not inON[1]
    onHi := high
    onLo := low
if inON
    onHi := math.max(nz(onHi, high), high)
    onLo := math.min(nz(onLo, low), low)

// trading-day reset — Asia open (18:00 ET) starts the day
if newTradeDay
    sigCnt := 0
    if not na(planE)
        line.delete(planE)
        planE := line(na)
    if not na(planS)
        line.delete(planS)
        planS := line(na)
    if not na(planT)
        line.delete(planT)
        planT := line(na)
    if not na(planRes)
        label.delete(planRes)
        planRes := label(na)
    planOn := false
    planDir := 0
// per-session VWAP + TWAP + IB: every session opens fresh
if newSess
    sPV := 0.0
    sV := 0.0
    sP2 := 0.0
    sTw := 0.0
    sTwN := 0
    ibHi := high
    ibLo := low
    ibDone := false
if inAnySess
    sPV += hlc3 * nz(volume)
    sV += nz(volume)
    sP2 += hlc3 * hlc3 * nz(volume)
    sTw += hlc3
    sTwN += 1
float vwapV = inAnySess and sV > 0 ? sPV / sV : na
float twapV = inAnySess and sTwN > 0 ? sTw / sTwN : na
float sd = inAnySess and sV > 0 ? math.sqrt(math.max(sP2 / sV - vwapV * vwapV, 0.0)) : na
float up1 = vwapV + sd
float dn1 = vwapV - sd
float up2 = vwapV + 2 * sd
float dn2 = vwapV - 2 * sd
float up3 = vwapV + 3 * sd
float dn3 = vwapV - 3 * sd

if inIBw
    ibHi := math.max(nz(ibHi, high), high)
    ibLo := math.min(nz(ibLo, low), low)
if inAnySess and not inIBw and inIBw[1] and not na(ibHi)
    ibDone := true

// NOTRADE event flag — set on confirmed bars, consumed at the bottom
bool evNoTrade = false
string evNoTradeTxt = ""

// ── ROLLS + ACCUMULATION (confirmed bars only — no repaint) ────────────────
bool tierChanged = false
if barstate.isconfirmed
    // ── REGIME step — tier from the daily ATR percentile + VIX bump.
    // Values only move at the daily roll (both pulls are prior-day [1]);
    // na percentile (young symbol) parks the tier at NORM.
    atrPct := atrPctD
    int tierNew = 1
    if not na(atrPct)
        tierNew := atrPct > inPctExt ? 3 : atrPct >= inPctHigh ? 2 : atrPct < inPctLow ? 0 : 1
        if useVix and not na(vixD)
            tierNew := math.min(3, tierNew + (vixD >= inVix2 ? 2 : vixD >= inVix1 ? 1 : 0))
    tierChanged := tierNew != tier
    tier := tierNew
    // ── EPOCH bumps + pending purge — O(1) scope resets ──────────────────
    if newSess
        epSess += 1
        // session-open perspective line (3.1) — RTH (NY) gets a tagged,
        // slightly brighter line; ETH (Asia/London) a dim untagged divider.
        // Vertical: same x both ends, extend.both handles arbitrary price
        // range. Static once drawn — never touched again (no repaint).
        if showSessLines
            bool isRth = sessNow == "NY"
            color lc = isRth ? color.new(colRth, 55) : color.new(colEth, 78)
            sessLn.push(line.new(time, low, time, high, xloc = xloc.bar_time, extend = extend.both, color = lc, style = line.style_dotted, width = 1))
            if sessLn.size() > 60
                line.delete(sessLn.shift())
            if isRth
                sessLb.push(label.new(time, high, "RTH", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#0d0d10, 60), textcolor = color.new(colRth, 20), size = size.tiny))
                if sessLb.size() > 30
                    label.delete(sessLb.shift())
    if timeframe.change("W")
        epWeek += 1
    // trade day starts at the Asia open — but data with no 18:00 ET bars
    // (RTH-only symbols) would never roll; fall back to the calendar day
    bool dayRoll = newTradeDay or (timeframe.change("D") and not sawAsia)
    if inA
        sawAsia := true
    if dayRoll
        epDay += 1
        // evidence across the 16:00-18:00 settlement halt is polluted —
        // purge open pendings as NEITHER (touches counted at open; no EWMA)
        pdDirA.clear()
        pdLoA.clear()
        pdHiA.clear()
        pdBarA.clear()
        pdCnsA.clear()
        pdBeyA.clear()
        pdKeysA.clear()
        // garbage collection: HVN/LVN bucket keys accrete over months —
        // over the cap, drop the node stats wholesale (named keys are never
        // pruned; they are the signal)
        if dirStats.size() > inStatCap or freshStats.size() > inStatCap
            array<string> dks = dirStats.keys()
            for kk in dks
                if str.contains(kk, "VN_")
                    dirStats.remove(kk)
            array<string> fks = freshStats.keys()
            for kk2 in fks
                if str.contains(kk2, "VN_")
                    freshStats.remove(kk2)
    if timeframe.change("D")
        sawAsia := false
        priorD := f_levels(dP, "pd", 2)
        dP := f_newProf()
        needCl := true
    if timeframe.change("W")
        priorW := f_levels(wP, "pw", 3)
        wP := f_newProf()
        needCl := true
    if not inA and inA[1]
        priorA := f_levels(aP, "AS ", 1)
        needCl := true
    if inA and not inA[1]
        aP := f_newProf()
    if not inL and inL[1]
        priorL := f_levels(lP, "LDN ", 1)
        needCl := true
    if inL and not inL[1]
        lP := f_newProf()
    if not inRTH and inRTH[1]
        priorN := f_levels(nP, "NY ", 1)
        needCl := true
    if newRTH
        nP := f_newProf()
    int nL = array.size(ltfC)
    if nL > 0
        for i = 0 to nL - 1
            float pc = array.get(ltfC, i)
            float vv = array.get(ltfV, i)
            if not na(pc)
                f_add(dP, pc, vv)
                f_add(wP, pc, vv)
                if inA
                    f_add(aP, pc, vv)
                if inL
                    f_add(lP, pc, vv)
                if inRTH
                    f_add(nP, pc, vv)
    else
        f_add(dP, hl2, volume)
        f_add(wP, hl2, volume)
        if inA
            f_add(aP, hl2, volume)
        if inL
            f_add(lP, hl2, volume)
        if inRTH
            f_add(nP, hl2, volume)
    f_stretchProf(dP, high, low)
    f_stretchProf(wP, high, low)
    if inA
        f_stretchProf(aP, high, low)
    if inL
        f_stretchProf(lP, high, low)
    if inRTH
        f_stretchProf(nP, high, low)
    // ── cluster width: regime tier × dATR, recomputed ONLY at a session
    // boundary or on tier change — bar-by-bar width churn scatters stats
    // across neighboring HVN buckets and shuffles cluster identity
    if na(clustW) or newSess or tierChanged
        float wTarget = not na(dAtr) ? f_tierW() * dAtr : clustWSeed
        if na(clustW) or wTarget != clustW
            clustW := wTarget
            needCl := true
            // clustWv was derived at the top of the bar from the OLD width —
            // refresh it NOW so this bar's recluster, HVN bucket keys, pool
            // zones and construction all use the new width
            clustWv := inClW > 0 ? inClW : clustW
            // mrTol (touch/zone tolerance) was derived from the OLD clustWv
            // at the top of the bar too — refresh it in lockstep, or this
            // bar's touch detection and f_mrTest3 rejection test run one
            // tier-width stale on every tier-change bar
            mrTol := inMrTol > 0 ? inMrTol : 2 * clustWv
    if needCl
        f_clusters(priorW, priorD, priorA, priorL, priorN, not htfMode, clustWv, clP, clR, clS, clN, clLoT, clHiT, clMemA, clMemN, memKey, memRank, memScope)
        needCl := false
    // ── developing levels — the LIVE read, refreshed every confirmed close ──
    if inRTH
        [p1, v1, w1] = f_devPVV(nP)
        devSPoc := p1
        devSVah := v1
        devSVal := w1
    else if inL
        [p2, v2, w2] = f_devPVV(lP)
        devSPoc := p2
        devSVah := v2
        devSVal := w2
    else if inA
        [p3, v3, w3] = f_devPVV(aP)
        devSPoc := p3
        devSVah := v3
        devSVal := w3
    else
        devSPoc := na
        devSVah := na
        devSVal := na
    [pd1, vd1, wd1] = f_devPVV(dP)
    devDPoc := pd1
    devDVah := vd1
    devDVal := wd1
    // ── up/down volume split (delta standdown gate) ──────────────────────
    // Off the same lower-TF feed the profiles eat: an uptick LTF close books
    // its volume to the buyers, a downtick to the sellers. Approximation of
    // footprint order flow — Pine cannot read true bid/ask.
    float upV = 0.0
    float dnV = 0.0
    int nZ = array.size(ltfC)
    if nZ > 0
        for i = 0 to nZ - 1
            float pc = array.get(ltfC, i)
            if not na(pc)
                if not na(lastLtf)
                    if pc > lastLtf
                        upV += nz(array.get(ltfV, i))
                    else if pc < lastLtf
                        dnV += nz(array.get(ltfV, i))
                lastLtf := pc
    barDelta := upV - dnV
    barVolUD := upV + dnV
    // initiative trackers: consecutive same-direction closes, kept as var
    // series so the gates can read [k] history
    upStrk := close > close[1] ? upStrk + 1 : 0
    dnStrk := close < close[1] ? dnStrk + 1 : 0
    // ── session extremes (pool sesH/sesL) ────────────────────────────────
    bool sessFlip = sessNow != sessPrev
    if sessFlip
        sessPrev := sessNow
        sessHi := high
        sessLo := low
    else
        sessHi := math.max(nz(sessHi, high), high)
        sessLo := math.min(nz(sessLo, low), low)
    // ── LEVEL POOL — one working set: clusters + dynamic singletons ──────
    // Rebuilt every confirmed bar. Pool index == cluster index for the
    // first clP.size() items.
    poolP.clear()
    poolLoT.clear()
    poolHiT.clear()
    poolRank.clear()
    poolName.clear()
    poolMemA.clear()
    poolMemN.clear()
    pmKey.clear()
    pmRank.clear()
    pmScope.clear()
    if not htfMode
        if clP.size() > 0
            for i = 0 to clP.size() - 1
                poolP.push(clP.get(i))
                poolLoT.push(clLoT.get(i))
                poolHiT.push(clHiT.get(i))
                poolRank.push(clR.get(i))
                poolName.push(clN.get(i))
                poolMemA.push(pmKey.size())
                poolMemN.push(clMemN.get(i))
                int a0 = clMemA.get(i)
                if clMemN.get(i) > 0
                    for m = a0 to a0 + clMemN.get(i) - 1
                        pmKey.push(memKey.get(m))
                        pmRank.push(memRank.get(m))
                        pmScope.push(memScope.get(m))
        // dynamic singletons. Step-updating levels (session extremes, ON
        // extremes, developing POC/VA) pool at their [1] snapshots — test
        // the level where the chart DREW it, and never let a bar that
        // itself makes the new extreme count as touching it. Continuous
        // VWAP/σ pool at current confirmed values, matching where plot()
        // draws them.
        if inclVwap
            f_poolAdd(vwapV, "VWAP", 10, 1)
        if inclTwap
            f_poolAdd(twapV, "TWAP", 6, 1)
        if inclSd2
            f_poolAdd(up2, "+2σ", 6, 1)
            f_poolAdd(dn2, "-2σ", 6, 1)
        if inclDay
            f_poolAdd(sessHi[1], "sesH", 8, 1)
            f_poolAdd(sessLo[1], "sesL", 8, 1)
        if inclON
            f_poolAdd(onHi[1], "ONH", 6, 2)
            f_poolAdd(onLo[1], "ONL", 6, 2)
        if ibDone
            f_poolAdd(ibHi, "IBH", 4, 1)
            f_poolAdd(ibLo, "IBL", 4, 1)
        if inclDevMR
            f_poolAdd(devSPoc[1], "sPOC", 6, 1)
            f_poolAdd(devSVah[1], "sVAH", 4, 1)
            f_poolAdd(devSVal[1], "sVAL", 4, 1)
            f_poolAdd(devDPoc[1], "dPOC", 8, 2)
            f_poolAdd(devDVah[1], "dVAH", 6, 2)
            f_poolAdd(devDVal[1], "dVAL", 6, 2)
    // ── PENDING-TOUCH RESOLUTION ─────────────────────────────────────────
    // Runs BEFORE touch detection and BEFORE any score is read this bar:
    // a break completed THIS bar is completed-bar information; this bar's
    // own touch outcome is not. HOLD wins over BREAK on the same bar: a
    // wick through the far edge that closes back with travel is a
    // sweep-and-reclaim — closes are the arbiter everywhere in this script.
    if pdBarA.size() > 0
        for j = pdBarA.size() - 1 to 0
            int age = bar_index - pdBarA.get(j)
            if age >= 1
                int pDir = pdDirA.get(j)
                float nearE = pDir == 1 ? pdLoA.get(j) : pdHiA.get(j)
                float farE = pDir == 1 ? pdHiA.get(j) : pdLoA.get(j)
                bool hold = not na(dAtr) and (pDir == 1 ? close <= nearE - inHoldTravel * dAtr : close >= nearE + inHoldTravel * dAtr)
                pdBeyA.set(j, math.max(pdBeyA.get(j), pDir == 1 ? high - farE : farE - low))
                pdCnsA.set(j, (pDir == 1 ? close > farE : close < farE) ? pdCnsA.get(j) + 1 : 0)
                bool brk = not hold and (pdCnsA.get(j) >= inAcc or (not na(dAtr) and pdBeyA.get(j) >= inBrkTravel * dAtr))
                if hold or brk
                    f_resolveKeys(pdKeysA.get(j), pDir, hold ? 1.0 : 0.0)
                if hold or brk or age >= inReactWin
                    pdDirA.remove(j)
                    pdLoA.remove(j)
                    pdHiA.remove(j)
                    pdBarA.remove(j)
                    pdCnsA.remove(j)
                    pdBeyA.remove(j)
                    pdKeysA.remove(j)
    // ── TOUCH DETECTION — freshness counts NOW, outcome window opens. A
    // signal fired on the touch bar must see this touch in its freshness;
    // the EWMA never moves here.
    if not htfMode and poolP.size() > 0
        for i = 0 to poolP.size() - 1
            float zLoT = poolLoT.get(i)
            float zHiT = poolHiT.get(i)
            bool traded = high >= zLoT - mrTol and low <= zHiT + mrTol
            if traded
                // arrival side from the last confirmed close; opened inside
                // the zone → inherit an overlapping pending's direction
                int tDir = close[1] < zLoT ? 1 : close[1] > zHiT ? -1 : 0
                if tDir == 0 and pdBarA.size() > 0
                    for j = 0 to pdBarA.size() - 1
                        if pdLoA.get(j) <= zHiT and pdHiA.get(j) >= zLoT
                            tDir := pdDirA.get(j)
                if tDir != 0
                    // one interaction = one touch: suppress while an open
                    // pending with the same direction overlaps ≥50% of this
                    // zone (geometric, so it survives cluster rebuilds)
                    bool dup = false
                    if pdBarA.size() > 0
                        for j = 0 to pdBarA.size() - 1
                            if pdDirA.get(j) == tDir
                                float ovl = math.min(pdHiA.get(j), zHiT) - math.max(pdLoA.get(j), zLoT)
                                if ovl >= 0.5 * math.max(zHiT - zLoT, syminfo.mintick)
                                    dup := true
                    if not dup
                        // freshness: every member atom counts THIS touch now
                        string keysCsv = ""
                        int aM = poolMemA.get(i)
                        int nM = poolMemN.get(i)
                        if nM > 0
                            for m = aM to aM + nM - 1
                                f_touchMark(pmKey.get(m), pmScope.get(m))
                                string item = pmKey.get(m) + "," + str.tostring(pmScope.get(m))
                                keysCsv := keysCsv == "" ? item : keysCsv + ";" + item
                        // touch-bar immediate outcomes — SYMMETRIC seeds. A
                        // sweep that already closed back on the approach side
                        // with travel is a HOLD right now. A close through
                        // the far edge already meeting the acceptance count
                        // is a BREAK right now. Everything else opens the
                        // outcome window.
                        int seedCns = (tDir == 1 ? close > zHiT : close < zLoT) ? 1 : 0
                        bool holdNow = not na(dAtr) and (tDir == 1 ? close <= zLoT - inHoldTravel * dAtr : close >= zHiT + inHoldTravel * dAtr)
                        if holdNow
                            f_resolveKeys(keysCsv, tDir, 1.0)
                        else if seedCns >= inAcc
                            f_resolveKeys(keysCsv, tDir, 0.0)
                        else
                            // open the outcome window (cap 12 — oldest out as NEITHER)
                            if pdBarA.size() >= 12
                                pdDirA.remove(0)
                                pdLoA.remove(0)
                                pdHiA.remove(0)
                                pdBarA.remove(0)
                                pdCnsA.remove(0)
                                pdBeyA.remove(0)
                                pdKeysA.remove(0)
                            pdDirA.push(tDir)
                            pdLoA.push(zLoT)
                            pdHiA.push(zHiT)
                            pdBarA.push(bar_index)
                            pdCnsA.push(seedCns)
                            pdBeyA.push(math.max(0.0, tDir == 1 ? high - zHiT : zLoT - low))
                            pdKeysA.push(keysCsv)

// ── SIGNAL ENGINE — the one edge (execution mode · confirmed close only) ───
bool sigMRUp = false
bool sigMRDn = false
int fireDir = 0
string fireLvl = ""
float mrE = na
float mrS = na
float mrT = na
float mrT2 = na
float mrR = na
string mrTgtNm = ""

if barstate.isconfirmed and not htfMode
    // §1 REGIME — ADX(14) on the chart TF, confirmed bar only
    int mrRegime = adxV < adxGreen ? 2 : adxV < adxAmber ? 1 : 0
    // §2 STRETCH — σ-distance from session VWAP OR range-multiple fallback
    float sigmaDist = not na(vwapV) and not na(sd) and sd > 0 ? (close - vwapV) / sd : na
    float absSigma = na(sigmaDist) ? float(na) : math.abs(sigmaDist)
    bool rangeStretch = not na(vwapV) and atr14 > 0 and math.abs(close - vwapV) >= stretchRangeMult * atr14
    bool stretchOK = (not na(absSigma) and absSigma >= stretchSigmaMin) or rangeStretch
    // direction: below VWAP = long candidate, above = short
    int candDir = na(vwapV) ? 0 : close < vwapV ? 1 : close > vwapV ? -1 : 0
    bool extremeOK = not na(absSigma) and absSigma >= EXT_SIGMA
    bool regimePass = mrRegime == 2 or (mrRegime == 1 and extremeOK)
    float needScore = f_tierTrd() + (mrRegime == 1 ? EXT_BUMP : 0.0)
    // §3 TRIGGER — RSI(7), strict thresholds in EXTREME-ONLY, 2-bar window
    float thrLong = mrRegime == 1 ? rsiLongStrict : rsiLong
    float thrShort = mrRegime == 1 ? rsiShortStrict : rsiShort
    bool rsiTrig = candDir == 1 ? (rsiV <= thrLong or rsiV[1] <= thrLong) : candDir == -1 ? (rsiV >= thrShort or rsiV[1] >= thrShort) : false
    // HUD gate tokens — confirmed-bar snapshots, display only
    adxDisp := adxV
    regDisp := mrRegime
    sigmaDisp := sigmaDist
    rsiDisp := rsiV
    stretchDispOK := stretchOK
    rsiDispOK := rsiTrig
    lvlDispOK := false
    if poolP.size() > 0 and candDir != 0
        for i = 0 to poolP.size() - 1
            if high >= poolLoT.get(i) - mrTol and low <= poolHiT.get(i) + mrTol and f_poolScore(i, -candDir) >= needScore
                lvlDispOK := true
    // signal validity: after validBars the emitted prices are stale
    if sigDir != 0 and bar_index - nz(sigBorn, -99999) >= inValidBars
        sigDir := 0
    // §4 LEVEL + §5 CONFIRMATION + §6 TICKET
    bool gate = (not inRthOnly or inRTH) and (not inSessOnly or inAnySess) and (not inHardCap or sigCnt < inMaxSig) and bar_index - lastSigBar >= inCd
    if enMR and gate and regimePass and stretchOK and rsiTrig and candDir != 0 and poolP.size() > 0 and not na(dAtr)
        // the stretch must land ON structure: rejection at the
        // highest-scoring touched pool level (±2σ bands are pool levels, so
        // a 2σ tag counts). VWAP stretch alone is never enough.
        float bScore = 0.0
        int bIdx = -1
        for i = 0 to poolP.size() - 1
            int d = f_mrTest3(i)
            if d == candDir
                float eff = f_poolScore(i, -d)
                if eff >= needScore and eff > bScore
                    bScore := eff
                    bIdx := i
        if bIdx >= 0
            // initiative standdown — don't step in front of a train:
            // approach velocity and consecutive closes INTO the level
            float vel = math.abs(close - close[inApprBars]) / inApprBars
            bool velOK = vel <= inVMax * dAtr
            // streak as of the bar BEFORE the trigger — the rejection bar
            // itself usually closes against the approach and would zero the
            // very streak this gate exists to measure
            bool strkOK = (candDir == 1 ? dnStrk[1] : upStrk[1]) <= inCMax
            // delta standdown — one-sided initiative flow into the level
            // with the approach = absorption absent. Filter, not trigger.
            bool deltaOK = true
            if useLtfDelta
                float dSum = 0.0
                float vSum = 0.0
                for k = 1 to inApprBars
                    dSum += barDelta[k]
                    vSum += barVolUD[k]
                float ndl = vSum > 0 ? dSum / vSum : 0.0
                deltaOK := (candDir == 1 ? -ndl : ndl) < inDMax
            if velOK and strkOK and deltaOK
                [ce, cs, ct, ct2, cr, roomOk, tnm] = f_construct3(bIdx, candDir, dAtr, candDir == 1 ? loW : hiW, vwapV)
                if roomOk
                    fireDir := candDir
                    fireLvl := poolName.get(bIdx) + " " + str.tostring(math.round(bScore, 1)) + "★ @ " + str.tostring(poolP.get(bIdx), format.mintick)
                    mrE := ce
                    mrS := cs
                    mrT := ct
                    mrT2 := ct2
                    mrR := cr
                    mrTgtNm := tnm
                else
                    evNoTrade := true
                    evNoTradeTxt := "EVT=NOTRADE|reason=" + (na(ct) ? "vwapcap" : "room") + "|side=" + (candDir == 1 ? "long" : "short") + "|level=" + poolName.get(bIdx) + "|score=" + str.tostring(math.round(bScore))
    // fire: count, ONE signal label, ticket, alert, plan lines
    if fireDir != 0
        sigCnt += 1
        lastSigBar := bar_index
        sigMRUp := fireDir == 1
        sigMRDn := fireDir == -1
        sigDir := fireDir
        sigE := mrE
        sigS := mrS
        sigT := mrT
        sigT2 := mrT2
        sigR := mrR
        sigBorn := bar_index
        sigLvlTxt := fireLvl
        sigTgtNm := mrTgtNm
        // one line, pipe-delimited, keyed straight into limit tickets
        string stretchTxt = na(absSigma) ? "—" : str.tostring(absSigma, "#.#") + "σ"
        alert("SKULD|" + (fireDir == 1 ? "BUY MR" : "SELL MR") + "|" + syminfo.ticker + "|E:" + str.tostring(mrE, format.mintick) + "|S:" + str.tostring(mrS, format.mintick) + "|T1:" + str.tostring(mrT, format.mintick) + "|T2:" + (na(mrT2) ? "—" : str.tostring(mrT2, format.mintick)) + "|R:" + str.tostring(mrR, "#.##") + "|ADX:" + str.tostring(adxV, "#.#") + "|STRETCH:" + stretchTxt + "|LVL:" + fireLvl + "|" + str.format_time(time, "yyyy-MM-dd HH:mm", TZ), alert.freq_once_per_bar_close)
        label.new(time, fireDir == 1 ? low : high, fireDir == 1 ? "MR ▲" : "MR ▼", xloc = xloc.bar_time, style = fireDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(fireDir == 1 ? colUp : colDn, 0), textcolor = fireDir == 1 ? color.black : color.white, size = sigSz, tooltip = fireLvl + " → T1 " + mrTgtNm)
        if showPlan
            if not na(planE)
                line.delete(planE)
            if not na(planS)
                line.delete(planS)
            if not na(planT)
                line.delete(planT)
            if not na(planRes)
                label.delete(planRes)
            planE := line.new(time, mrE, time, mrE, xloc = xloc.bar_time, color = colText, width = 2)
            planS := line.new(time, mrS, time, mrS, xloc = xloc.bar_time, color = colStop, style = line.style_dashed)
            planT := line.new(time, mrT, time, mrT, xloc = xloc.bar_time, color = colUp, style = line.style_dotted)
            planDir := fireDir
            planSp := mrS
            planTp := mrT
            planEp := mrE
            planFilled := false
            planOn := true
    // manage the live plan: the ticket is a RESTING LIMIT — track it like
    // one. Fill first (price returns to E), then SL/TP. Price tags T1
    // without ever filling = the move left without you: kill ticket AND HUD
    // signal instantly with a dim RAN stamp. No fill = no win/loss.
    if planOn and fireDir == 0
        line.set_x2(planE, time)
        line.set_x2(planS, time)
        line.set_x2(planT, time)
        bool fillHit = planDir > 0 ? low <= planEp : high >= planEp
        bool slHit = planDir > 0 ? low <= planSp : high >= planSp
        bool tpHit = planDir > 0 ? high >= planTp : low <= planTp
        if not planFilled and not fillHit and tpHit
            // ran to target unfilled — money train left the station
            planOn := false
            sigDir := 0
            if not na(planRes)
                label.delete(planRes)
            planRes := label.new(time, planTp, "RAN — unfilled", xloc = xloc.bar_time, style = planDir > 0 ? label.style_label_down : label.style_label_up, color = color.new(#0d0d10, 40), textcolor = #787b86, size = size.small, tooltip = "Price hit T1 before ever returning to the entry limit. No trade — signal cleared.")
        else
            if fillHit
                planFilled := true
            if planFilled and (slHit or tpHit)
                planOn := false
                sigDir := 0
                if not na(planRes)
                    label.delete(planRes)
                bool win = tpHit and not slHit
                // stamp the TICKET'S OWN distances — the outcome label must
                // match the lines it sat between
                int tpTk = int(math.round(math.abs(planTp - nz(planEp, planTp)) / syminfo.mintick))
                int slTk = int(math.round(math.abs(nz(planEp, planSp) - planSp) / syminfo.mintick))
                string resTxt = slHit and tpHit ? "TP+SL same bar — check" : win ? "TP ✓ +" + str.tostring(tpTk) + "t" : "SL ✗ -" + str.tostring(slTk) + "t"
                planRes := label.new(time, win ? planTp : planSp, resTxt, xloc = xloc.bar_time, style = win ? label.style_label_up : label.style_label_down, color = color.new(win ? colUp : colStop, 20), textcolor = win ? color.black : color.white, size = size.small)
            else if not inAnySess
                planOn := false
                sigDir := 0

// ── PLOTS ── 8 plot() + 2 alertcondition() = 10 output calls (×2 = 20) ─────
plot(showVwap and not htfMode ? vwapV : na, "VWAP", color = colVwap, linewidth = 2, style = plot.style_linebr)
plot(inclTwap and not htfMode ? twapV : na, "TWAP", color = color.new(colVwap, 45), style = plot.style_linebr)
plot(showVwap and not htfMode ? up1 : na, "+1σ", color = color.new(colBand, 40), style = plot.style_linebr)
plot(showVwap and not htfMode ? dn1 : na, "-1σ", color = color.new(colBand, 40), style = plot.style_linebr)
plot(showVwap and showSd2 and not htfMode ? up2 : na, "+2σ", color = color.new(colBand, 15), style = plot.style_linebr)
plot(showVwap and showSd2 and not htfMode ? dn2 : na, "-2σ", color = color.new(colBand, 15), style = plot.style_linebr)
plot(showVwap and showSd3 and not htfMode ? up3 : na, "+3σ", color = color.new(colBand, 55), style = plot.style_linebr)
plot(showVwap and showSd3 and not htfMode ? dn3 : na, "-3σ", color = color.new(colBand, 55), style = plot.style_linebr)

// ── RENDER · DEVELOPING POC LINES (last bar) ───────────────────────────────
var array<line> devLn = array.new<line>()
var array<label> devLb = array.new<label>()
f_devDraw(float px, string nm, int rank, int t0, color cc, int wd) =>
    if not na(px)
        int x1 = na(t0) ? time - 30 * barMs : t0
        devLn.push(line.new(x1, px, time + inOff * barMs, px, xloc = xloc.bar_time, color = cc, style = line.style_dotted, width = wd))
        string txt = f_scoreTxt(rank) + " " + nm + (showPx ? "  " + str.tostring(px, format.mintick) : "") + " · " + str.tostring(math.abs(close - px), format.mintick)
        devLb.push(label.new(time + inOff * barMs, px, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))
    true

if barstate.islast
    if devLn.size() > 0
        for l in devLn
            line.delete(l)
    devLn.clear()
    if devLb.size() > 0
        for lb in devLb
            label.delete(lb)
    devLb.clear()
    if not htfMode
        int sessT0 = inRTH ? nT0 : inL ? lT0 : inA ? aT0 : na
        if showDevS
            f_devDraw(devSPoc, "sPOC", 6, sessT0, colDevPoc, 2)
        if showDevD
            f_devDraw(devDPoc, "dPOC", 8, dT0, colDevPoc, 2)

// ── RENDER · LEVEL MAP (last bar) ──────────────────────────────────────────
var array<line> clLn = array.new<line>()
var array<label> clLb = array.new<label>()
if barstate.islast
    if clLn.size() > 0
        for l in clLn
            line.delete(l)
    clLn.clear()
    if clLb.size() > 0
        for lb in clLb
            label.delete(lb)
    clLb.clear()
    if showLvls and htfMode and clP.size() > 0
        // STRUCTURE mode: the full ranked map
        array<float> dst = array.new<float>()
        for i = 0 to clP.size() - 1
            dst.push(math.abs(close - clP.get(i)))
        array<int> ord = array.sort_indices(dst)
        int shown = 0
        for r = 0 to ord.size() - 1
            int i = ord.get(r)
            float d = dst.get(i)
            if (inHide == 0 or d <= inHide) and shown < inMaxL
                shown += 1
                int stx = f_stars(clR.get(i))
                color cc = f_starCol(stx)
                int wd = clS.get(i) == 3 ? inWidW : clS.get(i) == 2 ? inWidD : inWidS
                float y = clP.get(i)
                clLn.push(line.new(time - 30 * barMs, y, time + inOff * barMs, y, xloc = xloc.bar_time, color = cc, style = prSty, width = wd))
                string txt = f_scoreTxt(clR.get(i)) + " " + clN.get(i) + (showPx ? "  " + str.tostring(y, format.mintick) : "") + " · " + str.tostring(d, format.mintick)
                clLb.push(label.new(time + inOff * barMs, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))
    if showLvls and not htfMode and poolP.size() > 0
        // EXECUTION mode: ONLY the levels in play — the nearest K qualifying
        // items above and K below price, where qualifying = EffScore for the
        // side price would arrive from ≥ the regime's display floor. Spent
        // levels decay off this chart by design.
        array<float> exDst = array.new<float>()
        array<int> exIdx = array.new<int>()
        array<int> exDir = array.new<int>()
        array<float> exEff = array.new<float>()
        for i = 0 to poolP.size() - 1
            float y0 = poolP.get(i)
            int dirA = y0 > close ? 1 : -1        // above price → arrives fromBelow
            float eff0 = f_poolScore(i, dirA)
            if eff0 >= f_tierDisp()
                exDst.push(math.abs(y0 - close))
                exIdx.push(i)
                exDir.push(dirA)
                exEff.push(eff0)
        if exIdx.size() > 0
            array<int> exOrd = array.sort_indices(exDst)
            int nUp = 0
            int nDn = 0
            for r = 0 to exOrd.size() - 1
                int k0 = exOrd.get(r)
                int i = exIdx.get(k0)
                int dirA = exDir.get(k0)
                bool room = dirA == 1 ? nUp < inShowK : nDn < inShowK
                if room
                    if dirA == 1
                        nUp += 1
                    else
                        nDn += 1
                    float y = poolP.get(i)
                    float eff = exEff.get(k0)
                    color cc = f_starCol(f_stars(eff))
                    // width from the strongest member's scope
                    int mScMax = 1
                    int aR = poolMemA.get(i)
                    if poolMemN.get(i) > 0
                        for m = aR to aR + poolMemN.get(i) - 1
                            mScMax := math.max(mScMax, pmScope.get(m))
                    int wd = mScMax == 3 ? inWidW : mScMax == 2 ? inWidD : inWidS
                    clLn.push(line.new(time - 30 * barMs, y, time + inOff * barMs, y, xloc = xloc.bar_time, color = cc, style = prSty, width = wd))
                    // record = the strongest member's H/B history for the
                    // approach direction
                    string recKey = ""
                    float recRank = -1.0
                    int recScope = 1
                    if poolMemN.get(i) > 0
                        for m = aR to aR + poolMemN.get(i) - 1
                            if pmRank.get(m) > recRank
                                recRank := pmRank.get(m)
                                recKey := pmKey.get(m)
                                recScope := pmScope.get(m)
                    string txt = poolName.get(i) + (showPx ? " " + str.tostring(y, format.mintick) : "") + " · " + str.tostring(math.round(math.abs(y - close) / syminfo.mintick)) + "t · " + str.tostring(math.round(eff, 1)) + "★ · " + f_recordTxt(recKey, dirA, recScope)
                    clLb.push(label.new(time + inOff * barMs, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))

// ── DEBUG HUD (4 rows: REGIME · ADX · STRETCH · GATES) ─────────────────────
f_dashPos() =>
    inDashPos == "Top left" ? position.top_left : inDashPos == "Bottom right" ? position.bottom_right : inDashPos == "Bottom left" ? position.bottom_left : position.top_right

var table dash = showDash and showDebugHud ? table.new(f_dashPos(), 2, 4, bgcolor = color.new(#0d0d10, 8), border_width = 1, border_color = color.new(#673ab7, 55)) : table(na)
if showDash and showDebugHud and barstate.islast
    color okC   = #00ff00
    color offC  = #787b86
    color warnC = #ffb300
    color badC  = #ef5350
    color infC  = #00bcd4
    string rgTxt = f_tierName() + (na(atrPct) ? "" : " · " + str.tostring(math.round(atrPct)) + "pct") + (na(dAtr) ? "" : " · dATR " + str.tostring(dAtr, format.mintick)) + (useVix and not na(vixD) ? " · VIX " + str.tostring(vixD, "#.#") : "")
    f_row(dash, 0, "REGIME", rgTxt, tier >= 3 ? badC : tier == 2 ? warnC : tier == 0 ? infC : okC)
    string adxTxt = (na(adxDisp) ? "—" : str.tostring(adxDisp, "#.#")) + " · " + (regDisp == 2 ? "FULL MR" : regDisp == 1 ? "EXTREME-ONLY" : regDisp == 0 ? "NO MR" : "—")
    f_row(dash, 1, "ADX", adxTxt, regDisp == 2 ? okC : regDisp == 1 ? warnC : regDisp == 0 ? badC : offC)
    float vAbs = not na(vwapV) ? math.abs(close - vwapV) : na
    string strTxt = (na(sigmaDisp) ? "—" : str.tostring(sigmaDisp, "#.##") + "σ") + (na(vAbs) or na(atr14) or atr14 <= 0 ? "" : " · " + str.tostring(vAbs / atr14, "#.##") + "×A14")
    f_row(dash, 2, "STRETCH", strTxt, stretchDispOK ? okC : offC)
    int cdLeft = math.max(0, inCd - (bar_index - lastSigBar))
    string gTxt = sessNow + " · cd " + str.tostring(cdLeft) + " · " + str.tostring(sigCnt) + "/" + str.tostring(inMaxSig) + " · rsi " + (na(rsiDisp) ? "—" : str.tostring(math.round(rsiDisp))) + " · lvl " + (lvlDispOK ? "✓" : "–")
    f_row(dash, 3, "GATES", gTxt, inAnySess ? infC : offC)

// ── HUD (deck spec) — trade-entry information ONLY ─────────────────────────
// Header row: SKULD · SYMBOL TF | state. WAITING: nearest qualifying level
// each side + ROOM row + GATES row (the edge's four conditions, colored).
// SIGNAL: boxed side block, E/S/T1/R grid, FROM row, T2 row when the target
// stood off an intermediate level, RISK row, VALID clock. Table is deleted +
// rebuilt on the last bar so stale cells never leak between states.
f_shortNm(string nm) =>
    str.length(nm) > 16 ? str.substring(nm, 0, 15) + "…" : nm
f_tfTxt() =>
    timeframe.isseconds ? timeframe.period + "s" : timeframe.isminutes ? timeframe.period + "m" : timeframe.period
var table hud = table(na)
if showDash and not showDebugHud and barstate.islast
    if not na(hud)
        table.delete(hud)
    hud := table.new(f_dashPos(), 4, 8, bgcolor = color.new(#0d0d10, 6), frame_width = 1, frame_color = color.new(#673ab7, 45))
    color hOk = #00ff00
    color hBad = #ef5350
    color hDim = #787b86
    color hAmb = #ffb300
    color hCyn = #00bcd4
    color hGold = #ffd54f
    color hCard = color.new(#0d0d10, 6)
    // header: identity left, state right
    string headL = "SKULD · " + syminfo.ticker + " " + f_tfTxt()
    string hState = htfMode ? "STRUCTURE" : sigDir != 0 ? "SIGNAL" : "WAITING"
    color hStCol = htfMode ? colDn : sigDir != 0 ? (sigDir == 1 ? hOk : colDn) : hAmb
    table.cell(hud, 0, 0, headL, text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
    table.merge_cells(hud, 0, 0, 2, 0)
    table.cell(hud, 3, 0, hState, text_color = hStCol, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
    if not htfMode and sigDir != 0
        // ── SIGNAL ──
        int leftBars = math.max(0, inValidBars - (bar_index - sigBorn))
        int vSecs = leftBars * tfSec
        string vTxt = str.tostring(math.floor(vSecs / 60)) + ":" + (vSecs % 60 < 10 ? "0" : "") + str.tostring(vSecs % 60)
        color sc = sigDir == 1 ? hOk : colDn
        table.cell(hud, 0, 1, (sigDir == 1 ? "BUY" : "SELL") + " MR", text_color = sigDir == 1 ? color.black : color.white, text_size = size.huge, bgcolor = color.new(sc, 20))
        table.merge_cells(hud, 0, 1, 3, 1)
        table.cell(hud, 0, 2, "E", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 2, str.tostring(sigE, format.mintick), text_color = #ffffff, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 2, "S", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 3, 2, str.tostring(sigS, format.mintick), text_color = hBad, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 3, "T1", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 3, str.tostring(sigT, format.mintick), text_color = hOk, text_size = size.large, text_halign = text.align_right, bgcolor = hCard, tooltip = "T1 at " + sigTgtNm)
        table.cell(hud, 2, 3, "R", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 3, 3, str.tostring(sigR, "#.#"), text_color = hCyn, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        // FROM — the level that produced this signal
        string fromTxt = sigLvlTxt
        if str.length(fromTxt) > 42
            fromTxt := str.substring(fromTxt, 0, 41) + "…"
        table.cell(hud, 0, 4, "FROM " + fromTxt, text_color = hGold, text_size = size.small, text_halign = text.align_left, bgcolor = hCard, tooltip = sigLvlTxt)
        table.merge_cells(hud, 0, 4, 3, 4)
        // T2 — VWAP, when T1 stood off an intermediate working level
        if not na(sigT2)
            table.cell(hud, 0, 5, "T2 VWAP " + str.tostring(sigT2, format.mintick), text_color = hCyn, text_size = size.small, text_halign = text.align_left, bgcolor = hCard, tooltip = "T1 stands off " + sigTgtNm + " — VWAP is the runner target.")
            table.merge_cells(hud, 0, 5, 3, 5)
        // RISK — advisory sizing only
        float riskDlr = acctSize * riskPct / 100.0
        int stopTk = na(sigE) or na(sigS) ? 0 : int(math.round(math.abs(sigE - sigS) / syminfo.mintick))
        string riskTxt = "—"
        if stopTk > 0
            float perCt = stopTk * syminfo.mintick * syminfo.pointvalue
            if syminfo.pointvalue != 1.0 and perCt > 0
                int nCt = int(math.floor(riskDlr / perCt))
                riskTxt := str.tostring(riskPct, "#.##") + "% = $" + str.tostring(riskDlr, "#") + " → " + str.tostring(nCt) + " ct · stop " + str.tostring(stopTk) + "t"
            else
                riskTxt := str.tostring(riskPct, "#.##") + "% = $" + str.tostring(riskDlr, "#") + " · stop " + str.tostring(stopTk) + "t"
        table.cell(hud, 0, 6, "RISK", text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 6, riskTxt, text_color = hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard, tooltip = "Advisory only — floor(risk$ ÷ (stop ticks × tick value)). CFD/forex (pointvalue 1): ticks only.")
        table.merge_cells(hud, 1, 6, 3, 6)
        table.cell(hud, 0, 7, "VALID", text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 7, vTxt, text_color = leftBars <= 2 ? hAmb : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.merge_cells(hud, 1, 7, 3, 7)
    else if not htfMode
        // ── WAITING ── nearest qualifying level each side
        int upIdx = -1
        int dnIdx = -1
        float upD = 1.0e18
        float dnD = 1.0e18
        float upEff = 0.0
        float dnEff = 0.0
        if poolP.size() > 0
            for i = 0 to poolP.size() - 1
                float y = poolP.get(i)
                if y > close
                    float e1 = f_poolScore(i, 1)
                    if e1 >= f_tierDisp() and y - close < upD
                        upD := y - close
                        upIdx := i
                        upEff := e1
                else
                    float e2 = f_poolScore(i, -1)
                    if e2 >= f_tierDisp() and close - y < dnD
                        dnD := close - y
                        dnIdx := i
                        dnEff := e2
        // ROOM: would the ticket pass right now — long at the ▼ level,
        // short at ▲ — and how many ticks of travel it would get.
        bool roomL = false
        bool roomS = false
        int roomLt = -1
        int roomSt = -1
        if not na(dAtr)
            if dnIdx >= 0
                [rlE, rlS, rlT, rlT2, rlR, rlOk, rlNm] = f_construct3(dnIdx, 1, dAtr, loW, vwapV)
                roomL := rlOk
                roomLt := na(rlT) ? -1 : int(math.round((rlT - rlE) / syminfo.mintick))
            if upIdx >= 0
                [rsE, rsS, rsT, rsT2, rsR, rsOk, rsNm] = f_construct3(upIdx, -1, dAtr, hiW, vwapV)
                roomS := rsOk
                roomSt := na(rsT) ? -1 : int(math.round((rsE - rsT) / syminfo.mintick))
        // ▲ = short zone (purple) · ▼ = long zone (green), deck columns:
        // side+name · price · ±dist · score
        table.cell(hud, 0, 1, upIdx < 0 ? "▲ —" : "▲ " + f_shortNm(poolName.get(upIdx)), text_color = upIdx < 0 ? hDim : colDn, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard, tooltip = upIdx < 0 ? "" : poolName.get(upIdx))
        table.cell(hud, 1, 1, upIdx < 0 ? "" : str.tostring(poolP.get(upIdx), format.mintick), text_color = colDn, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 1, upIdx < 0 ? "" : "+" + str.tostring(math.round(upD / syminfo.mintick)) + "t", text_color = hDim, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 1, upIdx < 0 ? "" : str.tostring(math.round(upEff, 1)) + "★", text_color = hGold, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 2, dnIdx < 0 ? "▼ —" : "▼ " + f_shortNm(poolName.get(dnIdx)), text_color = dnIdx < 0 ? hDim : hOk, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard, tooltip = dnIdx < 0 ? "" : poolName.get(dnIdx))
        table.cell(hud, 1, 2, dnIdx < 0 ? "" : str.tostring(poolP.get(dnIdx), format.mintick), text_color = hOk, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 2, dnIdx < 0 ? "" : "-" + str.tostring(math.round(dnD / syminfo.mintick)) + "t", text_color = hDim, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 2, dnIdx < 0 ? "" : str.tostring(math.round(dnEff, 1)) + "★", text_color = hGold, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 3, "ROOM", text_color = hCyn, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 3, dnIdx < 0 ? "L —" : "L " + (roomL ? "OK·" : "✗·") + (roomLt < 0 ? "no tgt" : str.tostring(roomLt) + "t"), text_color = dnIdx < 0 ? hDim : roomL ? hOk : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 3, upIdx < 0 ? "S —" : "S " + (roomS ? "OK·" : "✗·") + (roomSt < 0 ? "no tgt" : str.tostring(roomSt) + "t"), text_color = upIdx < 0 ? hDim : roomS ? hOk : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 3, "", text_color = hDim, text_size = size.small, bgcolor = hCard)
        // GATES — the edge's four conditions, so the missing one is obvious
        string g1 = "ADX " + (na(adxDisp) ? "—" : str.tostring(math.round(adxDisp))) + " " + (regDisp == 2 ? "FULL" : regDisp == 1 ? "EXTR" : regDisp == 0 ? "NO MR" : "—")
        color g1c = regDisp == 2 ? hOk : regDisp == 1 ? hAmb : regDisp == 0 ? hBad : hDim
        string g2 = "STR " + (na(sigmaDisp) ? "—" : str.tostring(sigmaDisp, "#.#") + "σ")
        color g2c = stretchDispOK ? hOk : hDim
        string g3 = "RSI " + (na(rsiDisp) ? "—" : str.tostring(math.round(rsiDisp)))
        color g3c = rsiDispOK ? hOk : hDim
        string g4 = "LVL " + (lvlDispOK ? "✓" : "–")
        color g4c = lvlDispOK ? hOk : hDim
        table.cell(hud, 0, 4, g1, text_color = g1c, text_size = size.tiny, text_halign = text.align_left, bgcolor = hCard, tooltip = "Regime: ADX < " + str.tostring(adxGreen, "#") + " FULL · < " + str.tostring(adxAmber, "#") + " EXTREME-ONLY · else NO MR")
        table.cell(hud, 1, 4, g2, text_color = g2c, text_size = size.tiny, text_halign = text.align_right, bgcolor = hCard, tooltip = "Stretch: ≥ " + str.tostring(stretchSigmaMin, "#.#") + "σ from VWAP or ≥ " + str.tostring(stretchRangeMult, "#.##") + "×ATR14")
        table.cell(hud, 2, 4, g3, text_color = g3c, text_size = size.tiny, text_halign = text.align_right, bgcolor = hCard, tooltip = "RSI(" + str.tostring(rsiLen) + ") trigger for the stretch side, 2-bar window")
        table.cell(hud, 3, 4, g4, text_color = g4c, text_size = size.tiny, text_halign = text.align_right, bgcolor = hCard, tooltip = "Price at a pool level whose EffScore ≥ the regime trade floor")
        // SESSION PERSPECTIVE (3.1) — where in the day, how big the move so
        // far. dATR (prior-day ATR14, already the regime driver) stands in
        // as the average-day-range yardstick — no new state needed.
        string sessTxt = "OFF-SESSION"
        color sessTxtC = hDim
        if inAnySess
            int elapsedMin = na(sessStartT) ? 0 : int((time - sessStartT) / 60000)
            float rngPct = (not na(dAtr) and dAtr > 0 and not na(sessHi) and not na(sessLo)) ? (sessHi - sessLo) / dAtr * 100 : na
            sessTxt := sessNow + " " + str.tostring(elapsedMin) + "m" + (na(rngPct) ? "" : " · rng " + str.tostring(math.round(rngPct)) + "% ADR")
            sessTxtC := na(rngPct) ? hDim : rngPct >= 100 ? hAmb : hDim
        table.cell(hud, 0, 5, sessTxt, text_color = sessTxtC, text_size = size.tiny, text_halign = text.align_left, bgcolor = hCard, tooltip = "Time elapsed in the active session + today's range so far vs the prior day's ATR(14) — perspective on how big today's move is, not a gate.")
        table.merge_cells(hud, 0, 5, 3, 5)
    else
        // ── STRUCTURE ──
        table.cell(hud, 0, 1, "map only — no signals", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.merge_cells(hud, 0, 1, 3, 1)
        table.cell(hud, 0, 2, f_tierName() + (na(atrPct) ? "" : " · ATR " + str.tostring(math.round(atrPct)) + "pct"), text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.merge_cells(hud, 0, 2, 3, 2)

// ── LEDGER FEED — NOTRADE only since 3.0, opt-in ───────────────────────────
if barstate.isconfirmed and feedNoTrade and evNoTrade
    alert(evNoTradeTxt, alert.freq_once_per_bar_close)

// ── ALERTS — TWO alertconditions. The dynamic payload (E/S/T1/T2/R/ADX/
// STRETCH/LVL/time) rides the alert() call fired at signal time; arm ONE
// alert with "Any alert() function call" to receive it.
alertcondition(sigMRUp, "SKULD BUY MR", "SKULD BUY MR — pipe-delimited E/S/T1/T2/R in the alert() message")
alertcondition(sigMRDn, "SKULD SELL MR", "SKULD SELL MR — pipe-delimited E/S/T1/T2/R in the alert() message")
