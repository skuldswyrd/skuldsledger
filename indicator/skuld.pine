int inWidD = input.int(2, "Line width · daily-scope cluster", minval = 1, maxval = 5, group = GC)
int inWidS = input.int(1, "Line width · session-scope cluster", minval = 1, maxval = 5, group = GC)

// ── DERIVED ────────────────────────────────────────────────────────────────
int   tfSec   = timeframe.in_seconds(timeframe.period)
int   barMs   = tfSec * 1000
bool  htfMode = tfSec >= timeframe.in_seconds(inModeTf)
int   tgtT    = inTgtT > 0 ? inTgtT : isES ? 8 : 32
int   stopT   = inStopT > 0 ? inStopT : isES ? 12 : 48
float tgtPts  = tgtT * syminfo.mintick
float stopPts = stopT * syminfo.mintick
float fineBin = inBin > 0 ? inBin : isES ? 0.25 : 1.0
// Cluster width is REGIME-DRIVEN since 2.6: tier × dATR, recomputed only at
// session boundaries or on tier change (identity churn is the enemy). The
// var updates inside the confirmed block; until the first update (or with a
// manual override) the old 25%-of-target seed stands in. Derived tolerances
// read the var — one bar of lag at a width change, by design.
float clustWSeed = 0.25 * tgtPts
var float clustW = na
float clustWv = inClW > 0 ? inClW : nz(clustW, clustWSeed)
float mrTol   = inMrTol > 0 ? inMrTol : 2 * clustWv
float brtEsc  = inBrtEsc > 0 ? inBrtEsc : clustWv
string ltfStr = inLtf != "" ? inLtf : tfSec >= 3600 ? "5" : tfSec >= 60 ? "1" : "1S"
string prSty  = inSty == "Dashed" ? line.style_dashed : inSty == "Dotted" ? line.style_dotted : line.style_solid
string sigSz  = inSigSize == "Large" ? size.large : inSigSize == "Small" ? size.small : size.normal

float atr14 = ta.atr(14)

// global series used inside functions — must exist before function defs
float cPrev  = close[1]
float cPrev2 = close[2]
float loW    = math.min(low, low[1])
float hiW    = math.max(high, high[1])
float barRng = high - low
float cPos   = barRng > 0 ? (close - low) / barRng : 0.5
float volSma = ta.sma(volume, 20)
float relVol = volSma > 0 ? nz(volume) / volSma : 1.0
float appHiN = ta.highest(high, inAppNoTouch)
float appLoN = ta.lowest(low, inAppNoTouch)

// sessions
bool inRTH   = not na(time(timeframe.period, rthSess, TZ))
bool inON    = not na(time(timeframe.period, onSess, TZ))
bool inA     = not na(time(timeframe.period, sAsia, TZ))
bool inL     = not na(time(timeframe.period, sLdn, TZ))
bool inLunch = not na(time(timeframe.period, lunchSess, TZ))
bool inPrime = not na(time(timeframe.period, primeSess, TZ))
bool inCold  = not na(time(timeframe.period, coldSess, TZ))
bool newRTH  = inRTH and not inRTH[1]
// one session string for the engines AND the dashboard
string sessNow = inRTH ? "NY" : inL ? "LDN" : inA ? "ASIA" : "OFF"
// all-sessions machinery: every session is first-class (v2.5)
bool inAnySess = inRTH or inL or inA
bool newSess = inAnySess and sessNow != sessNow[1]
var int sessStartT = na
if newSess
    sessStartT := time
// the trading day begins at the Asia open (18:00 ET)
bool newTradeDay = newSess and sessNow == "ASIA"
// per-session initial balance window: first N minutes of the ACTIVE session
bool inIBw = inAnySess and not na(sessStartT) and time - sessStartT < inIbMin * 60 * 1000

// ── TYPES & FUNCTIONS ──────────────────────────────────────────────────────
type Prof
    array<float> vol
    int   base
    float lo
    float hi

type Lvl
    float  price
    string name
    int    rank
    int    scope   // 1 session · 2 day · 3 week

// ── EFFECTIVE SCORE types ──────────────────────────────────────────────────
// Per-level reaction memory lives in maps keyed by STABLE IDENTITY, so a
// migrating developing level (or tomorrow's pdPOC at a new price) carries
// its behavioral history. Key scheme (built ONLY by f_dirKey/base names —
// never inline, key drift orphans stats):
//   named levels : the name verbatim ("pdPOC", "NY H", "VWAP", "sPOC", …)
//   HVN/LVN      : name + "_" + round(price / clusterWidth)  (price bucket)
//   direction    : "|B" fromBelow · "|A" fromAbove appended for DirStat
// DirStat (per key+direction): EWMA hold rate + the H/B record.
// FreshStat (per key, direction-agnostic): touches today for freshness
// decay, epoch-tagged so scope resets are O(1) (session-scope stats reset
// at session change, day-scope at the trade-day roll, week-scope weekly).
type DirStat
    float ewma  = na   // na = untested → reactionMult exactly 1.0
    int   holdN = 0
    int   brkN  = 0
    int   epoch = -1   // scope epoch — stale = the level's period rolled,
                       // stats read as untested and reset on next write

type FreshStat
    int tchToday = 0
    int epoch    = -1
    int lastBar  = -1  // bar of the newest touch — its own evaluation bar
                       // reads freshness WITHOUT it (touch N grades on N−1
                       // prior touches, per the spec's decay arithmetic)

f_newProf() =>
    Prof.new(array.new<float>(), 0, na, na)

f_add(Prof p, float pr, float v) =>
    float vv = nz(v)
    int k = int(math.floor(pr / fineBin))
    if array.size(p.vol) == 0
        p.base := k
        array.push(p.vol, vv)
    else
        while k < p.base
            array.unshift(p.vol, 0.0)
            p.base := p.base - 1
        while k > p.base + array.size(p.vol) - 1
            array.push(p.vol, 0.0)
        array.set(p.vol, k - p.base, array.get(p.vol, k - p.base) + vv)
    p.hi := na(p.hi) ? pr : math.max(p.hi, pr)
    p.lo := na(p.lo) ? pr : math.min(p.lo, pr)

f_stretch(Prof p, float h, float l) =>
    p.hi := na(p.hi) ? h : math.max(p.hi, h)
    p.lo := na(p.lo) ? l : math.min(p.lo, l)

// Developing POC / VAH / VAL straight off the fine bins — the live read.
// Returns [poc, vah, val]; na tuple while the profile is still empty.
f_devPVV(Prof p) =>
    float poc = na
    float vah = na
    float val = na
    int nb = array.size(p.vol)
    if nb > 0 and not na(p.lo) and not na(p.hi) and p.hi > p.lo
        float tot = 0.0
        int pocB = 0
        float mxB = -1.0
        for i = 0 to nb - 1
            float bv = array.get(p.vol, i)
            tot += bv
            if bv > mxB
                mxB := bv
                pocB := i
        if tot > 0
            float vaVol = array.get(p.vol, pocB)
            int up = pocB + 1
            int dn = pocB - 1
            while vaVol < tot * inVA / 100.0
                float vu = up <= nb - 1 ? array.get(p.vol, up) : -1.0
                float vd = dn >= 0 ? array.get(p.vol, dn) : -1.0
                if vu < 0 and vd < 0
                    break
                if vu >= vd
                    vaVol += vu
                    up += 1
                else
                    vaVol += vd
                    dn -= 1
            poc := (p.base + pocB + 0.5) * fineBin
            vah := (p.base + up) * fineBin
            val := (p.base + dn + 1) * fineBin
    [poc, vah, val]

// completed profile → ranked levels. rank = scope + kind.
f_levels(Prof p, string pre, int scope) =>
    array<Lvl> out = array.new<Lvl>()
    int nb = array.size(p.vol)
    if nb > 0 and not na(p.lo) and not na(p.hi) and p.hi > p.lo
        float rowH = (p.hi - p.lo) / inRows
        array<float> rv = array.new<float>(inRows, 0.0)
        float tot = 0.0
        for i = 0 to nb - 1
            float bv = array.get(p.vol, i)
            if bv > 0
                float pr = (p.base + i + 0.5) * fineBin
                int ri = math.min(inRows - 1, math.max(0, int(math.floor((pr - p.lo) / rowH))))
                array.set(rv, ri, array.get(rv, ri) + bv)
                tot += bv
        if tot > 0
            // row POC index — kept only to exclude the POC row from HVN picks
            int pocI = 0
            float mx = -1.0
            for i = 0 to inRows - 1
                if array.get(rv, i) > mx
                    mx := array.get(rv, i)
                    pocI := i
            // tick-accurate POC / VA off the fine bins — identical on every chart TF
            int pocB = 0
            float mxB = -1.0
            for i = 0 to nb - 1
                if array.get(p.vol, i) > mxB
                    mxB := array.get(p.vol, i)
                    pocB := i
            float vaVol = array.get(p.vol, pocB)
            int up = pocB + 1
            int dn = pocB - 1
            while vaVol < tot * inVA / 100.0
                float vu = up <= nb - 1 ? array.get(p.vol, up) : -1.0
                float vd = dn >= 0 ? array.get(p.vol, dn) : -1.0
                if vu < 0 and vd < 0
                    break
                if vu >= vd
                    vaVol += vu
                    up += 1
                else
                    vaVol += vd
                    dn -= 1
            float avgRow = tot / inRows
            int kS = scope == 3 ? 5 : scope == 2 ? 3 : 1
            out.push(Lvl.new((p.base + pocB + 0.5) * fineBin, pre + "POC", kS + 5, scope))
            out.push(Lvl.new((p.base + up) * fineBin, pre + "VAH", kS + 3, scope))
            out.push(Lvl.new((p.base + dn + 1) * fineBin, pre + "VAL", kS + 3, scope))
            if inMaxHV > 0
                array<int> usedH = array.new<int>()
                for c = 1 to inMaxHV
                    int bi = -1
                    float bb = -1.0
                    for i = 1 to inRows - 2
                        float v0 = array.get(rv, i)
                        if i != pocI and v0 >= inHvnK * avgRow and v0 > array.get(rv, i - 1) and v0 >= array.get(rv, i + 1) and not array.includes(usedH, i) and v0 > bb
                            bb := v0
                            bi := i
                    if bi >= 0
                        usedH.push(bi)
                        out.push(Lvl.new(p.lo + (bi + 0.5) * rowH, pre + "HVN", kS + 2, scope))
            if inMaxLV > 0
                array<int> usedL = array.new<int>()
                for c = 1 to inMaxLV
                    int bi = -1
                    float bb = 1.0e18
                    for i = 1 to inRows - 2
                        float v0 = array.get(rv, i)
                        if v0 <= inLvnK * avgRow and v0 < array.get(rv, i - 1) and v0 < array.get(rv, i + 1) and not array.includes(usedL, i) and v0 < bb
                            bb := v0
                            bi := i
                    if bi >= 0
                        usedL.push(bi)
                        out.push(Lvl.new(p.lo + (bi + 0.5) * rowH, pre + "LVN", kS + 1, scope))
            out.push(Lvl.new(p.hi, pre + "H", kS + 3, scope))
            out.push(Lvl.new(p.lo, pre + "L", kS + 3, scope))
    out

f_gather(array<Lvl> src, array<float> gp, array<int> gr, array<int> gs, array<string> gn) =>
    for x in src
        gp.push(x.price)
        gr.push(x.rank)
        gs.push(x.scope)
        gn.push(x.name)
    true

// Stable stat key for one atomic level. Named levels key by name (concept
// identity: "pdPOC" is one behavioral fact forever). HVN/LVN have no name —
// they key by price bucket, quantized by the active cluster width; a node
// migrating a full bucket starts fresh (accepted).
f_lvlKey(string nm, float price, float w) =>
    str.endswith(nm, "HVN") or str.endswith(nm, "LVN") ? nm + "_" + str.tostring(math.round(price / math.max(w, syminfo.mintick))) : nm

// merge levels within width w into clusters. rank = sum, price = rank-weighted.
// 2.6: also emits per-cluster TIGHT zone (member-price span, min width w) and
// the flattened member slice (key/rank/scope) the Effective Score engine
// attributes touches to. Stats are NOT touched here — clusters are a view,
// the maps are the durable truth.
f_clusters(array<Lvl> aW, array<Lvl> aD, array<Lvl> aA, array<Lvl> aL, array<Lvl> aN, bool useSess, float w, array<float> clP, array<float> clR, array<int> clS, array<string> clN, array<int> clSt, array<int> clEB, array<int> tTch, array<int> tStB, array<float> tStV, array<float> cLoT, array<float> cHiT, array<int> cMemA, array<int> cMemN, array<string> mKey, array<float> mRank, array<int> mScope) =>
    clP.clear()
    clR.clear()
    clS.clear()
    clN.clear()
    clSt.clear()
    clEB.clear()
    tTch.clear()
    tStB.clear()
    tStV.clear()
    cLoT.clear()
    cHiT.clear()
    cMemA.clear()
    cMemN.clear()
    mKey.clear()
    mRank.clear()
    mScope.clear()
    array<float> gp = array.new<float>()
    array<int> gr = array.new<int>()
    array<int> gs = array.new<int>()
    array<string> gn = array.new<string>()
    f_gather(aW, gp, gr, gs, gn)
    f_gather(aD, gp, gr, gs, gn)
    if useSess
        f_gather(aA, gp, gr, gs, gn)
        f_gather(aL, gp, gr, gs, gn)
        f_gather(aN, gp, gr, gs, gn)
    int n = gp.size()
    if n > 0
        array<int> ord = array.sort_indices(gp)
        float wSum = 0.0
        float rSum = 0.0
        int sMax = 0
        string nAcc = ""
        int cnt = 0
        float lastP = na
        float mLo = na
        float mHi = na
        int memA = 0
        for r = 0 to n - 1
            int k = ord.get(r)
            float p = gp.get(k)
            bool merge = cnt > 0 and p - lastP <= w
            if not merge and cnt > 0
                clP.push(wSum / rSum)
                clR.push(rSum)
                clS.push(sMax)
                clN.push(nAcc)
                clSt.push(0)
                clEB.push(0)
                tTch.push(0)
                tStB.push(-1)
                tStV.push(float(na))
                // tight zone: member span, widened symmetrically to ≥ w
                float pad0 = math.max(0.0, (w - (mHi - mLo)) / 2)
                cLoT.push(mLo - pad0)
                cHiT.push(mHi + pad0)
                cMemA.push(memA)
                cMemN.push(cnt)
                wSum := 0.0
                rSum := 0.0
                sMax := 0
                nAcc := ""
                cnt := 0
                mLo := na
                mHi := na
                memA := mKey.size()
            wSum += p * gr.get(k)
            rSum += gr.get(k)
            sMax := math.max(sMax, gs.get(k))
            nAcc := cnt == 0 ? gn.get(k) : cnt < 3 ? nAcc + "+" + gn.get(k) : cnt == 3 ? nAcc + "+…" : nAcc
            mLo := na(mLo) ? p : math.min(mLo, p)
            mHi := na(mHi) ? p : math.max(mHi, p)
            mKey.push(f_lvlKey(gn.get(k), p, w))
            mRank.push(gr.get(k))
            mScope.push(gs.get(k))
            cnt += 1
            lastP := p
        if cnt > 0
            clP.push(wSum / rSum)
            clR.push(rSum)
            clS.push(sMax)
            clN.push(nAcc)
            clSt.push(0)
            clEB.push(0)
            tTch.push(0)
            tStB.push(-1)
            tStV.push(float(na))
            float pad1 = math.max(0.0, (w - (mHi - mLo)) / 2)
            cLoT.push(mLo - pad1)
            cHiT.push(mHi + pad1)
            cMemA.push(memA)
            cMemN.push(cnt)
    true

// MR reaction test at one level. Returns 1 long, -1 short, 0 none.
f_mrTest(float lvl) =>
    int d = 0
    if not na(lvl)
        // touch may land on this bar OR the prior bar; rejection close is this bar
        if (cPrev > lvl or cPrev2 > lvl) and loW <= lvl + mrTol and loW >= lvl - stopPts and close > lvl and cPos >= inWick
            d := 1
        else if (cPrev < lvl or cPrev2 < lvl) and hiW >= lvl - mrTol and hiW <= lvl + stopPts and close < lvl and cPos <= 1 - inWick
            d := -1
    d

f_stars(float r) =>
    r >= 10 ? 5 : r >= 8 ? 4 : r >= 6 ? 3 : r >= 4 ? 2 : 1

f_starTxt(int s) =>
    s == 5 ? "★★★★★" : s == 4 ? "★★★★" : s == 3 ? "★★★" : s == 2 ? "★★" : "★"

// Exact score display — the raw summed rank, uncapped. One math for every
// level; stars remain only as color bands.
f_scoreTxt(float r) =>
    "[" + str.tostring(int(math.round(r))) + "]"

f_starCol(int s) =>
    s == 5 ? colS5 : s == 4 ? colS4 : s == 3 ? colS3 : s == 2 ? colS2 : colS1

// developing profile → display rows for the histogram
f_rows(Prof p, int rowsN) =>
    array<float> rv = array.new<float>(rowsN, 0.0)
    float lo = p.lo
    float rowH = na
    float tot = 0.0
    int pocI = 0
    int uI = 0
    int dI = 0
    int nb = array.size(p.vol)
    if nb > 0 and not na(p.lo) and not na(p.hi) and p.hi > p.lo
        rowH := (p.hi - p.lo) / rowsN
        for i = 0 to nb - 1
            float bv = array.get(p.vol, i)
            if bv > 0
                float pr = (p.base + i + 0.5) * fineBin
                int ri = math.min(rowsN - 1, math.max(0, int(math.floor((pr - lo) / rowH))))
                rv.set(ri, rv.get(ri) + bv)
                tot += bv
        if tot > 0
            float mx = -1.0
            for i = 0 to rowsN - 1
                if rv.get(i) > mx
                    mx := rv.get(i)
                    pocI := i
            float vaVol = rv.get(pocI)
            uI := pocI + 1
            dI := pocI - 1
            while vaVol < tot * inVA / 100.0
                float vu = uI <= rowsN - 1 ? rv.get(uI) : -1.0
                float vd = dI >= 0 ? rv.get(dI) : -1.0
                if vu < 0 and vd < 0
                    break
                if vu >= vd
                    vaVol += vu
                    uI += 1
                else
                    vaVol += vd
                    dI -= 1
    [rv, lo, rowH, tot, pocI, uI, dI]

// Brand dashboard row: dark card, dim key, STATE-COLORED value text on a
// whisper of the same color — matches the label aesthetic on the chart
// instead of stock green/red cell fills.
f_row(table t, int r, string k, string v, color st) =>
    table.cell(t, 0, r, k, text_color = #787b86, text_size = size.tiny, bgcolor = color.new(#0d0d10, 8))
    table.cell(t, 1, r, v, text_color = st, text_size = size.tiny, bgcolor = color.new(st, 86))

// ── STATE ──────────────────────────────────────────────────────────────────
var Prof dP = f_newProf()
var Prof wP = f_newProf()
var Prof aP = f_newProf()
var Prof lP = f_newProf()
var Prof nP = f_newProf()
var array<Lvl> priorD = array.new<Lvl>()
var array<Lvl> priorW = array.new<Lvl>()
var array<Lvl> priorA = array.new<Lvl>()
var array<Lvl> priorL = array.new<Lvl>()
var array<Lvl> priorN = array.new<Lvl>()
// clusters (parallel arrays) + BRT state per cluster
// state: 0 live · 1 broke up · 2 broke down · 3 done/dead
var array<float>  clP  = array.new<float>()
var array<float>  clR  = array.new<float>()
var array<int>    clS  = array.new<int>()
var array<string> clN  = array.new<string>()
var array<int>    clSt = array.new<int>()
var array<int>    clEB = array.new<int>()
// BRT break-acceptance counter per cluster (2.9.2): signed consecutive
// closes beyond the escape margin (+above / -below); reset on recluster.
var array<int>    clAcc = array.new<int>()
var bool needCl = false
// anchors for profile histogram + dev lines
var int dT0 = na
var int wT0 = na
var int aT0 = na
var int lT0 = na
var int nT0 = na
// overnight extremes (live session extremes ride sessHi/sessLo)
var float onHi = na
var float onLo = na
// VWAP
var float sPV = 0.0
// session TWAP (time-weighted): plain mean of hlc3 since session open
var float sTw = 0.0
var int sTwN = 0
var float sV = 0.0
var float sP2 = 0.0
// IB
var float ibHi = na
var float ibLo = na
var bool ibDone = false
var int accUp = 0
var int accDn = 0
var int firedUp = 0
var int firedDn = 0
// discipline
var int sigCnt = 0
var int lastSigBar = -99999
var array<float> appFired = array.new<float>()
// developing levels (confirmed-close values — anti-repaint)
var float devSPoc = na
var float devSVah = na
var float devSVal = na
var float devDPoc = na
var float devDVah = na
var float devDVal = na
// plan drawings + live-plan state
var line planE = na
var line planS = na
var line planT = na
var label planRes = na
var int planDir = 0
var float planSp = na
var float planTp = na
var float planEp = na
var bool planFilled = false
var bool planOn = false
// imbalance zones (footprint proxy) — parallel arrays, newest last
var array<box>   imbBx  = array.new<box>()
var array<float> imbHi  = array.new<float>()
var array<float> imbLo  = array.new<float>()
var array<int>   imbDir = array.new<int>()
var array<int>   imbTch = array.new<int>()   // touches since creation
var array<int>   imbBorn = array.new<int>()  // creation bar time (skip self-touch)
// last lower-TF close carried across chart bars for the up/down volume split
var float lastLtf = na

// ── EFFECTIVE SCORE · REGIME · POOL state (2.6) ────────────────────────────
// cluster tight zones + flattened member slices (parallel to clP; f_clusters)
var array<float>  clLoT = array.new<float>()
var array<float>  clHiT = array.new<float>()
var array<int>    clMemA = array.new<int>()
var array<int>    clMemN = array.new<int>()
var array<string> memKey = array.new<string>()
var array<float>  memRank = array.new<float>()
var array<int>    memScope = array.new<int>()
// reaction memory — the durable truth clusters are only a view of
var map<string, DirStat> dirStats = map.new<string, DirStat>()
var map<string, FreshStat> freshStats = map.new<string, FreshStat>()
// epoch counters: bump at scope boundaries → stale-epoch reads count as 0
var int epSess = 0
var int epDay = 0
var int epWeek = 0
// any Asia bar seen since the last daily roll → the Asia-open trade-day
// boundary exists on this data; otherwise the calendar day stands in
var bool sawAsia = false
// pending touches — fully self-contained snapshots (dir, frozen tight-zone
// edges, seeded acceptance/excursion, ";"-joined member keys) so resolution
// 1-3 bars later attributes to the same atoms even after a cluster rebuild
var array<int>    pdDirA = array.new<int>()
var array<float>  pdLoA = array.new<float>()
var array<float>  pdHiA = array.new<float>()
var array<int>    pdBarA = array.new<int>()
var array<int>    pdCnsA = array.new<int>()
var array<float>  pdBeyA = array.new<float>()
var array<string> pdKeysA = array.new<string>()
// regime
var int tier = 1              // 0 LOW · 1 NORM · 2 HIGH · 3 EXTREME
var float atrPct = na
// unified level pool: clusters first (pool idx == cluster idx), then dynamic
// singletons (VWAP/±2σ/sesH·L/ON/IB/dev). Rebuilt every confirmed bar —
// touch engine, MR engine, HUD and the execution render all read THIS.
var array<float>  poolP = array.new<float>()
var array<float>  poolLoT = array.new<float>()
var array<float>  poolHiT = array.new<float>()
var array<float>  poolRank = array.new<float>()
var array<string> poolName = array.new<string>()
var array<int>    poolMemA = array.new<int>()
var array<int>    poolMemN = array.new<int>()
var array<string> pmKey = array.new<string>()
var array<float>  pmRank = array.new<float>()
var array<int>    pmScope = array.new<int>()
// initiative trackers (vars → [k] history works)
var int upStrk = 0
var int dnStrk = 0
var float barVolUD = 0.0
// live MR signal (HUD SIGNAL state + validity window)
var int sigDir = 0
var string sigPlay = "MR"     // which play owns the HUD block: MR or IB
var float sigE = na
var float sigS = na
var float sigT = na
var float sigR = na
var int sigBorn = na
var string sigLvlTxt = ""

// price inside a live zone? 1 buy zone · -1 sell zone · 0 none
f_inZone(float px) =>
    int z = 0
    if enImb and imbLo.size() > 0
        for i = 0 to imbLo.size() - 1
            if px >= imbLo.get(i) and px <= imbHi.get(i)
                z := imbDir.get(i)
    z

// drop zone i everywhere
f_zoneKill(int i) =>
    box.delete(imbBx.get(i))
    imbBx.remove(i)
    imbHi.remove(i)
    imbLo.remove(i)
    imbDir.remove(i)
    imbTch.remove(i)
    imbBorn.remove(i)
    true

// price of a named level inside a prior-period level array; na if absent
f_lvlPrice(array<Lvl> a, string nm) =>
    float p = na
    for x in a
        if x.name == nm
            p := x.price
    p

// least-squares slope over an array of floats (x = 0..n-1); na if < 2 points
f_slope(array<float> ys) =>
    int n = ys.size()
    float s = na
    if n >= 2
        float sx = 0.0
        float sy = 0.0
        float sxy = 0.0
        float sxx = 0.0
        for i = 0 to n - 1
            float fx = i
            float fy = ys.get(i)
            sx += fx
            sy += fy
            sxy += fx * fy
            sxx += fx * fx
        float den = n * sxx - sx * sx
        if den != 0
            s := (n * sxy - sx * sy) / den
    s

// ── EFFECTIVE SCORE · REGIME · CONSTRUCTION functions (2.6) ────────────────
// epoch for a scope: 3 week · 2 day · else session
f_epochFor(int scope) =>
    scope == 3 ? epWeek : scope == 2 ? epDay : epSess

// effComponent of one atom for one arrival direction (1 = fromBelow).
// untested direction reads exactly 1.0; na-guarded so a missing key can
// never poison the sum (na × rank would silently kill the whole score).
f_comp(string baseKey, int dirCode, float baseRank, int scope) =>
    int ep = f_epochFor(scope)
    DirStat ds = dirStats.get(baseKey + (dirCode == 1 ? "|B" : "|A"))
    float mult = na(ds) or na(ds.ewma) or ds.epoch != ep ? 1.0 : math.max(0.5, math.min(1.5, 0.5 + ds.ewma))
    FreshStat fs = freshStats.get(baseKey)
    int tchT = na(fs) or fs.epoch != ep ? 0 : fs.tchToday
    // the newest touch doesn't decay its OWN evaluation bar — a first touch
    // is graded naked (1.0); the decay shows up on the next approach
    if not na(fs) and fs.epoch == ep and fs.lastBar == bar_index
        tchT := math.max(0, tchT - 1)
    baseRank * mult * math.pow(inFreshDecay, tchT)

// directional record for labels — "3H/1B"; untested this period = "new"
f_recordTxt(string baseKey, int dirCode, int scope) =>
    DirStat ds = dirStats.get(baseKey + (dirCode == 1 ? "|B" : "|A"))
    na(ds) or ds.epoch != f_epochFor(scope) ? "new" : str.tostring(ds.holdN) + "H/" + str.tostring(ds.brkN) + "B"

// touch freshness: epoch-tagged touchesToday increment (O(1) scope resets)
f_touchMark(string baseKey, int scope) =>
    FreshStat fs = freshStats.get(baseKey)
    if na(fs)
        fs := FreshStat.new()
        freshStats.put(baseKey, fs)
    int ep = f_epochFor(scope)
    if fs.epoch != ep
        fs.epoch := ep
        fs.tchToday := 1
    else
        fs.tchToday += 1
    fs.lastBar := bar_index
    true

// outcome resolution: EWMA update (seeded from neutral 0.5) + H/B record,
// for every member of the touched zone, in the touch's direction. Items in
// the csv are "key,scope" pairs — the scope stamps the epoch, so a stat
// whose period rolled resets to fresh before the new outcome lands.
// This is the ONLY writer of ewma — touch time never moves it (the touch's
// own outcome does not exist yet; using it would be intra-bar future leak).
f_resolveKeys(string keysCsv, int dirCode, float outcome) =>
    array<string> ks = str.split(keysCsv, ";")
    for kk in ks
        array<string> parts = str.split(kk, ",")
        if parts.size() >= 2
            string dk = parts.get(0) + (dirCode == 1 ? "|B" : "|A")
            int scope = int(nz(str.tonumber(parts.get(1)), 1))
            int ep = f_epochFor(scope)
            DirStat ds = dirStats.get(dk)
            if na(ds)
                ds := DirStat.new()
                dirStats.put(dk, ds)
            if ds.epoch != ep
                ds.epoch := ep
                ds.ewma := na
                ds.holdN := 0
                ds.brkN := 0
            ds.ewma := na(ds.ewma) ? 0.5 + inReactAlpha * (outcome - 0.5) : ds.ewma + inReactAlpha * (outcome - ds.ewma)
            if outcome > 0.5
                ds.holdN += 1
            else
                ds.brkN += 1
    true

// regime tier parameter lookups (all inputs — §3 table)
f_tierW() =>
    tier == 0 ? wLow : tier == 1 ? wNorm : tier == 2 ? wHigh : wExt
f_tierDisp() =>
    tier == 0 ? dispLow : tier == 1 ? dispNorm : tier == 2 ? dispHigh : dispExt
f_tierTrd() =>
    tier == 0 ? trdLow : tier == 1 ? trdNorm : tier == 2 ? trdHigh : trdExt
f_tierTpFloor() =>
    tier == 0 ? tpFloorLow : tier == 1 ? tpFloorNorm : tier == 2 ? tpFloorHigh : tpFloorExt
f_tierTpCap() =>
    tier == 0 ? tpCapLow : tier == 1 ? tpCapNorm : tier == 2 ? tpCapHigh : tpCapExt
f_tierSBuf() =>
    tier == 0 ? sBufLow : tier == 1 ? sBufNorm : tier == 2 ? sBufHigh : sBufExt
f_tierName() =>
    tier == 0 ? "LOW" : tier == 1 ? "NORM" : tier == 2 ? "HIGH" : "EXTREME"

// append a dynamic singleton to the pool: zone = price ± half cluster width,
// its own single member (keyed by name — concept identity)
f_poolAdd(float px, string nm, float rk, int scope) =>
    if not na(px)
        float hw = math.max(clustWv, syminfo.mintick) / 2
        poolP.push(px)
        poolLoT.push(px - hw)
        poolHiT.push(px + hw)
        poolRank.push(rk)
        poolName.push(nm)
        poolMemA.push(pmKey.size())
        poolMemN.push(1)
        pmKey.push(nm)
        pmRank.push(rk)
        pmScope.push(scope)
    true

// EffScore of pool item i for arrival direction dirCode (1 = fromBelow):
// Σ member effComponents + imbalance-zone confluence bonus (score points).
// Invariant: an all-untested item's EffScore == its plain summed rank.
f_poolScore(int i, int dirCode) =>
    float s = 0.0
    int a = poolMemA.get(i)
    int nM = poolMemN.get(i)
    if nM > 0
        for m = a to a + nM - 1
            s += f_comp(pmKey.get(m), dirCode, pmRank.get(m), pmScope.get(m))
    s + (f_inZone(poolP.get(i)) != 0 ? inImbBonus : 0)

// Dynamic trade construction (§4) — 100% resting-limit workflow. dir = trade
// direction; short mirrors long by arithmetic, never by duplicated branches.
// Direction table (sign bugs breed here — pin it):
//   MR long : price arrived fromAbove (|A) · entry = UPPER tight edge offset
//             down INTO the zone · stop below far edge · TP scan UP, each
//             candidate scored fromBelow (|B)
//   MR short: every term negated.
// TP1 = front edge of the NEAREST opposing qualifying item minus standoff —
// never through a working level. Nearest qualifying fails the room floor →
// NO TRADE (never skip to the next). None within tpCap×dATR → open field.
// Returns [entry, stop, tp1, r, roomOk].
f_construct(int i, int dir, float dAtrP) =>
    float wNow = math.max(clustWv, syminfo.mintick)
    float entry = dir == 1 ? poolHiT.get(i) - inEntryOff * wNow : poolLoT.get(i) + inEntryOff * wNow
    float stop = dir == 1 ? poolLoT.get(i) - f_tierSBuf() * dAtrP : poolHiT.get(i) + f_tierSBuf() * dAtrP
    float stopD = (entry - stop) * dir
    float qDist = na
    float qFront = na
    int nP = poolP.size()
    if nP > 0
        for q = 0 to nP - 1
            if q != i
                float front = dir == 1 ? poolLoT.get(q) : poolHiT.get(q)
                float dd = (front - entry) * dir
                if dd > 0 and (na(qDist) or dd < qDist)
                    if f_poolScore(q, dir) >= f_tierTrd()
                        qDist := dd
                        qFront := front
    float tp = na
    if not na(qFront) and qDist <= f_tierTpCap() * dAtrP
        tp := qFront - dir * math.max(syminfo.mintick, inTpStand * wNow)
    else
        tp := entry + dir * f_tierTpCap() * dAtrP
    float tpD = (tp - entry) * dir
    bool ok = stopD > 0 and tpD >= math.max(inMinR * stopD, f_tierTpFloor() * dAtrP)
    [entry, stop, tp, tpD / math.max(stopD, syminfo.mintick), ok]

// ── DAY TYPE · APPROACH · STAMP state ──────────────────────────────────────
// delta series shared by everything (assigned each confirmed bar)
var float barDelta = 0.0
var float cumSessDelta = 0.0
// session tracking
var string sessPrev = ""
var float sessHi = na
var float sessLo = na
var float sessOpen = na
var bool ibBrokeUp = false
var bool ibBrokeDn = false
// full-day range tracking for ADR(10) — no request needed
var float dayHiT = na
var float dayLoT = na
var array<float> adrArr = array.new<float>()
// 15m one-timeframing buckets tracked on-chart
var float m15Hi = na
var float m15Lo = na
var float m15PrevHi = na
var float m15PrevLo = na
var int m15UpStreak = 0
var int m15DnStreak = 0
// evaluation ring buffers (cap 24 evaluations)
var array<float> evalCum = array.new<float>()
var array<float> evalDelta = array.new<float>()
var float lastEvalCum = 0.0
// day-type state machine
var string dtState = "TRANSITION"
var string dtCand = ""
var int dtCandN = 0
var int dtT = 0
var bool dtGateOK = false
// approach state
var int apDir = 0
var string apGrade = ""
var float apLvlP = na
var float apLvlR = 0.0
var string apLvlN = ""
var array<label> apLbs = array.new<label>()
// stamp state (kept per cluster in parallel arrays cleared on recluster)
var array<int> clTch = array.new<int>()     // touches today
var array<int> clStB = array.new<int>()     // last stamp bar (-1 = armed)
var array<float> clStV = array.new<float>() // last stamp score
var float stLastScore = na
var string stLastBand = ""
var string stLastName = ""
var int stLastBar = na
var array<label> stLbs = array.new<label>()

// Request budget: THREE calls. Lower-TF close/volume/hl2 feed the profiles,
// the up/down volume split and the stamp bins; two daily pulls feed the
// regime engine. Daily pattern is value[1] + lookahead_on = yesterday's
// COMPLETED value — constant all day, identical on history and realtime
// (lookahead_off would drift intrabar and flip regime tiers mid-session;
// bare lookahead_on without [1] would leak tomorrow into history).
[ltfC, ltfV, ltfH] = request.security_lower_tf(syminfo.tickerid, ltfStr, [close, volume, hl2])
// ATR percentile is computed INSIDE the daily context (ta.percentrank over
// the daily series), so a 1-minute chart still sees the full 60-day window —
// an on-chart ring would starve on intraday history and jam the tier at NORM.
[dAtr, atrPctD] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], ta.percentrank(ta.atr(14), 60)[1]], lookahead = barmerge.lookahead_on)
float vixD = request.security("TVC:VIX", "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

// ── PER-BAR TRACKING (live) ────────────────────────────────────────────────
if timeframe.change("D")
    dT0 := time
if timeframe.change("W")
    wT0 := time
if inA and not inA[1]
    aT0 := time
if inL and not inL[1]
    lT0 := time
if inRTH and not inRTH[1]
    nT0 := time

if inON and not inON[1]
    onHi := high
    onLo := low
if inON
    onHi := math.max(nz(onHi, high), high)
    onLo := math.min(nz(onLo, low), low)

// trading-day reset — Asia open (18:00 ET) starts the day
if newTradeDay
    sigCnt := 0
    // wipe yesterday's trade-plan drawings
    if not na(planE)
        line.delete(planE)
        planE := line(na)
    if not na(planS)
        line.delete(planS)
        planS := line(na)
    if not na(planT)
        line.delete(planT)
        planT := line(na)
    if not na(planRes)
        label.delete(planRes)
        planRes := label(na)
    planOn := false
    planDir := 0
    appFired.clear()
// per-session VWAP + IB: every session opens fresh
if newSess
    sPV := 0.0
    sV := 0.0
    sP2 := 0.0
    sTw := 0.0
    sTwN := 0
    ibHi := high
    ibLo := low
    ibDone := false
    accUp := 0
    accDn := 0
    firedUp := 0
    firedDn := 0
if inAnySess
    sPV += hlc3 * nz(volume)
    sV += nz(volume)
    sP2 += hlc3 * hlc3 * nz(volume)
    sTw += hlc3
    sTwN += 1
float vwapV = inAnySess and sV > 0 ? sPV / sV : na
float twapV = inAnySess and sTwN > 0 ? sTw / sTwN : na
float sd = inAnySess and sV > 0 ? math.sqrt(math.max(sP2 / sV - vwapV * vwapV, 0.0)) : na
float up1 = vwapV + sd
float dn1 = vwapV - sd
float up2 = vwapV + 2 * sd
float dn2 = vwapV - 2 * sd

if inIBw
    ibHi := math.max(nz(ibHi, high), high)
    ibLo := math.min(nz(ibLo, low), low)
if inAnySess and not inIBw and inIBw[1] and not na(ibHi)
    ibDone := true

// ledger-feed event flags — set on confirmed bars, consumed at the bottom
bool evTouch = false
string evTouchTxt = ""
bool evStamp = false
string evStampTxt = ""
bool evDayType = false
string evDayTypeTxt = ""
bool evAppr = false
string evApprTxt = ""
bool evBench = false
string evBenchTxt = ""
bool evNoTrade = false
string evNoTradeTxt = ""

// ── ROLLS + ACCUMULATION (confirmed bars only — no repaint) ────────────────
bool tierChanged = false
if barstate.isconfirmed
    // ── REGIME step (2.6) — tier from the daily ATR percentile + VIX bump.
    // Values only move at the daily roll (both pulls are prior-day [1]);
    // na percentile (young symbol) parks the tier at NORM.
    atrPct := atrPctD
    int tierNew = 1
    if not na(atrPct)
        tierNew := atrPct > inPctExt ? 3 : atrPct >= inPctHigh ? 2 : atrPct < inPctLow ? 0 : 1
        if useVix and not na(vixD)
            tierNew := math.min(3, tierNew + (vixD >= inVix2 ? 2 : vixD >= inVix1 ? 1 : 0))
    tierChanged := tierNew != tier
    tier := tierNew
    // ── EPOCH bumps + pending purge (2.6) — O(1) scope resets ────────────
    if newSess
        epSess += 1
    if timeframe.change("W")
        epWeek += 1
    // trade day starts at the Asia open — but data with no 18:00 ET bars
    // (RTH-only symbols) would never roll; fall back to the calendar day
    bool dayRoll = newTradeDay or (timeframe.change("D") and not sawAsia)
    if inA
        sawAsia := true
    if dayRoll
        // evidence across the 16:00-18:00 settlement halt is polluted —
        // purge open pendings as NEITHER (touches counted at open; no EWMA)
        pdDirA.clear()
        pdLoA.clear()
        pdHiA.clear()
        pdBarA.clear()
        pdCnsA.clear()
        pdBeyA.clear()
        pdKeysA.clear()
        // garbage collection: HVN/LVN bucket keys accrete over months and
        // re-bucket on tier change — over the cap, drop the node stats
        // wholesale (named keys are never pruned; they are the signal)
        if dirStats.size() > inStatCap or freshStats.size() > inStatCap
            array<string> dks = dirStats.keys()
            for kk in dks
                if str.contains(kk, "VN_")
                    dirStats.remove(kk)
            array<string> fks = freshStats.keys()
            for kk2 in fks
                if str.contains(kk2, "VN_")
                    freshStats.remove(kk2)
    if timeframe.change("D")
        sawAsia := false
        priorD := f_levels(dP, "pd", 2)
        dP := f_newProf()
        needCl := true
    if timeframe.change("W")
        priorW := f_levels(wP, "pw", 3)
        wP := f_newProf()
        needCl := true
    if not inA and inA[1]
        priorA := f_levels(aP, "AS ", 1)
        needCl := true
    if inA and not inA[1]
        aP := f_newProf()
    if not inL and inL[1]
        priorL := f_levels(lP, "LDN ", 1)
        needCl := true
    if inL and not inL[1]
        lP := f_newProf()
    if not inRTH and inRTH[1]
        priorN := f_levels(nP, "NY ", 1)
        needCl := true
    if newRTH
        nP := f_newProf()
    int nL = array.size(ltfC)
    if nL > 0
        for i = 0 to nL - 1
            float pc = array.get(ltfC, i)
            float vv = array.get(ltfV, i)
            if not na(pc)
                f_add(dP, pc, vv)
                f_add(wP, pc, vv)
                if inA
                    f_add(aP, pc, vv)
                if inL
                    f_add(lP, pc, vv)
                if inRTH
                    f_add(nP, pc, vv)
    else
        f_add(dP, hl2, volume)
        f_add(wP, hl2, volume)
        if inA
            f_add(aP, hl2, volume)
        if inL
            f_add(lP, hl2, volume)
        if inRTH
            f_add(nP, hl2, volume)
    f_stretch(dP, high, low)
    f_stretch(wP, high, low)
    if inA
        f_stretch(aP, high, low)
    if inL
        f_stretch(lP, high, low)
    if inRTH
        f_stretch(nP, high, low)
    // ── cluster width (2.6): regime tier × dATR, recomputed ONLY at a
    // session boundary or on tier change — bar-by-bar width churn scatters
    // stats across neighboring HVN buckets and shuffles cluster identity
    if na(clustW) or newSess or tierChanged
        float wTarget = not na(dAtr) ? f_tierW() * dAtr : clustWSeed
        if na(clustW) or wTarget != clustW
            clustW := wTarget
            needCl := true
            // clustWv was derived at the top of the bar from the OLD width —
            // refresh it NOW so this bar's recluster, HVN bucket keys, pool
            // zones and construction all use the new width (without this the
            // whole session after a width change runs on stale geometry)
            clustWv := inClW > 0 ? inClW : clustW
    if needCl
        f_clusters(priorW, priorD, priorA, priorL, priorN, not htfMode, clustWv, clP, clR, clS, clN, clSt, clEB, clTch, clStB, clStV, clLoT, clHiT, clMemA, clMemN, memKey, memRank, memScope)
        clAcc := array.new<int>(clP.size(), 0)
        needCl := false
    // ── developing levels — the LIVE read, refreshed every confirmed close ──
    if inRTH
        [p1, v1, w1] = f_devPVV(nP)
        devSPoc := p1
        devSVah := v1
        devSVal := w1
    else if inL
        [p2, v2, w2] = f_devPVV(lP)
        devSPoc := p2
        devSVah := v2
        devSVal := w2
    else if inA
        [p3, v3, w3] = f_devPVV(aP)
        devSPoc := p3
        devSVah := v3
        devSVal := w3
    else
        devSPoc := na
        devSVah := na
        devSVal := na
    [pd1, vd1, wd1] = f_devPVV(dP)
    devDPoc := pd1
    devDVah := vd1
    devDVal := wd1
    // ── up/down volume split (shared: zones · day type · approach · stamp)
    // Off the same lower-TF feed the profiles eat: an uptick LTF close books
    // its volume to the buyers, a downtick to the sellers. Approximation of
    // footprint order flow — Pine cannot read true bid/ask.
    float upV = 0.0
    float dnV = 0.0
    int nZ = array.size(ltfC)
    if nZ > 0
        for i = 0 to nZ - 1
            float pc = array.get(ltfC, i)
            if not na(pc)
                if not na(lastLtf)
                    if pc > lastLtf
                        upV += nz(array.get(ltfV, i))
                    else if pc < lastLtf
                        dnV += nz(array.get(ltfV, i))
                lastLtf := pc
    barDelta := upV - dnV
    cumSessDelta += barDelta
    // initiative trackers (2.6): consecutive same-direction closes + bar
    // volume total, kept as var series so the gates can read [k] history
    upStrk := close > close[1] ? upStrk + 1 : 0
    dnStrk := close < close[1] ? dnStrk + 1 : 0
    barVolUD := upV + dnV
    // ── imbalance zones (footprint proxy) ────────────────────────────────
    // One-sided share ≥ ratio on real volume = the bar's body becomes a
    // zone (approximation of stacked footprint imbalances).
    if enImb
        float totV = upV + dnV
        // mitigation: close through the far side kills instantly; every
        // other traversal COUNTS — passes consume the resting orders, so
        // touch 1 dims the box (that touch was the trade) and touch N
        // retires it. No more chopped-through wallpaper zones.
        if imbLo.size() > 0
            for i = imbLo.size() - 1 to 0
                bool dead = imbDir.get(i) == 1 ? close < imbLo.get(i) : close > imbHi.get(i)
                if not dead and time != imbBorn.get(i) and high >= imbLo.get(i) and low <= imbHi.get(i)
                    int tch = imbTch.get(i) + 1
                    imbTch.set(i, tch)
                    if tch >= inImbTouches
                        dead := true
                    else
                        color dimC = imbDir.get(i) == 1 ? colImbB : colImbS
                        box.set_bgcolor(imbBx.get(i), color.new(dimC, showImbBoxes ? 93 : 100))
                        box.set_border_color(imbBx.get(i), color.new(dimC, showImbBoxes ? 78 : 100))
                if dead
                    f_zoneKill(i)
        if not htfMode and totV > 0 and (inImbVolK == 0 or nz(volume) >= inImbVolK * volSma)
            float shr = math.max(upV, dnV) / totV
            if shr >= inImbRatio and high > low
                int zDir = upV >= dnV ? 1 : -1
                float bodyHi = math.max(open, close)
                float bodyLo = math.min(open, close)
                // Footprint imbalances are ROWS, not whole bars — whole
                // bodies painted trend days solid green. Zone = the ORIGIN
                // third of the impulse body: where the aggressive side
                // actually stepped in (min 2 ticks thick).
                float third = math.max((bodyHi - bodyLo) / 3.0, 2 * syminfo.mintick)
                float zHi = zDir == 1 ? bodyLo + third : bodyHi
                float zLo = zDir == 1 ? bodyLo : bodyHi - third
                // consecutive one-sided bars re-print the same area — one
                // zone per area per side is the signal, the rest is paint
                bool dupe = false
                float zMid = (zHi + zLo) / 2.0
                if imbLo.size() > 0
                    for i = 0 to imbLo.size() - 1
                        if imbDir.get(i) == zDir and zMid >= imbLo.get(i) and zMid <= imbHi.get(i)
                            dupe := true
                if zHi > zLo and not dupe
                    // boxes hidden by default since 2.6 (real footprint lives
                    // on another chart); the zone ENGINE + ◆ bonus stay live
                    color zc = zDir == 1 ? colImbB : colImbS
                    imbBx.push(box.new(time, zHi, time + barMs, zLo, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(zc, showImbBoxes ? 88 : 100), border_color = color.new(zc, showImbBoxes ? 60 : 100), border_width = 1))
                    imbHi.push(zHi)
                    imbLo.push(zLo)
                    imbDir.push(zDir)
                    imbTch.push(0)
                    imbBorn.push(time)
                    // cap per side, oldest out
                    int nB = 0
                    int nS = 0
                    for i = 0 to imbDir.size() - 1
                        if imbDir.get(i) == 1
                            nB += 1
                        else
                            nS += 1
                    if nB > inImbMax or nS > inImbMax
                        int killDir = nB > inImbMax ? 1 : -1
                        for i = 0 to imbDir.size() - 1
                            if imbDir.get(i) == killDir
                                f_zoneKill(i)
                                break
    // ── DAY TYPE trackers ────────────────────────────────────────────────
    // full-day ranges feed ADR(10) — tracked on-chart, no extra request
    if timeframe.change("D")
        if not na(dayHiT) and not na(dayLoT) and dayHiT > dayLoT
            adrArr.push(dayHiT - dayLoT)
            if adrArr.size() > 10
                adrArr.shift()
        dayHiT := high
        dayLoT := low
    else
        dayHiT := math.max(nz(dayHiT, high), high)
        dayLoT := math.min(nz(dayLoT, low), low)
    // 15m buckets for one-timeframing (chart bars stand in on ≥15m charts)
    if timeframe.change("15") or tfSec >= 900
        if not na(m15Hi) and not na(m15PrevHi)
            m15UpStreak := m15Lo > m15PrevLo ? m15UpStreak + 1 : 0
            m15DnStreak := m15Hi < m15PrevHi ? m15DnStreak + 1 : 0
        m15PrevHi := m15Hi
        m15PrevLo := m15Lo
        m15Hi := high
        m15Lo := low
    else
        m15Hi := math.max(nz(m15Hi, high), high)
        m15Lo := math.min(nz(m15Lo, low), low)
    // session flip resets
    bool sessFlip = sessNow != sessPrev
    if sessFlip
        sessPrev := sessNow
        sessHi := high
        sessLo := low
        sessOpen := open
        cumSessDelta := barDelta
        evalCum.clear()
        evalDelta.clear()
        lastEvalCum := 0.0
        ibBrokeUp := false
        ibBrokeDn := false
        dtState := "TRANSITION"
        dtCand := ""
        dtCandN := 0
        dtT := 0
    else
        sessHi := math.max(nz(sessHi, high), high)
        sessLo := math.min(nz(sessLo, low), low)
    if ibDone and not na(ibHi)
        if close > ibHi
            ibBrokeUp := true
        if close < ibLo
            ibBrokeDn := true
    // ── DAY TYPE evaluation (5m clock; chart TF when ≥ 5m) ───────────────
    if dtOn and sessNow != "OFF" and (tfSec >= 300 or timeframe.change("5"))
        evalDelta.push(cumSessDelta - lastEvalCum)
        lastEvalCum := cumSessDelta
        evalCum.push(cumSessDelta)
        if evalCum.size() > 24
            evalCum.shift()
        if evalDelta.size() > 24
            evalDelta.shift()
        float pdVahP = f_lvlPrice(priorD, "pdVAH")
        float pdValP = f_lvlPrice(priorD, "pdVAL")
        // D1 · session open vs prior day value
        int d1 = na(sessOpen) or na(pdVahP) or na(pdValP) ? 0 : sessOpen > pdVahP ? 2 : sessOpen < pdValP ? -2 : 0
        // D2 · IB break holding half the range beyond (the script's NY IB)
        int d2 = 0
        if ibDone and not na(ibHi) and ibHi > ibLo and not (ibBrokeUp and ibBrokeDn)
            float ibR = ibHi - ibLo
            if ibBrokeUp and close >= ibHi + 0.5 * ibR
                d2 := 2
            else if ibBrokeDn and close <= ibLo - 0.5 * ibR
                d2 := -2
        // D3 · developing value vs prior day value
        int d3 = 0
        bool valueOverlapping = false
        if not na(devDVal) and not na(devDVah) and not na(pdVahP) and not na(pdValP) and devDVah > devDVal and pdVahP > pdValP
            float ovl = math.min(devDVah, pdVahP) - math.max(devDVal, pdValP)
            float minW = math.min(devDVah - devDVal, pdVahP - pdValP)
            float ovlPct = minW > 0 ? math.max(ovl, 0.0) / minW : 0.0
            if ovlPct >= 0.5
                valueOverlapping := true
            else if ovlPct < 0.25
                d3 := (devDVal + devDVah) / 2 > (pdValP + pdVahP) / 2 ? 2 : -2
        // D4 · one-timeframing on 15m buckets
        int d4 = m15UpStreak >= dtOneTfStreak ? 2 : m15DnStreak >= dtOneTfStreak ? -2 : 0
        // D5 · cumulative session delta trend (slope + same-sign share)
        int d5 = 0
        if evalCum.size() >= 8
            float slp = f_slope(evalCum)
            int pos = 0
            int neg = 0
            for dv in evalDelta
                if dv > 0
                    pos += 1
                else if dv < 0
                    neg += 1
            int totE = evalDelta.size()
            float share = totE > 0 ? float(math.max(pos, neg)) / totE : 0.0
            if not na(slp) and share >= 0.65
                d5 := slp > 0 and pos >= neg ? 1 : slp < 0 and neg > pos ? -1 : 0
        dtT := d1 + d2 + d3 + d4 + d5
        // participation gate — no TREND print on a dead-range session
        float adrAvg = adrArr.size() > 0 ? adrArr.avg() : na
        float gateFrac = sessNow == "NY" ? dtRangeNY : sessNow == "LDN" ? dtRangeLDN : dtRangeAS
        dtGateOK := not na(adrAvg) and adrAvg > 0 and not na(sessHi) and (sessHi - sessLo) >= gateFrac * adrAvg
        string cand = math.abs(dtT) >= dtTrendThresh and dtGateOK ? (dtT > 0 ? "TREND▲" : "TREND▼") : math.abs(dtT) <= dtBalThresh and valueOverlapping ? "BALANCE" : "TRANSITION"
        if cand == dtCand
            dtCandN += 1
        else
            dtCand := cand
            dtCandN := 1
        if dtCandN >= dtHysteresis and dtState != cand
            evDayType := true
            evDayTypeTxt := "EVT=DAYTYPE|" + dtState + "->" + cand + "|T=" + str.tostring(dtT) + "|session=" + sessNow
            dtState := cand
    // ── APPROACH grade (execution only, display only) ────────────────────
    if not htfMode
        int dirTrav = close > close[apWindow] ? 1 : close < close[apWindow] ? -1 : 0
        float bestD = 1.0e18
        float bestP = na
        float bestR2 = 0.0
        string bestN = ""
        if apOn and dirTrav != 0 and clP.size() > 0
            for i = 0 to clP.size() - 1
                float lp = clP.get(i)
                if clR.get(i) >= inMinRank and (dirTrav == 1 ? lp > close : lp < close)
                    float dd2 = math.abs(lp - close)
                    if dd2 < bestD
                        bestD := dd2
                        bestP := lp
                        bestR2 := clR.get(i)
                        bestN := clN.get(i)
        if apOn and not na(bestP) and bestD > mrTol and bestD <= apMaxDist * tgtPts
            float netMove = math.abs(close - close[apWindow])
            float sumRng = 0.0
            for i = 0 to apWindow - 1
                sumRng += high[i] - low[i]
            float effRatio = sumRng > 0 ? netMove / sumRng : 0.0
            float speedRatio = atr14 > 0 ? netMove / (apWindow * atr14) : 0.0
            float runExt = close[apWindow]
            float maxPull = 0.0
            for i = apWindow - 1 to 0
                float c0 = close[i]
                if dirTrav == 1
                    runExt := math.max(runExt, c0)
                    maxPull := math.max(maxPull, runExt - c0)
                else
                    runExt := math.min(runExt, c0)
                    maxPull := math.max(maxPull, c0 - runExt)
            float pullPct = netMove > 0 ? maxPull / netMove * 100 : 100.0
            int alignN = 0
            for i = 0 to apWindow - 1
                float bd2 = barDelta[i]
                if (dirTrav == 1 and bd2 > 0) or (dirTrav == -1 and bd2 < 0)
                    alignN += 1
            float alignPct = 100.0 * alignN / apWindow
            string grade = effRatio >= apEffMin and speedRatio >= apSpeedMin and pullPct <= apPullMax ? "DRIVE" :
                 speedRatio <= apSpeedDrift and alignPct >= apAlignLo and alignPct <= apAlignHi ? "DRIFT" : "GRIND"
            bool freshTarget = na(apLvlP) or math.abs(bestP - apLvlP) > mrTol
            if grade != apGrade or freshTarget
                evAppr := true
                evApprTxt := "EVT=APPR|" + grade + "|target=" + bestN + " " + f_starTxt(f_stars(bestR2)) + "|dist_t=" + str.tostring(math.round(bestD / syminfo.mintick))
                if apChartLabel and freshTarget and (not apLabelDriveOnly or grade == "DRIVE")
                    apLbs.push(label.new(time, bestP, (dirTrav == 1 ? "▲ " : "▼ ") + grade, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#0d0d10, 30), textcolor = grade == "DRIVE" ? colStop : grade == "GRIND" ? colUp : #787b86, size = size.tiny, tooltip = grade == "DRIVE" ? "Fast directional arrival — break-retest favored; reversal only on a strong react score" : grade == "GRIND" ? "Rotational two-way arrival — reversal favored" : "Thin, low-participation arrival — pass or half size"))
                    if apLbs.size() > 10
                        label.delete(apLbs.shift())
            apDir := dirTrav
            apGrade := grade
            apLvlP := bestP
            apLvlR := bestR2
            apLvlN := bestN
        else
            apDir := 0
            apGrade := ""
            apLvlP := na
            apLvlR := 0.0
            apLvlN := ""
    // ── LEVEL POOL (2.6) — one working set: clusters + dynamic singletons ─
    // Rebuilt every confirmed bar. Touch engine, MR engine, HUD and the
    // execution render all read THIS. Pool index == cluster index for the
    // first clP.size() items (REACT/stamp arrays stay cluster-indexed).
    poolP.clear()
    poolLoT.clear()
    poolHiT.clear()
    poolRank.clear()
    poolName.clear()
    poolMemA.clear()
    poolMemN.clear()
    pmKey.clear()
    pmRank.clear()
    pmScope.clear()
    if not htfMode
        if clP.size() > 0
            for i = 0 to clP.size() - 1
                poolP.push(clP.get(i))
                poolLoT.push(clLoT.get(i))
                poolHiT.push(clHiT.get(i))
                poolRank.push(clR.get(i))
                poolName.push(clN.get(i))
                poolMemA.push(pmKey.size())
                poolMemN.push(clMemN.get(i))
                int a0 = clMemA.get(i)
                if clMemN.get(i) > 0
                    for m = a0 to a0 + clMemN.get(i) - 1
                        pmKey.push(memKey.get(m))
                        pmRank.push(memRank.get(m))
                        pmScope.push(memScope.get(m))
        // dynamic singletons. Step-updating levels (session extremes, ON
        // extremes, developing POC/VA) pool at their [1] snapshots — test
        // the level where the chart DREW it, and never let a bar that
        // itself makes the new extreme count as touching it. Continuous
        // VWAP/σ pool at current confirmed values, matching where plot()
        // draws them and the pre-2.6 MR pool. Toggles mirror the old pool.
        if inclVwap
            f_poolAdd(vwapV, "VWAP", 10, 1)
        if inclTwap
            f_poolAdd(twapV, "TWAP", 6, 1)
        if inclSd2
            f_poolAdd(up2, "+2σ", 6, 1)
            f_poolAdd(dn2, "-2σ", 6, 1)
        if inclDay
            f_poolAdd(sessHi[1], "sesH", 8, 1)
            f_poolAdd(sessLo[1], "sesL", 8, 1)
        if inclON
            f_poolAdd(onHi[1], "ONH", 6, 2)
            f_poolAdd(onLo[1], "ONL", 6, 2)
        if ibDone
            f_poolAdd(ibHi, "IBH", 4, 1)
            f_poolAdd(ibLo, "IBL", 4, 1)
        if inclDevMR
            f_poolAdd(devSPoc[1], "sPOC", 6, 1)
            f_poolAdd(devSVah[1], "sVAH", 4, 1)
            f_poolAdd(devSVal[1], "sVAL", 4, 1)
            f_poolAdd(devDPoc[1], "dPOC", 8, 2)
            f_poolAdd(devDVah[1], "dVAH", 6, 2)
            f_poolAdd(devDVal[1], "dVAL", 6, 2)
    // ── PENDING-TOUCH RESOLUTION (2.6) ───────────────────────────────────
    // Runs BEFORE touch detection and BEFORE any score is read this bar:
    // a break completed THIS bar is completed-bar information; this bar's
    // own touch outcome is not (that would be intra-bar future leak).
    // HOLD wins over BREAK on the same bar: a wick through the far edge
    // that closes back with travel is a sweep-and-reclaim — closes are the
    // arbiter everywhere else in this script.
    if pdBarA.size() > 0
        for j = pdBarA.size() - 1 to 0
            int age = bar_index - pdBarA.get(j)
            if age >= 1
                int pDir = pdDirA.get(j)
                float nearE = pDir == 1 ? pdLoA.get(j) : pdHiA.get(j)
                float farE = pDir == 1 ? pdHiA.get(j) : pdLoA.get(j)
                bool hold = not na(dAtr) and (pDir == 1 ? close <= nearE - inHoldTravel * dAtr : close >= nearE + inHoldTravel * dAtr)
                pdBeyA.set(j, math.max(pdBeyA.get(j), pDir == 1 ? high - farE : farE - low))
                pdCnsA.set(j, (pDir == 1 ? close > farE : close < farE) ? pdCnsA.get(j) + 1 : 0)
                bool brk = not hold and (pdCnsA.get(j) >= inAcc or (not na(dAtr) and pdBeyA.get(j) >= inBrkTravel * dAtr))
                if hold or brk
                    f_resolveKeys(pdKeysA.get(j), pDir, hold ? 1.0 : 0.0)
                if hold or brk or age >= inReactWin
                    pdDirA.remove(j)
                    pdLoA.remove(j)
                    pdHiA.remove(j)
                    pdBarA.remove(j)
                    pdCnsA.remove(j)
                    pdBeyA.remove(j)
                    pdKeysA.remove(j)
    // ── TOUCH DETECTION (2.6) — freshness counts NOW, outcome window opens,
    // REACT scores the same event. A signal fired on the touch bar must see
    // this touch in its freshness (otherwise touch N grades with touch N−1's
    // decay forever); the EWMA never moves here.
    if not htfMode and poolP.size() > 0
        float bestTchR = -1.0
        for i = 0 to poolP.size() - 1
            float zLoT = poolLoT.get(i)
            float zHiT = poolHiT.get(i)
            bool traded = high >= zLoT - mrTol and low <= zHiT + mrTol
            if traded
                // arrival side from the last confirmed close; opened inside
                // the zone → inherit an overlapping pending's direction
                int tDir = close[1] < zLoT ? 1 : close[1] > zHiT ? -1 : 0
                if tDir == 0 and pdBarA.size() > 0
                    for j = 0 to pdBarA.size() - 1
                        if pdLoA.get(j) <= zHiT and pdHiA.get(j) >= zLoT
                            tDir := pdDirA.get(j)
                if tDir != 0
                    // one interaction = one touch: suppress while an open
                    // pending with the same direction overlaps ≥50% of this
                    // zone (geometric, so it survives cluster rebuilds)
                    bool dup = false
                    if pdBarA.size() > 0
                        for j = 0 to pdBarA.size() - 1
                            if pdDirA.get(j) == tDir
                                float ovl = math.min(pdHiA.get(j), zHiT) - math.max(pdLoA.get(j), zLoT)
                                if ovl >= 0.5 * math.max(zHiT - zLoT, syminfo.mintick)
                                    dup := true
                    if not dup
                        // freshness: every member atom counts THIS touch now
                        string keysCsv = ""
                        int aM = poolMemA.get(i)
                        int nM = poolMemN.get(i)
                        if nM > 0
                            for m = aM to aM + nM - 1
                                f_touchMark(pmKey.get(m), pmScope.get(m))
                                string item = pmKey.get(m) + "," + str.tostring(pmScope.get(m))
                                keysCsv := keysCsv == "" ? item : keysCsv + ";" + item
                        // touch-bar immediate outcomes — SYMMETRIC seeds. A
                        // sweep that already closed back on the approach side
                        // with travel is a HOLD right now (the liquidity-tap
                        // rejection this method trades; letting only the wick
                        // excursion seed BREAK would book that exact bar as a
                        // BREAK — backwards). A close through the far edge
                        // already meeting the acceptance count (inAcc = 1) is
                        // a BREAK right now. Everything else opens the window.
                        int seedCns = (tDir == 1 ? close > zHiT : close < zLoT) ? 1 : 0
                        bool holdNow = not na(dAtr) and (tDir == 1 ? close <= zLoT - inHoldTravel * dAtr : close >= zHiT + inHoldTravel * dAtr)
                        if holdNow
                            f_resolveKeys(keysCsv, tDir, 1.0)
                        else if seedCns >= inAcc
                            f_resolveKeys(keysCsv, tDir, 0.0)
                        else
                            // open the outcome window (cap 12 — oldest out as NEITHER)
                            if pdBarA.size() >= 12
                                pdDirA.remove(0)
                                pdLoA.remove(0)
                                pdHiA.remove(0)
                                pdBarA.remove(0)
                                pdCnsA.remove(0)
                                pdBeyA.remove(0)
                                pdKeysA.remove(0)
                            pdDirA.push(tDir)
                            pdLoA.push(zLoT)
                            pdHiA.push(zHiT)
                            pdBarA.push(bar_index)
                            pdCnsA.push(seedCns)
                            pdBeyA.push(math.max(0.0, tDir == 1 ? high - zHiT : zLoT - low))
                            pdKeysA.push(keysCsv)
                        int arrDir = tDir
                        float lp = poolP.get(i)
                        bool ranked = poolRank.get(i) >= inMinRank
                        if ranked and i < clTch.size()
                            clTch.set(i, clTch.get(i) + 1)
                        // REACT — same evidence, same score, now fired off
                        // the unified touch event (its own detection loop
                        // and stampRearm arming are gone: one pending = one
                        // interaction = one stamp)
                        if stOn and ranked
                            // S1 · delta flip vs arrival, scaled by size
                            float avgAbsD = 0.0
                            for k = 1 to apWindow
                                avgAbsD += math.abs(barDelta[k])
                            avgAbsD /= apWindow
                            bool flip = (arrDir == 1 and barDelta < 0) or (arrDir == -1 and barDelta > 0)
                            float s1 = flip and avgAbsD > 0 ? stW1 * math.min(math.abs(barDelta) / avgAbsD, 1.0) : 0.0
                            // S2 · volume share in the extreme third (LTF hl2 bins)
                            float s2 = 0.0
                            if barRng > 0 and nZ > 0
                                float vBot = 0.0
                                float vTop = 0.0
                                float vAll = 0.0
                                for k = 0 to nZ - 1
                                    float hp = array.get(ltfH, k)
                                    float vv2 = nz(array.get(ltfV, k))
                                    if not na(hp)
                                        vAll += vv2
                                        float posK = (hp - low) / barRng
                                        if posK <= 0.3333
                                            vBot += vv2
                                        if posK >= 0.6667
                                            vTop += vv2
                                if vAll > 0
                                    float share2 = arrDir == -1 ? vBot / vAll : vTop / vAll
                                    float ramp = (share2 * 100 - 30) / math.max(stBotShare - 30, 1)
                                    s2 := stW2 * math.max(0.0, math.min(1.0, ramp))
                            // S3 · rejection structure on the close (MR's close-position read)
                            float s3 = 0.0
                            bool wickBeyond = arrDir == -1 ? low < lp : high > lp
                            bool sideOK = arrDir == -1 ? close > lp : close < lp
                            float cp = arrDir == -1 ? cPos : 1 - cPos
                            if wickBeyond and sideOK
                                s3 := cp >= inWick ? float(stW3) : cp >= 0.45 ? stW3 * 0.5 : 0.0
                            // S4 · effort/result: new price extreme, delta not confirming
                            float s4 = 0.0
                            float prevExt = arrDir == -1 ? low[1] : high[1]
                            for k = 2 to apWindow
                                prevExt := arrDir == -1 ? math.min(prevExt, low[k]) : math.max(prevExt, high[k])
                            bool newExt = arrDir == -1 ? low < prevExt : high > prevExt
                            if newExt
                                if flip
                                    s4 := float(stW4)
                                else if math.abs(barDelta) <= 0.25 * avgAbsD
                                    s4 := stW4 * 0.5
                            float wTot = stW1 + stW2 + stW3 + stW4
                            float score = wTot > 0 ? (s1 + s2 + s3 + s4) * 100.0 / wTot : 0.0
                            string band = score >= 70 ? "✓" : score >= 40 ? "–" : "✗"
                            if i < clStB.size()
                                clStB.set(i, bar_index)
                                clStV.set(i, score)
                            stLastScore := score
                            stLastBand := band
                            stLastName := poolName.get(i)
                            stLastBar := bar_index
                            // 2.7: label only the defended touches — the
                            // chart stops wallpapering 0% ✗. Score always
                            // computes; stats/gates/feed see everything.
                            if inReactShowMin == 0 or score >= inReactShowMin
                                color scol = score >= 70 ? colUp : score >= 40 ? #ffb300 : colStop
                                stLbs.push(label.new(time, arrDir == -1 ? low : high, "REACT " + str.tostring(math.round(score)) + "% " + band, xloc = xloc.bar_time, style = arrDir == -1 ? label.style_label_up : label.style_label_down, color = color.new(#0d0d10, 20), textcolor = scol, size = size.small))
                                if stLbs.size() > 20
                                    label.delete(stLbs.shift())
                            evStamp := true
                            evStampTxt := "EVT=REACT|" + syminfo.ticker + "|" + str.tostring(time) + "|level=" + poolName.get(i) + "|score=" + str.tostring(math.round(score)) + "|band=" + band
                        if ranked and poolRank.get(i) > bestTchR
                            bestTchR := poolRank.get(i)
                            int tchNo = i < clTch.size() ? clTch.get(i) : 1
                            evTouch := true
                            evTouchTxt := "EVT=TOUCH|" + syminfo.ticker + "|" + str.tostring(time) + "|level=" + poolName.get(i) + "|rank=" + str.tostring(math.round(poolRank.get(i))) + "|stars=" + str.tostring(f_stars(poolRank.get(i))) + "|price=" + str.tostring(lp, format.mintick) + "|touchNo=" + str.tostring(tchNo) + "|session=" + sessNow + "|daytype=" + dtState + "|appr=" + (apGrade == "" ? "NONE" : apGrade)

// ── SIGNAL ENGINE (execution mode · confirmed close only) ──────────────────
bool sigIBUp = false
bool sigIBDn = false
bool sigMRUp = false
bool sigMRDn = false
bool sigBRTUp = false
bool sigBRTDn = false
int fireDir = 0
string fireTag = ""
string fireLvl = ""
float fireRank = 0.0
// dynamically constructed prices (na = the firing play has no dynamic
// construction — APP/BRT). 2.7: MR and IB both build these.
float mrE = na
float mrS = na
float mrT = na
float mrR = na
string dynTag = ""

if barstate.isconfirmed and not htfMode
    if inAnySess and ibDone and not na(ibHi)
        accUp := close > ibHi ? accUp + 1 : 0
        accDn := close < ibLo ? accDn + 1 : 0
    bool gate = (not inRthOnly or inRTH) and (not inSessOnly or inAnySess) and (not useLunch or not inLunch) and (not inHardCap or sigCnt < inMaxSig) and bar_index - lastSigBar >= inCd
    // IB — the set play (priority). 2.7: fires through the SAME dynamic
    // construction as MR — entry = broken IB edge (retest resting limit),
    // structure stop inside the balance, TP1 in front of the next opposing
    // qualifying level, room gate included. Room fails → NOTRADE and the
    // per-side shot is NOT consumed (a re-acceptance retries with room).
    // No initiative/delta standdowns here — those are anti-reversal gates;
    // IB rides WITH the move.
    if enIB and gate and ibDone and not na(dAtr) and ((accUp == inAcc and firedUp < inMaxBrk) or (accDn == inAcc and firedDn < inMaxBrk))
        int ibDir = accUp == inAcc and firedUp < inMaxBrk ? 1 : -1
        string ibNm = ibDir == 1 ? "IBH" : "IBL"
        // the IB edge is always a pool singleton while ibDone (f_poolAdd)
        int ibIdx = -1
        if poolP.size() > 0
            for i = 0 to poolP.size() - 1
                if poolName.get(i) == ibNm
                    ibIdx := i
        if ibIdx >= 0
            [ie1, is1, it1, ir1, iOk] = f_construct(ibIdx, ibDir, dAtr)
            if iOk
                fireDir := ibDir
                fireTag := ibDir == 1 ? "IB ▲" : "IB ▼"
                fireLvl := ibNm + " " + str.tostring(ibDir == 1 ? ibHi : ibLo, format.mintick)
                fireRank := 4
                mrE := ie1
                mrS := is1
                mrT := it1
                mrR := ir1
                dynTag := "IB"
                if ibDir == 1
                    firedUp += 1
                else
                    firedDn += 1
            else
                evNoTrade := true
                evNoTradeTxt := "EVT=NOTRADE|reason=room|play=IB|side=" + (ibDir == 1 ? "long" : "short") + "|level=" + ibNm
    // MR — reversal at a working level. 2.6: candidates come from the
    // unified pool, gated by EFFECTIVE SCORE (arrival direction), the
    // initiative/delta standdowns, then DYNAMIC CONSTRUCTION + room gate.
    // Direction table: long fire = price arrived fromAbove (|A) = -bD.
    if enMR and gate and fireDir == 0 and poolP.size() > 0 and not na(dAtr)
        float bScore = 0.0
        int bD = 0
        int bIdx = -1
        for i = 0 to poolP.size() - 1
            int d = f_mrTest(poolP.get(i))
            if d != 0
                float eff = f_poolScore(i, -d)
                if eff >= f_tierTrd() and eff > bScore
                    bScore := eff
                    bD := d
                    bIdx := i
        if bD != 0
            bool volOK = not useVolMR or na(volume) or relVol >= volKMR
            // opt-in stamp gate (unchanged; cluster items only)
            bool stampOK = true
            if stampGateMR and stOn and bIdx < clStB.size()
                float needStamp = stampMinMR + (stampDriveStrict and apGrade == "DRIVE" ? 10 : 0)
                stampOK := clStB.get(bIdx) >= 0 and bar_index - clStB.get(bIdx) <= 1 and nz(clStV.get(bIdx), 0) >= needStamp
            // initiative standdown (§5.3) — don't step in front of a train:
            // approach velocity and consecutive closes INTO the level
            float vel = math.abs(close - close[inApprBars]) / inApprBars
            bool velOK = vel <= inVMax * dAtr
            // streak as of the bar BEFORE the trigger — the rejection bar
            // itself usually closes against the approach and would zero the
            // very streak this gate exists to measure
            bool strkOK = (bD == 1 ? dnStrk[1] : upStrk[1]) <= inCMax
            // delta standdown (§5.4) — one-sided initiative flow into the
            // level with the approach = absorption absent. Filter, not
            // trigger; the scripted stand-in for the manual footprint read.
            bool deltaOK = true
            if useLtfDelta
                // the APPROACH window ([1..n]) — the trigger bar's own
                // flipped delta is the rejection, not the arrival, and
                // including it dilutes the hostile flow it filters for
                float dSum = 0.0
                float vSum = 0.0
                for k = 1 to inApprBars
                    dSum += barDelta[k]
                    vSum += barVolUD[k]
                float nd = vSum > 0 ? dSum / vSum : 0.0
                deltaOK := (bD == 1 ? -nd : nd) < inDMax
            if volOK and stampOK and velOK and strkOK and deltaOK
                [ce, cs, ct, cr, roomOk] = f_construct(bIdx, bD, dAtr)
                if roomOk
                    fireDir := bD
                    fireTag := bD == 1 ? "MR ▲" : "MR ▼"
                    fireLvl := poolName.get(bIdx) + " " + str.tostring(math.round(bScore, 1)) + "★ @ " + str.tostring(poolP.get(bIdx), format.mintick)
                    fireRank := bScore
                    mrE := ce
                    mrS := cs
                    mrT := ct
                    mrR := cr
                    dynTag := "MR"
                else
                    // room gate failed at the FIRST opposing qualifying
                    // level — NO TRADE, never target through a working
                    // level (see money, take money)
                    evNoTrade := true
                    evNoTradeTxt := "EVT=NOTRADE|reason=room|side=" + (bD == 1 ? "long" : "short") + "|level=" + poolName.get(bIdx) + "|score=" + str.tostring(math.round(bScore))
    // APP — toward play: ride INTO a powerful level inside the approach window
    if enAPP and gate and fireDir == 0
        array<float> ap = array.new<float>()
        array<float> ark = array.new<float>()
        array<string> anm = array.new<string>()
        if clP.size() > 0
            for i = 0 to clP.size() - 1
                float rEffA = clR.get(i) + (f_inZone(clP.get(i)) != 0 ? inImbBonus : 0)
                if rEffA >= inAppRank
                    ap.push(clP.get(i))
                    ark.push(rEffA)
                    anm.push(clN.get(i) + (rEffA > clR.get(i) ? "◆" : ""))
        if inAppDyn
            if not na(vwapV) and 10 >= inAppRank
                ap.push(vwapV)
                ark.push(10)
                anm.push("VWAP")
            if not na(sessHi[1]) and 8 >= inAppRank
                ap.push(sessHi[1])
                ark.push(8)
                anm.push("sesH")
                ap.push(sessLo[1])
                ark.push(8)
                anm.push("sesL")
            float tDPoc2 = devDPoc[1]
            if not na(tDPoc2) and 8 >= inAppRank
                ap.push(tDPoc2)
                ark.push(8)
                anm.push("dPOC")
            if not na(up2) and 6 >= inAppRank
                ap.push(up2)
                ark.push(6)
                anm.push("+2σ")
                ap.push(dn2)
                ark.push(6)
                anm.push("-2σ")
            if not na(onHi) and 6 >= inAppRank
                ap.push(onHi)
                ark.push(6)
                anm.push("ONH")
                ap.push(onLo)
                ark.push(6)
                anm.push("ONL")
        float aBestR = 0.0
        float aBestD = 1.0e18
        float aLvl = na
        string aNm = ""
        int aDir = 0
        if ap.size() > 0
            for i = 0 to ap.size() - 1
                float lvl = ap.get(i)
                float dToL = math.abs(lvl - close)
                if dToL >= inAppNear * tgtPts and dToL <= inAppFar * tgtPts
                    int dirT = lvl > close ? 1 : -1
                    bool withMove = dirT == 1 ? close > cPrev and cPos >= inAppPos : close < cPrev and cPos <= 1 - inAppPos
                    bool untouched = dirT == 1 ? appHiN < lvl - mrTol : appLoN > lvl + mrTol
                    bool freshLvl = true
                    if appFired.size() > 0
                        for j = 0 to appFired.size() - 1
                            if math.abs(lvl - appFired.get(j)) <= mrTol
                                freshLvl := false
                    bool better = ark.get(i) > aBestR or (ark.get(i) == aBestR and dToL < aBestD)
                    if withMove and untouched and freshLvl and better
                        aBestR := ark.get(i)
                        aBestD := dToL
                        aLvl := lvl
                        aNm := anm.get(i)
                        aDir := dirT
        if aDir != 0
            // 2.9: APP is ADVISORY — a with-move ride into a wall has no
            // structure behind the entry, so it gets a read, not a ticket.
            // Was the last play still emitting fixed-tick E/S/T; killing
            // that ends the "stamped +32t while T1 sits higher" confusion.
            // No count, no plan lines, no alert — dim label + one-shot per
            // level only.
            appFired.push(aLvl)
            apLbs.push(label.new(time, aDir == 1 ? low : high, (aDir == 1 ? "APP ▲ → " : "APP ▼ → ") + aNm, xloc = xloc.bar_time, style = aDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(#0d0d10, 40), textcolor = aDir == 1 ? colUp : colDn, size = size.tiny, tooltip = f_scoreTxt(aBestR) + " " + aNm + " @ " + str.tostring(aLvl, format.mintick) + " — advisory: riding toward the level; the reaction THERE is the next decision"))
            if apLbs.size() > 10
                label.delete(apLbs.shift())
    // BRT — punched cluster, retest holds → continuation
    if enBRT and clP.size() > 0
        for i = 0 to clP.size() - 1
            if clR.get(i) >= inMinRank
                int st = clSt.get(i)
                float p = clP.get(i)
                if st == 0
                    // 2.9.2: a BREAK is ACCEPTANCE (inAcc consecutive closes
                    // beyond the escape margin, same standard as IB) — one
                    // close poking through is chop, and chop was firing
                    // wick-through-VWAP "retests" that were nothing.
                    int acc = i < clAcc.size() ? clAcc.get(i) : 0
                    acc := close > p + brtEsc ? math.max(acc, 0) + 1 : close < p - brtEsc ? math.min(acc, 0) - 1 : 0
                    if i < clAcc.size()
                        clAcc.set(i, acc)
                    if acc >= inAcc
                        clSt.set(i, 1)
                        clEB.set(i, bar_index)
                    else if acc <= -inAcc
                        clSt.set(i, 2)
                        clEB.set(i, bar_index)
                else if st == 1
                    if close < p
                        clSt.set(i, 0)
                        if i < clAcc.size()
                            clAcc.set(i, 0)
                    else if bar_index - clEB.get(i) > inBrtWatch
                        clSt.set(i, 3)
                    // retest quality (2.9.2): separation from the break
                    // (min gap bars) + depth (low reaches within half a
                    // cluster width of the level) + rejection close (same
                    // wick standard as MR) + EffScore ≥ the regime trade
                    // floor from the approach side.
                    else if bar_index - clEB.get(i) >= brtMinGap and low <= p + clustWv * 0.5 and close > p and cPos >= inWick and gate and fireDir == 0 and not na(dAtr) and i < poolP.size() and f_poolScore(i, -1) >= f_tierTrd()
                        // 2.8: BRT fires through dynamic construction —
                        // pool idx == cluster idx for cluster items. Room
                        // fails → NOTRADE, state stays 1 so a later retest
                        // inside the watch window can retry with room.
                        [be1, bs1, bt1, br1, bOk] = f_construct(i, 1, dAtr)
                        if bOk
                            clSt.set(i, 3)
                            fireDir := 1
                            fireTag := "BRT ▲"
                            fireLvl := clN.get(i) + " " + str.tostring(math.round(f_poolScore(i, -1), 1)) + "★ @ " + str.tostring(p, format.mintick)
                            fireRank := clR.get(i)
                            mrE := be1
                            mrS := bs1
                            mrT := bt1
                            mrR := br1
                            dynTag := "BRT"
                        else
                            evNoTrade := true
                            evNoTradeTxt := "EVT=NOTRADE|reason=room|play=BRT|side=long|level=" + clN.get(i)
                else if st == 2
                    if close > p
                        clSt.set(i, 0)
                        if i < clAcc.size()
                            clAcc.set(i, 0)
                    else if bar_index - clEB.get(i) > inBrtWatch
                        clSt.set(i, 3)
                    else if bar_index - clEB.get(i) >= brtMinGap and high >= p - clustWv * 0.5 and close < p and cPos <= 1 - inWick and gate and fireDir == 0 and not na(dAtr) and i < poolP.size() and f_poolScore(i, 1) >= f_tierTrd()
                        [be2, bs2, bt2, br2, bOk2] = f_construct(i, -1, dAtr)
                        if bOk2
                            clSt.set(i, 3)
                            fireDir := -1
                            fireTag := "BRT ▼"
                            fireLvl := clN.get(i) + " " + str.tostring(math.round(f_poolScore(i, 1), 1)) + "★ @ " + str.tostring(p, format.mintick)
                            fireRank := clR.get(i)
                            mrE := be2
                            mrS := bs2
                            mrT := bt2
                            mrR := br2
                            dynTag := "BRT"
                        else
                            evNoTrade := true
                            evNoTradeTxt := "EVT=NOTRADE|reason=room|play=BRT|side=short|level=" + clN.get(i)
    // ── day-type play matrix (opt-in; OFF = untouched) ───────────────────
    // Strong trend: bench counter-trend reversals, bench counter-trend
    // break-retest/APP. Balance: bench break-retest and APP. TRANSITION:
    // bench nothing. With-trend reversal exception: rank ≥ 8 + fresh stamp
    // ≥ 70 rides anyway.
    bool benched = false
    if dtGateMode != "OFF" and fireDir != 0
        string firePlay = str.replace(str.replace(fireTag, " ▲", ""), " ▼", "")
        bool longSide = fireDir == 1
        bool trendUp = dtState == "TREND▲"
        bool trendDn = dtState == "TREND▼"
        bool withTrend = (trendUp and longSide) or (trendDn and not longSide)
        if trendUp or trendDn
            if firePlay == "MR"
                benched := true
                if withTrend and dtTrendMrException and fireRank >= 8 and not na(stLastScore) and stLastScore >= 70 and bar_index - nz(stLastBar, -999) <= 1
                    benched := false
            else
                benched := not withTrend
        else if dtState == "BALANCE"
            benched := firePlay == "BRT" or firePlay == "APP"
    if benched and dtGateMode == "ENFORCE"
        evBench := true
        evBenchTxt := "EVT=BENCHED|play=" + str.replace(str.replace(fireTag, " ▲", ""), " ▼", "") + "|side=" + (fireDir == 1 ? "long" : "short") + "|reason=daytype"
        fireDir := 0
    bool benchAdv = benched and dtGateMode == "ADVISORY"
    if benchAdv
        evBench := true
        evBenchTxt := "EVT=BENCHED|play=" + str.replace(str.replace(fireTag, " ▲", ""), " ▼", "") + "|side=" + (fireDir == 1 ? "long" : "short") + "|reason=daytype"
    // signal validity: after validBars the emitted prices are stale (§4)
    if sigDir != 0 and bar_index - nz(sigBorn, -99999) >= inValidBars
        sigDir := 0
    // fire: count, ONE signal label, trade plan lines. 2.7: MR AND IB alert
    // (limit-ticket pipe format, dynamic construction); APP/BRT detect +
    // draw silently.
    if fireDir != 0
        sigCnt += 1
        lastSigBar := bar_index
        bool isDynFire = not na(mrE)
        float pe = isDynFire ? mrE : close
        float ps = isDynFire ? mrS : pe - fireDir * stopPts
        float pt = isDynFire ? mrT : pe + fireDir * tgtPts
        if isDynFire
            if dynTag == "IB"
                sigIBUp := fireDir == 1
                sigIBDn := fireDir == -1
            else if dynTag == "BRT"
                sigBRTUp := fireDir == 1
                sigBRTDn := fireDir == -1
            else
                sigMRUp := fireDir == 1
                sigMRDn := fireDir == -1
            sigDir := fireDir
            sigPlay := dynTag
            sigE := pe
            sigS := ps
            sigT := pt
            sigR := mrR
            sigBorn := bar_index
            sigLvlTxt := fireLvl
            // §8 — one line, pipe-delimited, keyed straight into limit tickets
            alert("SKULD|" + (fireDir == 1 ? "BUY " : "SELL ") + dynTag + "|" + syminfo.ticker + "|E:" + str.tostring(pe, format.mintick) + "|S:" + str.tostring(ps, format.mintick) + "|T1:" + str.tostring(pt, format.mintick) + "|R:" + str.tostring(mrR, "#.##") + "|LVL:" + fireLvl + "|" + str.format_time(time, "yyyy-MM-dd HH:mm", TZ) + (inCold ? "|COLD HOUR" : ""), alert.freq_once_per_bar_close)
        else
            // any newer fire supersedes the HUD signal — the plan lines now
            // belong to this play, a stale E/S/T1 block would disagree
            sigDir := 0
        // one label per signal — play, direction, score. Brand color block,
        // stays on the chart as the day's signal trail. Details live in the
        // alert text and the plan lines, not in chart clutter.
        label.new(time, fireDir == 1 ? low : high, fireTag + (benchAdv ? " BENCH" : ""), xloc = xloc.bar_time, style = fireDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(fireDir == 1 ? colUp : colDn, benchAdv ? 70 : 0), textcolor = fireDir == 1 ? color.black : color.white, size = sigSz, tooltip = fireLvl)
        if showPlan
            if not na(planE)
                line.delete(planE)
            if not na(planS)
                line.delete(planS)
            if not na(planT)
                line.delete(planT)
            if not na(planRes)
                label.delete(planRes)
            planE := line.new(time, pe, time, pe, xloc = xloc.bar_time, color = colText, width = 2)
            planS := line.new(time, ps, time, ps, xloc = xloc.bar_time, color = colStop, style = line.style_dashed)
            planT := line.new(time, pt, time, pt, xloc = xloc.bar_time, color = colUp, style = line.style_dotted)
            planDir := fireDir
            planSp := ps
            planTp := pt
            planEp := pe
            planFilled := false
            planOn := true
    // manage the live plan: extend with price, terminate + stamp outcome on hit
    // 2.9.1 SIGNAL LIFECYCLE — the ticket is a RESTING LIMIT; track it like
    // one. Fill first (price returns to E), then SL/TP. Price tags T1 without
    // ever filling = the move left without you: kill ticket AND HUD signal
    // instantly (back to WAITING, next levels showing) with a dim RAN stamp.
    // No fill = no win/loss — unfilled tickets can no longer stamp "TP ✓".
    if planOn and fireDir == 0
        line.set_x2(planE, time)
        line.set_x2(planS, time)
        line.set_x2(planT, time)
        bool fillHit = planDir > 0 ? low <= planEp : high >= planEp
        bool slHit = planDir > 0 ? low <= planSp : high >= planSp
        bool tpHit = planDir > 0 ? high >= planTp : low <= planTp
        if not planFilled and not fillHit and tpHit
            // ran to target unfilled — money train left the station
            planOn := false
            sigDir := 0
            if not na(planRes)
                label.delete(planRes)
            planRes := label.new(time, planTp, "RAN — unfilled", xloc = xloc.bar_time, style = planDir > 0 ? label.style_label_down : label.style_label_up, color = color.new(#0d0d10, 40), textcolor = #787b86, size = size.small, tooltip = "Price hit T1 before ever returning to the entry limit. No trade — signal cleared.")
        else
            if fillHit
                planFilled := true
            if planFilled and (slHit or tpHit)
                planOn := false
                sigDir := 0
                if not na(planRes)
                    label.delete(planRes)
                bool win = tpHit and not slHit
                // stamp the TICKET'S OWN distances — the outcome label must
                // match the lines it sat between
                int tpTk = int(math.round(math.abs(planTp - nz(planEp, planTp)) / syminfo.mintick))
                int slTk = int(math.round(math.abs(nz(planEp, planSp) - planSp) / syminfo.mintick))
                string resTxt = slHit and tpHit ? "TP+SL same bar — check" : win ? "TP ✓ +" + str.tostring(tpTk) + "t" : "SL ✗ -" + str.tostring(slTk) + "t"
                planRes := label.new(time, win ? planTp : planSp, resTxt, xloc = xloc.bar_time, style = win ? label.style_label_up : label.style_label_down, color = color.new(win ? colUp : colStop, 20), textcolor = win ? color.black : color.white, size = size.small)
            else if not inAnySess
                planOn := false
                sigDir := 0

// ── PLOTS ──────────────────────────────────────────────────────────────────
plot(showVwap and not htfMode ? vwapV : na, "VWAP", color = colVwap, linewidth = 2, style = plot.style_linebr)
plot(inclTwap and not htfMode ? twapV : na, "TWAP", color = color.new(colVwap, 45), style = plot.style_linebr)
plot(showVwap and not htfMode ? up1 : na, "+1σ", color = color.new(colBand, 40), style = plot.style_linebr)
plot(showVwap and not htfMode ? dn1 : na, "-1σ", color = color.new(colBand, 40), style = plot.style_linebr)
plot(showVwap and showSd2 and not htfMode ? up2 : na, "+2σ", color = color.new(colBand, 15), style = plot.style_linebr)
plot(showVwap and showSd2 and not htfMode ? dn2 : na, "-2σ", color = color.new(colBand, 15), style = plot.style_linebr)
plot(showOn and not htfMode and (inRTH or inON) ? onHi : na, "ONH", color = colOn, style = plot.style_linebr)
plot(showOn and not htfMode and (inRTH or inON) ? onLo : na, "ONL", color = colOn, style = plot.style_linebr)
plot(not htfMode and inRTH and not na(ibHi) ? ibHi : na, "IBH", color = color.new(colDn, 30), style = plot.style_linebr)
plot(not htfMode and inRTH and not na(ibLo) ? ibLo : na, "IBL", color = color.new(colDn, 30), style = plot.style_linebr)

// signal marks are label.new at fire time now (one clean block per signal) —
// the six plotshape triangles are gone, and their plot-budget slots with them.

// ── RENDER · DEVELOPING LEVELS (last bar) ──────────────────────────────────
var array<line> devLn = array.new<line>()
var array<label> devLb = array.new<label>()
f_devDraw(float px, string nm, int rank, int t0, color cc, int wd) =>
    if not na(px)
        int x1 = na(t0) ? time - 30 * barMs : t0
        devLn.push(line.new(x1, px, time + inOff * barMs, px, xloc = xloc.bar_time, color = cc, style = line.style_dotted, width = wd))
        string txt = f_scoreTxt(rank) + " " + nm + (showPx ? "  " + str.tostring(px, format.mintick) : "") + " · " + str.tostring(math.abs(close - px), format.mintick)
        devLb.push(label.new(time + inOff * barMs, px, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))
    true

if barstate.islast
    if devLn.size() > 0
        for l in devLn
            line.delete(l)
    devLn.clear()
    if devLb.size() > 0
        for lb in devLb
            label.delete(lb)
    devLb.clear()
    if not htfMode
        int sessT0 = inRTH ? nT0 : inL ? lT0 : inA ? aT0 : na
        if showDevS
            f_devDraw(devSPoc, "sPOC", 6, sessT0, colVpPoc, 2)
            f_devDraw(devSVah, "sVAH", 4, sessT0, colDevVa, 1)
            f_devDraw(devSVal, "sVAL", 4, sessT0, colDevVa, 1)
        if showDevD
            f_devDraw(devDPoc, "dPOC", 8, dT0, colS4, 2)
            f_devDraw(devDVah, "dVAH", 6, dT0, colS3, 1)
            f_devDraw(devDVal, "dVAL", 6, dT0, colS3, 1)

// ── RENDER · VOLUME PROFILE HISTOGRAM (last bar) ───────────────────────────
var array<box> vpBx = array.new<box>()
if barstate.islast
    if vpBx.size() > 0
        for b in vpBx
            box.delete(b)
    vpBx.clear()
    if inVpStyle == "Bars"
        Prof src = dP
        int anch = dT0
        if inVpSrc == "Week" or (inVpSrc == "Auto" and htfMode)
            src := wP
            anch := wT0
        else if inVpSrc == "Session" or (inVpSrc == "Auto" and not htfMode)
            if inRTH
                src := nP
                anch := nT0
            else if inL
                src := lP
                anch := lT0
            else if inA
                src := aP
                anch := aT0
        [rv, lo, rowH, tot, pocI, uI, dI] = f_rows(src, inVpRows)
        if tot > 0 and not na(rowH)
            float mx = array.max(rv)
            bool rightAnch = inVpAnchor == "Right edge"
            int xR = time + (inOff - 1) * barMs
            int xL = na(anch) ? time - inVpWide * barMs : anch
            for i = 0 to inVpRows - 1
                float v0 = rv.get(i)
                if v0 > 0
                    int wBars = math.max(1, int(math.round(v0 / mx * inVpWide)))
                    bool inVa = i > dI and i < uI
                    color cc = i == pocI ? colVpPoc : inVa ? colVpVa : colVpOut
                    int bx1 = rightAnch ? xR - wBars * barMs : xL
                    int bx2 = rightAnch ? xR : xL + wBars * barMs
                    vpBx.push(box.new(bx1, lo + (i + 1) * rowH, bx2, lo + i * rowH, xloc = xloc.bar_time, bgcolor = color.new(cc, inVpTr), border_color = color.new(cc, 100)))

// ── RENDER · CLUSTER MAP (last bar) ────────────────────────────────────────
var array<line> clLn = array.new<line>()
var array<label> clLb = array.new<label>()
if barstate.islast
    if clLn.size() > 0
        for l in clLn
            line.delete(l)
    clLn.clear()
    if clLb.size() > 0
        for lb in clLb
            label.delete(lb)
    clLb.clear()
    if showLvls and htfMode and clP.size() > 0
        // STRUCTURE mode: the full ranked map, unchanged since 2.5
        array<float> dst = array.new<float>()
        for i = 0 to clP.size() - 1
            dst.push(math.abs(close - clP.get(i)))
        array<int> ord = array.sort_indices(dst)
        int shown = 0
        for r = 0 to ord.size() - 1
            int i = ord.get(r)
            float d = dst.get(i)
            if (inHide == 0 or d <= inHide) and shown < inMaxL
                shown += 1
                int stx = f_stars(clR.get(i))
                color cc = f_starCol(stx)
                int wd = clS.get(i) == 3 ? inWidW : clS.get(i) == 2 ? inWidD : inWidS
                float y = clP.get(i)
                clLn.push(line.new(math.max(bar_index - 30, 0), y, bar_index + inOff, y, color = cc, style = prSty, width = wd))
                // ◆ = cluster sits inside a live imbalance zone (rank bonus active)
                string zTag = f_inZone(y) != 0 ? " ◆" : ""
                string txt = f_scoreTxt(clR.get(i)) + zTag + " " + clN.get(i) + (showPx ? "  " + str.tostring(y, format.mintick) : "") + " · " + str.tostring(d, format.mintick)
                clLb.push(label.new(bar_index + inOff, y, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))
    if showLvls and not htfMode and poolP.size() > 0
        // EXECUTION mode (2.6): ONLY the levels in play — the nearest K
        // qualifying items above and K below price, where qualifying =
        // EffScore for the side price would arrive from ≥ the regime's
        // display floor. Spent levels decay off this chart by design.
        array<float> exDst = array.new<float>()
        array<int> exIdx = array.new<int>()
        array<int> exDir = array.new<int>()
        array<float> exEff = array.new<float>()
        for i = 0 to poolP.size() - 1
            float y0 = poolP.get(i)
            int dirA = y0 > close ? 1 : -1        // above price → arrives fromBelow
            float eff0 = f_poolScore(i, dirA)
            if eff0 >= f_tierDisp()
                exDst.push(math.abs(y0 - close))
                exIdx.push(i)
                exDir.push(dirA)
                exEff.push(eff0)
        if exIdx.size() > 0
            array<int> exOrd = array.sort_indices(exDst)
            int nUp = 0
            int nDn = 0
            for r = 0 to exOrd.size() - 1
                int k0 = exOrd.get(r)
                int i = exIdx.get(k0)
                int dirA = exDir.get(k0)
                bool room = dirA == 1 ? nUp < inShowK : nDn < inShowK
                if room
                    if dirA == 1
                        nUp += 1
                    else
                        nDn += 1
                    float y = poolP.get(i)
                    float eff = exEff.get(k0)
                    color cc = f_starCol(f_stars(eff))
                    // width from the strongest member's scope
                    int mScMax = 1
                    int aR = poolMemA.get(i)
                    if poolMemN.get(i) > 0
                        for m = aR to aR + poolMemN.get(i) - 1
                            mScMax := math.max(mScMax, pmScope.get(m))
                    int wd = mScMax == 3 ? inWidW : mScMax == 2 ? inWidD : inWidS
                    clLn.push(line.new(math.max(bar_index - 30, 0), y, bar_index + inOff, y, color = cc, style = prSty, width = wd))
                    // record = the strongest member's H/B history for the
                    // approach direction; ◆ = live imbalance-zone bonus
                    string recKey = ""
                    float recRank = -1.0
                    int recScope = 1
                    if poolMemN.get(i) > 0
                        for m = aR to aR + poolMemN.get(i) - 1
                            if pmRank.get(m) > recRank
                                recRank := pmRank.get(m)
                                recKey := pmKey.get(m)
                                recScope := pmScope.get(m)
                    string zTag = f_inZone(y) != 0 ? " ◆" : ""
                    string txt = poolName.get(i) + zTag + (showPx ? " " + str.tostring(y, format.mintick) : "") + " · " + str.tostring(math.round(math.abs(y - close) / syminfo.mintick)) + "t · " + str.tostring(math.round(eff, 1)) + "★ · " + f_recordTxt(recKey, dirA, recScope)
                    clLb.push(label.new(bar_index + inOff, y, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cc, size = size.small))

// ── DASHBOARD ──────────────────────────────────────────────────────────────
// Position is user-picked (he parks it away from the chart he's running).
f_dashPos() =>
    inDashPos == "Top left" ? position.top_left : inDashPos == "Bottom right" ? position.bottom_right : inDashPos == "Bottom left" ? position.bottom_left : position.top_right

// 2.6: the old 13-row system panel is DIAGNOSTICS now (showDebugHud) with a
// REGIME row appended; the default HUD below it is trade-entry info only.
var table dash = showDash and showDebugHud ? table.new(f_dashPos(), 2, 14, bgcolor = color.new(#0d0d10, 8), border_width = 1, border_color = color.new(#673ab7, 55)) : table(na)
if showDash and showDebugHud and barstate.islast
    // brand states: neon green good · amber forming · red blocked/over ·
    // cyan info · purple structure · gray off
    color okC   = #00ff00
    color offC  = #787b86
    color warnC = #ffb300
    color badC  = #ef5350
    color infC  = #00bcd4
    color strC  = #673ab7
    f_row(dash, 0, "MODE", htfMode ? "STRUCTURE ≥" + inModeTf : "EXECUTION <" + inModeTf, htfMode ? strC : okC)
    f_row(dash, 1, "TUNE", (isES ? "ES" : "NQ") + " · dATR " + (na(dAtr) ? "—" : str.tostring(dAtr, format.mintick)) + " · W " + str.tostring(clustWv, format.mintick) + " · " + f_tierName(), offC)
    f_row(dash, 2, "SESSION", sessNow, inAnySess ? okC : offC)
    // the market-condition read: which playbook is live
    string dtTxt = not dtOn ? "—" : dtState + " · T" + (dtT >= 0 ? "+" : "") + str.tostring(dtT) + (dtGateOK ? "" : " · thin")
    color dtCol = not dtOn ? offC : dtState == "TREND▲" ? okC : dtState == "TREND▼" ? badC : dtState == "BALANCE" ? infC : offC
    f_row(dash, 3, "DAY TYPE", dtTxt, dtCol)
    string ibTxt = htfMode ? "—" : ibDone and not na(ibHi) ? str.tostring(ibHi - ibLo, format.mintick) + (firedUp > 0 ? " ▲" : firedDn > 0 ? " ▼" : "") : inIBw ? "forming" : "waiting"
    f_row(dash, 4, "IB", ibTxt, ibDone ? okC : inIBw ? warnC : offC)
    // nearest = clusters AND developing levels — the live map in one row
    string nearTxt = "building"
    float bd = 1.0e18
    string bn = ""
    int br = 0
    int nearClIdx = -1
    if clP.size() > 0
        for i = 0 to clP.size() - 1
            float d = math.abs(close - clP.get(i))
            if d < bd
                bd := d
                bn := clN.get(i)
                br := int(clR.get(i))
                nearClIdx := i
    if not na(devSPoc) and math.abs(close - devSPoc) < bd
        bd := math.abs(close - devSPoc)
        bn := "sPOC"
        br := 6
        nearClIdx := -1
    if not na(devSVah) and math.abs(close - devSVah) < bd
        bd := math.abs(close - devSVah)
        bn := "sVAH"
        br := 4
        nearClIdx := -1
    if not na(devSVal) and math.abs(close - devSVal) < bd
        bd := math.abs(close - devSVal)
        bn := "sVAL"
        br := 4
        nearClIdx := -1
    if not na(devDPoc) and math.abs(close - devDPoc) < bd
        bd := math.abs(close - devDPoc)
        bn := "dPOC"
        br := 8
        nearClIdx := -1
    if not na(devDVah) and math.abs(close - devDVah) < bd
        bd := math.abs(close - devDVah)
        bn := "dVAH"
        br := 6
        nearClIdx := -1
    if not na(devDVal) and math.abs(close - devDVal) < bd
        bd := math.abs(close - devDVal)
        bn := "dVAL"
        br := 6
        nearClIdx := -1
    // approach read — its own row, or swapped into NEAREST on request
    bool apActive = apGrade != "" and not htfMode
    string apTxt = apActive ? (apDir == 1 ? "▲ " : "▼ ") + apGrade + " → " + f_starTxt(f_stars(apLvlR)) + " " + str.tostring(apLvlP, format.mintick) + " · " + str.tostring(math.round(math.abs(apLvlP - close) / syminfo.mintick)) + "t" : "—"
    if bn != ""
        // touch counter rides the nearest cluster: ·T2 = second touch today
        string tchTag = nearClIdx >= 0 and nearClIdx < clTch.size() and clTch.get(nearClIdx) > 1 ? " ·T" + str.tostring(clTch.get(nearClIdx)) : ""
        nearTxt := f_scoreTxt(br) + " " + bn + " · " + str.tostring(bd, format.mintick) + tchTag
    f_row(dash, 5, "NEAREST", apReplaceNearest and apActive ? apTxt : nearTxt, infC)
    string sPocTxt = na(devSPoc) ? "building" : str.tostring(devSPoc, format.mintick) + " · " + str.tostring(math.abs(close - devSPoc), format.mintick)
    f_row(dash, 6, "sPOC", sPocTxt, na(devSPoc) ? offC : close > devSPoc ? okC : badC)
    // live imbalance zones + nearest zone edge — the resting-interest row
    string imbTxt = "—"
    if enImb and imbLo.size() > 0
        int zB = 0
        int zS = 0
        float zNear = 1.0e18
        for i = 0 to imbLo.size() - 1
            if imbDir.get(i) == 1
                zB += 1
            else
                zS += 1
            float dEdge = close > imbHi.get(i) ? close - imbHi.get(i) : close < imbLo.get(i) ? imbLo.get(i) - close : 0.0
            zNear := math.min(zNear, dEdge)
        imbTxt := "▲" + str.tostring(zB) + " · ▼" + str.tostring(zS) + " · " + (zNear == 0 ? "INSIDE" : str.tostring(zNear, format.mintick))
    f_row(dash, 7, "IMB", imbTxt, not enImb or imbLo.size() == 0 ? offC : f_inZone(close) != 0 ? warnC : infC)
    // how price is arriving at the next ranked cluster
    f_row(dash, 8, "APPR", apReplaceNearest ? "—" : apTxt, not apActive ? offC : apGrade == "DRIVE" ? badC : apGrade == "GRIND" ? okC : warnC)
    // last touch stamp: score · level · age
    string stTxt = na(stLastScore) or htfMode ? "—" : str.tostring(math.round(stLastScore)) + "% " + stLastBand + " · " + stLastName + " · " + str.tostring(bar_index - stLastBar) + "b ago"
    f_row(dash, 9, "REACT", stTxt, na(stLastScore) or htfMode ? offC : stLastScore >= 70 ? okC : stLastScore >= 40 ? warnC : badC)
    // the hour read — where the ledger says the money lives vs bleeds
    string ckTxt = inPrime ? "PRIME" : inCold ? "COLD" : "NEUTRAL"
    f_row(dash, 10, "CLOCK", ckTxt, inPrime ? okC : inCold ? badC : offC)
    f_row(dash, 11, "SIGNALS", str.tostring(sigCnt) + "/" + str.tostring(inMaxSig) + (sigCnt >= inMaxSig ? (inHardCap ? " DONE" : " ≥PLAN") : ""), sigCnt >= inMaxSig ? badC : okC)
    string fTxt = htfMode ? "map only" : useLunch and inLunch ? "LUNCH" : not inRTH ? "OFF-SESSION" : "CLEAR"
    f_row(dash, 12, "FILTER", fTxt, fTxt == "CLEAR" ? okC : fTxt == "map only" ? strC : badC)
    string rgTxt = f_tierName() + (na(atrPct) ? "" : " · " + str.tostring(math.round(atrPct)) + "pct") + (na(dAtr) ? "" : " · dATR " + str.tostring(dAtr, format.mintick)) + (useVix and not na(vixD) ? " · VIX " + str.tostring(vixD, "#.#") : "")
    f_row(dash, 13, "REGIME", rgTxt, tier >= 3 ? badC : tier == 2 ? warnC : tier == 0 ? infC : okC)

// ── HUD (2.8 · deck spec) — trade-entry information ONLY ───────────────────
// Header row: SKULD · SYMBOL TF | state (WAITING amber · SIGNAL side color ·
// STRUCTURE purple). WAITING: aligned columns — side+name · price · dist ·
// score — ▲ short zone in purple, ▼ long zone in green, ROOM row carries the
// available ticks per side. SIGNAL: boxed side block, labeled E/S/T1/R grid
// (S red · T1 green · R cyan), VALID as a clock. Table is deleted + rebuilt
// on the last bar so merges/stale cells can never leak between states.
f_shortNm(string nm) =>
    str.length(nm) > 16 ? str.substring(nm, 0, 15) + "…" : nm
f_tfTxt() =>
    timeframe.isseconds ? timeframe.period + "s" : timeframe.isminutes ? timeframe.period + "m" : timeframe.period
var table hud = table(na)
if showDash and not showDebugHud and barstate.islast
    if not na(hud)
        table.delete(hud)
    hud := table.new(f_dashPos(), 4, 5, bgcolor = color.new(#0d0d10, 6), frame_width = 1, frame_color = color.new(#673ab7, 45))
    color hOk = #00ff00
    color hBad = #ef5350
    color hDim = #787b86
    color hAmb = #ffb300
    color hCyn = #00bcd4
    color hGold = #ffd54f
    color hCard = color.new(#0d0d10, 6)
    // header: identity left, state right
    string headL = "SKULD · " + syminfo.ticker + " " + f_tfTxt()
    string hState = htfMode ? "STRUCTURE" : sigDir != 0 ? "SIGNAL" : "WAITING"
    color hStCol = htfMode ? colDn : sigDir != 0 ? (sigDir == 1 ? hOk : colDn) : hAmb
    table.cell(hud, 0, 0, headL, text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
    table.merge_cells(hud, 0, 0, 2, 0)
    table.cell(hud, 3, 0, hState, text_color = hStCol, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
    if not htfMode and sigDir != 0
        // ── SIGNAL ──
        int leftBars = math.max(0, inValidBars - (bar_index - sigBorn))
        int vSecs = leftBars * tfSec
        string vTxt = str.tostring(math.floor(vSecs / 60)) + ":" + (vSecs % 60 < 10 ? "0" : "") + str.tostring(vSecs % 60)
        color sc = sigDir == 1 ? hOk : colDn
        table.cell(hud, 0, 1, (sigDir == 1 ? "BUY " : "SELL ") + sigPlay, text_color = sigDir == 1 ? color.black : color.white, text_size = size.huge, bgcolor = color.new(sc, 20))
        table.merge_cells(hud, 0, 1, 3, 1)
        table.cell(hud, 0, 2, "E", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 2, str.tostring(sigE, format.mintick), text_color = #ffffff, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 2, "S", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 3, 2, str.tostring(sigS, format.mintick), text_color = hBad, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 3, "T1", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 3, str.tostring(sigT, format.mintick), text_color = hOk, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 3, "R", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 3, 3, str.tostring(sigR, "#.#"), text_color = hCyn, text_size = size.large, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 4, "VALID", text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 4, vTxt, text_color = leftBars <= 2 ? hAmb : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.merge_cells(hud, 1, 4, 3, 4)
    else if not htfMode
        // ── WAITING ── nearest qualifying level each side
        int upIdx = -1
        int dnIdx = -1
        float upD = 1.0e18
        float dnD = 1.0e18
        float upEff = 0.0
        float dnEff = 0.0
        if poolP.size() > 0
            for i = 0 to poolP.size() - 1
                float y = poolP.get(i)
                if y > close
                    float e1 = f_poolScore(i, 1)
                    if e1 >= f_tierDisp() and y - close < upD
                        upD := y - close
                        upIdx := i
                        upEff := e1
                else
                    float e2 = f_poolScore(i, -1)
                    if e2 >= f_tierDisp() and close - y < dnD
                        dnD := close - y
                        dnIdx := i
                        dnEff := e2
        // ROOM: would §4 pass right now — long at the ▼ level, short at ▲ —
        // and how many ticks of travel the ticket would get.
        bool roomL = false
        bool roomS = false
        int roomLt = 0
        int roomSt = 0
        if not na(dAtr)
            if dnIdx >= 0
                [rlE, rlS, rlT, rlR, rlOk] = f_construct(dnIdx, 1, dAtr)
                roomL := rlOk
                roomLt := int(math.round((rlT - rlE) / syminfo.mintick))
            if upIdx >= 0
                [rsE, rsS, rsT, rsR, rsOk] = f_construct(upIdx, -1, dAtr)
                roomS := rsOk
                roomSt := int(math.round((rsE - rsT) / syminfo.mintick))
        // ▲ = short zone (purple) · ▼ = long zone (green), deck columns:
        // side+name · price · +dist · score
        table.cell(hud, 0, 1, upIdx < 0 ? "▲ —" : "▲ " + f_shortNm(poolName.get(upIdx)), text_color = upIdx < 0 ? hDim : colDn, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard, tooltip = upIdx < 0 ? "" : poolName.get(upIdx))
        table.cell(hud, 1, 1, upIdx < 0 ? "" : str.tostring(poolP.get(upIdx), format.mintick), text_color = colDn, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 1, upIdx < 0 ? "" : "+" + str.tostring(math.round(upD / syminfo.mintick)) + "t", text_color = hDim, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 1, upIdx < 0 ? "" : str.tostring(math.round(upEff, 1)) + "★", text_color = hGold, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 2, dnIdx < 0 ? "▼ —" : "▼ " + f_shortNm(poolName.get(dnIdx)), text_color = dnIdx < 0 ? hDim : hOk, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard, tooltip = dnIdx < 0 ? "" : poolName.get(dnIdx))
        table.cell(hud, 1, 2, dnIdx < 0 ? "" : str.tostring(poolP.get(dnIdx), format.mintick), text_color = hOk, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 2, dnIdx < 0 ? "" : "-" + str.tostring(math.round(dnD / syminfo.mintick)) + "t", text_color = hDim, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 2, dnIdx < 0 ? "" : str.tostring(math.round(dnEff, 1)) + "★", text_color = hGold, text_size = size.normal, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 0, 3, "ROOM", text_color = hCyn, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.cell(hud, 1, 3, dnIdx < 0 ? "L —" : "L " + (roomL ? "OK·" : "✗·") + str.tostring(roomLt) + "t", text_color = dnIdx < 0 ? hDim : roomL ? hOk : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 2, 3, upIdx < 0 ? "S —" : "S " + (roomS ? "OK·" : "✗·") + str.tostring(roomSt) + "t", text_color = upIdx < 0 ? hDim : roomS ? hOk : hDim, text_size = size.small, text_halign = text.align_right, bgcolor = hCard)
        table.cell(hud, 3, 3, "", text_color = hDim, text_size = size.small, bgcolor = hCard)
    else
        // ── STRUCTURE ──
        table.cell(hud, 0, 1, "map only — no signals", text_color = hDim, text_size = size.normal, text_halign = text.align_left, bgcolor = hCard)
        table.merge_cells(hud, 0, 1, 3, 1)
        table.cell(hud, 0, 2, f_tierName() + (na(atrPct) ? "" : " · ATR " + str.tostring(math.round(atrPct)) + "pct"), text_color = hDim, text_size = size.small, text_halign = text.align_left, bgcolor = hCard)
        table.merge_cells(hud, 0, 2, 3, 2)

// ── LEDGER FEED — the journal's data stream ─────────────────────────────────
if barstate.isconfirmed and feedAlerts
    if evTouch and feedTouch
        alert(evTouchTxt, alert.freq_once_per_bar_close)
    if evStamp and feedStamp
        alert(evStampTxt, alert.freq_once_per_bar_close)
    if evDayType and feedDayType
        alert(evDayTypeTxt, alert.freq_once_per_bar_close)
    if evAppr and feedAppr
        alert(evApprTxt, alert.freq_once_per_bar_close)
    if evBench and feedBench
        alert(evBenchTxt, alert.freq_once_per_bar_close)
    if evNoTrade
        alert(evNoTradeTxt, alert.freq_once_per_bar_close)

// ── ALERTS — FOUR alertconditions since 2.7: MR + IB, both sides. The
// dynamic payload (E/S/TP1/R/level/score/time) rides the alert() call fired
// at signal time; arm ONE alert with "Any alert() function call" to receive it.
alertcondition(sigMRUp, "SKULD BUY MR", "SKULD BUY MR — pipe-delimited E/S/TP1/R in the alert() message")
alertcondition(sigMRDn, "SKULD SELL MR", "SKULD SELL MR — pipe-delimited E/S/TP1/R in the alert() message")
alertcondition(sigIBUp, "SKULD BUY IB", "SKULD BUY IB — pipe-delimited E/S/TP1/R in the alert() message")
alertcondition(sigIBDn, "SKULD SELL IB", "SKULD SELL IB — pipe-delimited E/S/TP1/R in the alert() message")
alertcondition(sigBRTUp, "SKULD BUY BRT", "SKULD BUY BRT — pipe-delimited E/S/TP1/R in the alert() message")
alertcondition(sigBRTDn, "SKULD SELL BRT", "SKULD SELL BRT — pipe-delimited E/S/TP1/R in the alert() message")

// faint day-type wash, OFF by default
bgcolor(dtTint and dtOn and not htfMode ? (dtState == "TREND▲" ? color.new(colUp, 97) : dtState == "TREND▼" ? color.new(colStop, 97) : na) : na, title = "Day type tint")
